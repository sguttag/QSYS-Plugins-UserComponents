-- Eprad eCNA Cinema Automation Interface (CAI) Plugin
-- Protocol: CAI ASCII over TCP, plus HTTP scrape/control for I/O flags,
-- user-defined names, (v1.2+) Eprad QDC-400 dimmer lighting, and (v1.3+)
-- Eprad nanoHost POS management data.
-- Reference: eCNA Operation and Installation Manual, Section 6
--
-- v1.2: QDC-400 dimmer lighting (Status: Light Control web page, manual
-- Section 5.9). The CAI protocol has no commands for Zone 3-16 lights,
-- individual channel levels, or light level offset -- only House/Stage
-- lights are reachable via CAI OUT codes. QDC monitoring/control is
-- therefore implemented entirely through the HTTP scrape/queue
-- architecture (rtLights.xml), not the CAI socket.
--
-- v1.3: nanoHost POS Management Data (manual Section 5.10, "Status:
-- Management Data"): a separate physical Eprad device -- the eCNA merely
-- relays what the nanoHost last reported. Updates infrequently, so this
-- feature is polled far slower than scrape/lightpoll (see NANO_POLL_RATE
-- below). Read-only and purely informational, except for the four
-- flag-type outputs (Day Start/Day End/First Show End/Last Show Start)
-- documented near their own implementations further down.
--
-- v1.4 (beta): optional Event Logging to Core Manager (Log.Message/
-- Log.Error), gated by Enable_Event_Log plus a page master Enable and six
-- per-category enables (Connection/Inputs/Outputs/Program/Macros/RDI). Off
-- by default at every tier. See logEvent() and its call sites below.
--
-- The eCNA-10 manual documents only the rendered Management Data screen,
-- not the underlying XML. The endpoint name (/rtmandata.xml) and field tags
-- (HostUp/PosEna/PosOk/InSho/Sold/Cancel/RunTim/BtwTim/BSTim/ASTim/BETim/
-- AETim/Tod) are taken from a real eCNA-5 unit's own web client source
-- (statManData.htm/statManDataJs.js) for the equivalent screen -- the
-- eCNA-5 and eCNA-10 share the same CPU and command set, so this applies to
-- both. The lower "show schedule" table (<Screen>, variable row count) is
-- implemented in extractShows() below.
--
-- CRITICAL: never put an apostrophe inside any string VALUE passed to
-- GetControls/GetControlLayout (Description, PrettyName, Legend, Text, or
-- any other schema field). A single apostrophe silently drops every
-- control on every page at design time, with no error anywhere. Apostrophes
-- in Lua comments (like this one) are completely safe -- the rule applies
-- only to string values Q-SYS ingests as schema. Hard-gated by
-- test_no_apostrophes.lua before any build ships.

PluginInfo = {
  Name         = "Eprad~eCNA v1.4.0.20",
  Manufacturer = "STG",
  Version      = "1.4.0.20",
  Id           = "8cd1a925-90ba-4640-8de9-886632d1e242",
  Description  = "Controls the Eprad eCNA Cinema Automation system via the CAI ASCII TCP interface, with optional Eprad QDC dimmer lighting monitoring/control, optional Eprad nanoHost POS management data display, and optional Event Logging to Core Manager.",
  ShowDebug    = true,
  Author       = "Based on HTTP script 1.3.1 by Jay Wyatt and Steve Guttag."
}

-- Full internal build identifier, shown only on the Setup page (see the
-- Credits section of GetControlLayout below) so a specific install can be
-- identified for support purposes -- distinct from PluginInfo.Version,
-- which is the clean outward-facing release version. Beta builds keep all
-- four version places identical in both -- the clean/internal split only
-- happens at an actual numbered release, as 1.3.0 did at build 65.
local BUILD_VERSION = "1.4.0.20"

function GetColor(props)
  return { 72, 147, 217 }
end

-- Fixed provisioned row count for the NanoHost Show Schedule (not a
-- user-tunable property). Shared by GetControls/GetControlLayout (control
-- declarations/positions) and the runtime parser (which populates rows
-- 1..#shows and blanks the rest).
local MAX_SHOWS = 10

-- ============================================================
-- PAGE LIST: builds the list of visible tabs based on properties
-- Debug tab visibility controlled by Show_Debug property
-- ============================================================
local function buildPageList(props)
  local pages = {"Setup", "Outputs"}
  local enableQDC = props["Enable_QDC_Lighting"] and props["Enable_QDC_Lighting"].Value or false
  if enableQDC then table.insert(pages, "Dimmer Control") end
  table.insert(pages, "Inputs")
  -- tonumber() guarantees a real number for the `> 0` checks below (falling
  -- back to the default if the value is missing/non-numeric) regardless of
  -- whether Q-SYS hands back the property Value as a string -- Lua 5.3
  -- raises a runtime error comparing a string to a number relationally.
  local numMacros  = tonumber(props["Num_Macros"]  and props["Num_Macros"].Value)  or 50
  local numRDI     = tonumber(props["Num_RDI"]     and props["Num_RDI"].Value)     or 5
  if numMacros > 0 then table.insert(pages, "Macros") end
  if numRDI    > 0 then table.insert(pages, "RDI")    end
  table.insert(pages, "Program")
  -- nanoHost Management Data page, appended after Program.
  local enableNanoHost = props["Enable_NanoHost"] and props["Enable_NanoHost"].Value or false
  if enableNanoHost then table.insert(pages, "NanoHost") end
  -- Event Log page, appended last. This is the top tier of the v1.4 Event
  -- Logging feature -- Enable_Event_Log=No means no Log.Message/Log.Error
  -- call is ever made, and the page itself (with the master Enable and the
  -- six per-category enables) doesn't even exist.
  local enableEventLog = props["Enable_Event_Log"] and props["Enable_Event_Log"].Value or false
  if enableEventLog then table.insert(pages, "Event Log") end
  return pages
end

-- ============================================================
-- QDC LIGHTING CONFIG: shared helper for design-time functions
-- (GetControls / GetProperties / GetControlLayout / GetPages all
-- receive their own `props` snapshot -- this is NOT the runtime
-- Properties table used inside "if Controls then").
-- ============================================================
local function qdcConfig(props)
  local enabled = props["Enable_QDC_Lighting"] and props["Enable_QDC_Lighting"].Value or false
  local zones    = enabled and (props["QDC_Zones"]    and props["QDC_Zones"].Value    or 2) or 0
  local channels = enabled and (props["QDC_Channels"] and props["QDC_Channels"].Value or 2) or 0
  return enabled, zones, channels
end

-- ============================================================
-- CONTROLS DEFINITION
-- All plugin controls are declared here with type, pin style, etc.
-- ============================================================
function GetControls(props)
  local ctrls = {}
  -- See buildPageList's identical comment above -- tonumber() guarantees a
  -- real number for the `> 0` checks and the Count= fields below.
  local numMacros = tonumber(props["Num_Macros"] and props["Num_Macros"].Value) or 50
  local numRDI    = tonumber(props["Num_RDI"]    and props["Num_RDI"].Value)    or 5
  local enableQDC, qZones, qChannels = qdcConfig(props)

  -- Setup / Connection
  table.insert(ctrls, { Name="IP_ADDRESS",       ControlType="Text",   Count=1, UserPin=true,  PinStyle="Input",  Description="eCNA IP Address" })
  table.insert(ctrls, { Name="TCP_PORT",         ControlType="Text",   Count=1, UserPin=true,  PinStyle="Input",  Description="TCP Port (default 13002)" })
  table.insert(ctrls, {
    Name="Status", ControlType="Indicator", IndicatorType="Status",
    PinStyle="Output", UserPin=true, Count=1
  })
  table.insert(ctrls, {
    Name="Status_LED", ControlType="Indicator", IndicatorType="Status",
    PinStyle="Output", UserPin=true, Count=1
  })
  table.insert(ctrls, { Name="Reconnect",        ControlType="Button", Count=1, UserPin=true,  PinStyle="Input",  ButtonType="Momentary", Description="Force reconnect" })
  table.insert(ctrls, { Name="Model",            ControlType="Text",   Count=1, UserPin=true,  PinStyle="Output", Description="Device model (from RID)" })
  table.insert(ctrls, { Name="Firmware_Version", ControlType="Text",   Count=1, UserPin=true,  PinStyle="Output", Description="Firmware version (from RID)" })
  -- The RSP,RID record contains Device Name, Software Version, and Screen
  -- Id as its three codes -- same response Model/Firmware Version are
  -- parsed from. Always available, independent of Enable_NanoHost.
  table.insert(ctrls, { Name="Screen_Id",        ControlType="Text",   Count=1, UserPin=true,  PinStyle="Output", Description="Screen Id, 0-63 (from RID)" })

  -- Program state (all text outputs from RST polling)
  table.insert(ctrls, { Name="Control_State",  ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="IDL=Idle / RUN=Running" })
  table.insert(ctrls, { Name="Stopped_State",  ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="OK / STP / FLT / FIR" })
  table.insert(ctrls, { Name="Cue_Number",     ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="Current cue number" })
  table.insert(ctrls, { Name="Program_Number", ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="Active program number" })
  table.insert(ctrls, { Name="Segment_Name",   ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="Current segment name" })
  table.insert(ctrls, { Name="Segment_Index",  ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="Current segment index" })
  table.insert(ctrls, { Name="CAI_CMD_Access", ControlType="Text",  Count=1, UserPin=true, PinStyle="Output", Description="OK=Full access / BLK=Blocked" })

  -- EVT Transport Commands (Trigger type - fire on press, no toggle state)
  table.insert(ctrls, { Name="Cmd_Start",        ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Start/Resume (EVT STA)" })
  table.insert(ctrls, { Name="Cmd_Stop",         ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Stop (EVT STP)" })
  table.insert(ctrls, { Name="Cmd_Cue",          ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Cue (EVT CUE)" })
  table.insert(ctrls, { Name="Cmd_Abort",        ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Abort (EVT ABT)" })
  table.insert(ctrls, { Name="Cmd_Fault",        ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Set Fault (EVT FLT)" })
  table.insert(ctrls, { Name="Cmd_Clear_Fault",  ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Clear Fault (EVT CLR)" })
  table.insert(ctrls, { Name="Cmd_Reset",        ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Reset Fault (EVT RES)" })
  table.insert(ctrls, { Name="Cmd_Cancel_Alarm", ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger",   Description="Cancel Alarm (EVT CNL)" })

  -- Program selection (ComboBox for program number, Trigger for execute)
  table.insert(ctrls, { Name="Set_Program",     ControlType="Text",   Count=1, UserPin=true, PinStyle="Input",  Description="Program number to set" })
  table.insert(ctrls, { Name="Cmd_Set_Program", ControlType="Button", Count=1, UserPin=true, PinStyle="Input",  ButtonType="Trigger", Description="Set Program (EVT PGM,d)" })
  table.insert(ctrls, { Name="Cmd_Set_And_Run", ControlType="Button", Count=1, UserPin=true, PinStyle="Input",  ButtonType="Trigger", Description="Set & Run (EVT SPR,d)" })

  -- Macros (Trigger type - fire and forget, count set by property)
  if numMacros > 0 then
    table.insert(ctrls, { Name="Macros", ControlType="Button", Count=numMacros, UserPin=true, PinStyle="Input", ButtonType="Trigger", Description="Trigger macro 1-N (EVT MAC,n)" })
  end

  -- RDI Remote Device Interface (Trigger type, up to 5 devices x 16 commands)
  if numRDI > 0 then
    table.insert(ctrls, { Name="RDI", ControlType="Button", Count=numRDI*16, UserPin=true, PinStyle="Input", ButtonType="Trigger", Description="RDI device commands (EVT RDI,dev,cmd)" })
  end

  -- OUT: Lights (mutually exclusive Toggle arrays - scrape drives state)
  table.insert(ctrls, { Name="House_Lights", ControlType="Button", Count=5, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="House Lights: 1=None 2=Down 3=Mid1 4=Mid2 5=Up" })
  table.insert(ctrls, { Name="Stage_Lights", ControlType="Button", Count=3, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Stage Lights: 1=None 2=Down 3=Up" })

  -- OUT: Curtain / Masking / Lens (mutually exclusive Toggle)
  table.insert(ctrls, { Name="Curtain", ControlType="Button", Count=3, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Curtain: 1=None 2=Close 3=Open" })
  table.insert(ctrls, { Name="Masking", ControlType="Button", Count=4, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Masking: 1=None 2=Flat 3=Scope 4=Special" })
  table.insert(ctrls, { Name="Lens",    ControlType="Button", Count=4, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Lens: 1=None 2=Flat 3=Scope 4=Special" })

  -- OUT: Sound (mutually exclusive Toggle) + Mute (independent Toggle)
  table.insert(ctrls, { Name="Sound", ControlType="Button", Count=9, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Sound: 1=None 2=Aux1 3=Aux2 4=Dig1 5=Dig2 6=Mono 7=NonSync 8=SR 9=SVA" })
  table.insert(ctrls, { Name="Mute",  ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Sound Mute" })

  -- OUT: Digital Projectors (Toggle - state driven by RST polling)
  table.insert(ctrls, { Name="Dig1_Power",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Dig Proj1 Power" })
  table.insert(ctrls, { Name="Dig1_Video",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Dig Proj1 Video" })
  table.insert(ctrls, { Name="Dig2_Power",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Dig Proj2 Power" })
  table.insert(ctrls, { Name="Dig2_Video",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Dig Proj2 Video" })
  table.insert(ctrls, { Name="Aux_Projector", ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Slide Projector" })

  -- Aux digital outputs 1-16 (Toggle - state driven by scrape)
  table.insert(ctrls, { Name="Aux_Out", ControlType="Button", Count=16, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Aux Outputs 1-16" })

  -- User-defined names fetched from eCNA on connect (Setup.xml)
  table.insert(ctrls, { Name="In_Names",  ControlType="Text", Count=16, UserPin=true, PinStyle="Output", Description="User-defined Input names (In1-In16)" })
  table.insert(ctrls, { Name="Out_Names", ControlType="Text", Count=16, UserPin=true, PinStyle="Output", Description="User-defined Aux Output names (Out1-Out16)" })

  -- Web scrape output/input flag indicators (LED indicators, driven by scrape)
  table.insert(ctrls, { Name="Inputs",  ControlType="Indicator", IndicatorType="Led", Count=31, UserPin=true, PinStyle="Output", Description="Input flags (web scrape)" })

  -- Name refresh trigger buttons
  table.insert(ctrls, { Name="Refresh_Setup", ControlType="Button", Count=1, UserPin=true, PinStyle="Input", ButtonType="Trigger", Description="Re-fetch everything normally only fetched once at connect: input/output names, and (if QDC lighting is enabled) zone names, dimmer level/fade settings, and QDC-400 board count. Use after changing any of these at the eCNA." })

  -- ── QDC-400 Dimmer Lighting (v1.2, only when Enable_QDC_Lighting=Yes) ──
  -- Zone rows: fixed House(1)/Stage(2), user-defined Zone3-N via Setup.xml PgIdx=13
  -- Channel bars: output level per channel via rtLights.xml <cact>
  if enableQDC then
    table.insert(ctrls, { Name="Zone_Name",           ControlType="Text",   Count=qZones,     UserPin=true, PinStyle="Output", Description="Zone name: House, Stage, or user-defined (Zone 3-16)" })
    table.insert(ctrls, { Name="Zone_Preset",         ControlType="Button", Count=qZones*5,   UserPin=true, PinStyle="Both",   ButtonType="Toggle", Description="Zone light preset, 5 per zone in order Up/Down/Mid1/Mid2/None" })
    table.insert(ctrls, { Name="Zone_Offset",         ControlType="Knob",   ControlUnit="Percent", Count=qZones,     UserPin=true, PinStyle="Both",   Min=-100, Max=100, Description="Zone light level offset %, -100 to +100" })
    table.insert(ctrls, { Name="Zone_Offset_Text",    ControlType="Text",   Count=qZones,     UserPin=true, PinStyle="Both",   Description="Zone light level offset % (editable), -100 to +100" })
    -- Momentary step buttons beside the offset readout: a quick press/
    -- release nudges the offset by 1; holding past 2s repeats at 1 unit per
    -- 0.5s until released. ButtonType="Momentary" (not "Toggle" or
    -- "Trigger") so Boolean genuinely tracks pressed/held/released, which
    -- the hold-to-repeat timer logic below depends on.
    table.insert(ctrls, { Name="Zone_Offset_Dec",     ControlType="Button", Count=qZones,     UserPin=true, PinStyle="Both",   ButtonType="Momentary", Description="Decrease zone offset by 1; hold to repeat at 1 per 0.5s after 2s" })
    table.insert(ctrls, { Name="Zone_Offset_Inc",     ControlType="Button", Count=qZones,     UserPin=true, PinStyle="Both",   ButtonType="Momentary", Description="Increase zone offset by 1; hold to repeat at 1 per 0.5s after 2s" })
    table.insert(ctrls, { Name="Channel_Level",       ControlType="Knob",   ControlUnit="Percent", Count=qChannels,  UserPin=true, PinStyle="Output", Min=0, Max=100, Description="Dimmer channel output level %, 0 to 100" })
    table.insert(ctrls, { Name="Channel_Level_Text",  ControlType="Text",   Count=qChannels,  UserPin=true, PinStyle="Output", Description="Dimmer channel output level % (text)" })
    table.insert(ctrls, { Name="Channel_Zone",        ControlType="Text",   Count=qChannels,  UserPin=true, PinStyle="Output", Description="Zone name assigned to this dimmer channel" })
    table.insert(ctrls, { Name="Channel_Present",     ControlType="Indicator", IndicatorType="Led", Count=qChannels, UserPin=true, PinStyle="Output", Description="Lit when this channel has reported a non-zero level at least once; goes dark after 2 consecutive 0% polls where a non-zero level was expected (likely no dimmer/power present)" })
    table.insert(ctrls, { Name="QDC_Board_Count",       ControlType="Text",   Count=1, UserPin=true, PinStyle="Output", Description="Number of active QDC-400 boards found on the Local I/O (LIN) Network at last check" })
  end

  -- ── nanoHost POS Management Data (only when Enable_NanoHost=Yes) ──
  -- Informational only -- nothing here causes any action. The six status
  -- flags are Indicator/Led controls so they get BOTH a colored LED on the
  -- page AND a true/false output pin, same pattern as Channel_Present
  -- above. Green=1/Red=0 for all except NanoHost_Cancel,
  -- which is reverse logic (Green=0/not cancelled, Red=1/cancelled) -- see
  -- setNanoFlag()/setNanoFlagRev() in the runtime section.
  local enableNanoHost = props["Enable_NanoHost"] and props["Enable_NanoHost"].Value or false
  if enableNanoHost then
    table.insert(ctrls, { Name="NanoHost_TicketSold", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="POS Ticket Sold (highest-priority nanoHost flag)" })
    table.insert(ctrls, { Name="NanoHost_InShow",      ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="POS In Show" })
    table.insert(ctrls, { Name="NanoHost_PosOk",       ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="POS Ok" })
    table.insert(ctrls, { Name="NanoHost_PosEnabled",  ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="POS Enabled" })
    table.insert(ctrls, { Name="NanoHost_HostUp",      ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="nanoHost Up" })
    table.insert(ctrls, { Name="NanoHost_Cancel",      ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="POS Cancel (reverse logic: Green=0/not cancelled, Red=1/cancelled)" })

    -- Timers, MM:SS text (same six shown alongside the flags on the real
    -- nanoHost screen). Read-only outputs, not pinned as separately
    -- actionable controls beyond visibility -- but still UserPin so they
    -- can be watched/logged externally like everything else in this plugin.
    table.insert(ctrls, { Name="NanoHost_TimeOfDay",         ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Current time of day, generated locally by this plugin (not read from the nanoHost) -- always live" })
    table.insert(ctrls, { Name="NanoHost_TimeOfShow",        ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Feature Run Time, MM:SS" })
    table.insert(ctrls, { Name="NanoHost_TimeBetweenShows",  ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Time Between Features, MM:SS" })
    table.insert(ctrls, { Name="NanoHost_TimeBeforeStart",   ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Time Before Feature Start, MM:SS" })
    table.insert(ctrls, { Name="NanoHost_TimeAfterStart",    ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Time After Feature Start, MM:SS" })
    table.insert(ctrls, { Name="NanoHost_TimeBeforeEnd",     ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Time Before Feature End, MM:SS" })
    table.insert(ctrls, { Name="NanoHost_TimeAfterEnd",      ControlType="Text", Count=1, UserPin=true, PinStyle="Output", Description="Time After Feature End, MM:SS" })

    -- ── Show Schedule ──────────────────────────────────
    -- <Screen> carries a bare screen number before its <StartTime>
    -- children. Each <StartTime> element carries both its own text (the
    -- date/time) AND child elements (RunTime/PerfNum/Sold/Cancel/Title).
    -- Provisioned for MAX_SHOWS=10 rows; rows beyond the actual show count
    -- for the day are blanked at runtime.
    --
    -- Screen identity (Screen_Id, on the Setup page) is sourced from the
    -- CAI CMD,RID response instead of nanoHost's own <Screen> tag, since
    -- it's a general eCNA property rather than a nanoHost-specific one --
    -- always available, independent of Enable_NanoHost.
    --
    -- Row number is a real control (not static graphics text) so it can be
    -- hidden along with everything else in a row that has no associated
    -- performance. Value is set once at startup (it never changes -- row 3
    -- is always "3") and its IsInvisible is toggled together with the rest
    -- of the row.
    table.insert(ctrls, { Name="NanoHost_Show_RowNum", ControlType="Text", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: row number (hidden along with the rest of the row when no performance is scheduled there)" })

    table.insert(ctrls, { Name="NanoHost_Show_StartTime", ControlType="Text", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: performance start date/time" })
    table.insert(ctrls, { Name="NanoHost_Show_RunTime",   ControlType="Text", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: performance run time, minutes (as reported -- NOT MM:SS like the Stat/RunTim field above)" })
    table.insert(ctrls, { Name="NanoHost_Show_PerfNum",   ControlType="Text", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: performance number" })
    table.insert(ctrls, { Name="NanoHost_Show_Sold",      ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: ticket(s) sold for this performance (Green=1/Red=0)" })
    table.insert(ctrls, { Name="NanoHost_Show_Cancel",    ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: performance cancelled (reverse logic: Green=0/not cancelled, Red=1/cancelled)" })
    table.insert(ctrls, { Name="NanoHost_Show_Title",     ControlType="Text", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule: title" })

    -- Row markers, matching the real page's own Key legend/colors: First
    -- Show Start=pink, First Show End=lime, Show Start=cyan, Show End=
    -- yellow, Last Show Start=chocolate, Last Show End=orange. FS/LS mark
    -- which row is the day's first/last performance (pinned there until
    -- that specific show ends); FE/LE mark that specific (first/last) show
    -- while it's actually airing/between shows; Start/End are the generic
    -- "currently airing" pointer, independent of first/last. All six are
    -- independent and can overlap on the same row, so they stay as six
    -- separate indicators per row rather than one collapsed "priority"
    -- color.
    table.insert(ctrls, { Name="NanoHost_Show_FS",    ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: First Show Start" })
    table.insert(ctrls, { Name="NanoHost_Show_FE",    ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: First Show End" })
    table.insert(ctrls, { Name="NanoHost_Show_Start", ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: Show Start (currently-airing performance)" })
    table.insert(ctrls, { Name="NanoHost_Show_End",   ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: Show End (currently-airing performance)" })
    table.insert(ctrls, { Name="NanoHost_Show_LS",    ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: Last Show Start" })
    table.insert(ctrls, { Name="NanoHost_Show_LE",    ControlType="Indicator", IndicatorType="Led", Count=MAX_SHOWS, UserPin=true, PinStyle="Output", Description="Show Schedule marker: Last Show End" })
    table.insert(ctrls, { Name="NanoHost_DayStart", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Day Start: true from (first show StartTime + offset) until FS goes low" })
    table.insert(ctrls, { Name="NanoHost_DayStartOffset", ControlType="Knob", ControlUnit="Integer", Count=1, UserPin=true, PinStyle="Both", Min=-180, Max=60, Description="Day Start offset from the first show StartTime, minutes (-180 to +60)" })
    table.insert(ctrls, { Name="NanoHost_DayStart_Trigger", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Pulses once (rising edge) when Day Start turns true" })
    table.insert(ctrls, { Name="NanoHost_DayStartOffset_Text", ControlType="Text", Count=1, UserPin=true, PinStyle="Both", Description="Day Start offset, minutes (editable), -180 to +60" })
    table.insert(ctrls, { Name="NanoHost_DayStartOffset_Dec", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Decrease Day Start offset by 1 minute; hold to repeat" })
    table.insert(ctrls, { Name="NanoHost_DayStartOffset_Inc", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Increase Day Start offset by 1 minute; hold to repeat" })
    table.insert(ctrls, { Name="NanoHost_DayEnd", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Day End: true from (last show StartTime + RunTime + offset) until LE goes low" })
    table.insert(ctrls, { Name="NanoHost_DayEndOffset", ControlType="Knob", ControlUnit="Integer", Count=1, UserPin=true, PinStyle="Both", Min=-60, Max=240, Description="Day End offset from the last show StartTime plus RunTime, minutes (-60 to +240)" })
    table.insert(ctrls, { Name="NanoHost_DayEnd_Trigger", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Pulses once (rising edge) when Day End turns true" })
    table.insert(ctrls, { Name="NanoHost_DayEndOffset_Text", ControlType="Text", Count=1, UserPin=true, PinStyle="Both", Description="Day End offset, minutes (editable), -60 to +240" })
    table.insert(ctrls, { Name="NanoHost_DayEndOffset_Dec", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Decrease Day End offset by 1 minute; hold to repeat" })
    table.insert(ctrls, { Name="NanoHost_DayEndOffset_Inc", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Increase Day End offset by 1 minute; hold to repeat" })
    -- First Show End: state LED plus Trigger. Turns/fires on either
    -- FE-plus-offset reaching its threshold, or on FE itself dropping false
    -- first if the offset delay ran long enough to overlap the next show;
    -- the LED turns off exactly when FE itself goes false (the same moment
    -- the next show's own Time Before Feature Start reaches 0:00).
    table.insert(ctrls, { Name="NanoHost_FirstShowEnd", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="First Show End: true once the Trigger conditions are met, until FE goes low" })
    table.insert(ctrls, { Name="NanoHost_FirstShowEnd_Trigger", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Pulses once when First Show End conditions are met: FE plus StartTime, RunTime and Offset reached, or FE goes false first" })
    table.insert(ctrls, { Name="NanoHost_FirstShowEndOffset", ControlType="Knob", ControlUnit="Integer", Count=1, UserPin=true, PinStyle="Both", Min=-60, Max=60, Description="First Show End offset from the first show StartTime plus RunTime, minutes (-60 to +60)" })
    table.insert(ctrls, { Name="NanoHost_FirstShowEndOffset_Text", ControlType="Text", Count=1, UserPin=true, PinStyle="Both", Description="First Show End offset, minutes (editable), -60 to +60" })
    table.insert(ctrls, { Name="NanoHost_FirstShowEndOffset_Dec", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Decrease First Show End offset by 1 minute; hold to repeat" })
    table.insert(ctrls, { Name="NanoHost_FirstShowEndOffset_Inc", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Increase First Show End offset by 1 minute; hold to repeat" })
    -- Last Show Start: state LED + trigger, same shape as Day Start, but
    -- gated on LS instead of FS, and with no extra "currently airing" gate
    -- -- true whenever LS is true AND StartTime+Offset is reached.
    table.insert(ctrls, { Name="NanoHost_LastShowStart", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Last Show Start: true from (last show StartTime + offset) until LS goes low" })
    table.insert(ctrls, { Name="NanoHost_LastShowStartOffset", ControlType="Knob", ControlUnit="Integer", Count=1, UserPin=true, PinStyle="Both", Min=-90, Max=60, Description="Last Show Start offset from the last show StartTime, minutes (-90 to +60)" })
    table.insert(ctrls, { Name="NanoHost_LastShowStart_Trigger", ControlType="Indicator", IndicatorType="Led", Count=1, UserPin=true, PinStyle="Output", Description="Pulses once (rising edge) when Last Show Start turns true" })
    table.insert(ctrls, { Name="NanoHost_LastShowStartOffset_Text", ControlType="Text", Count=1, UserPin=true, PinStyle="Both", Description="Last Show Start offset, minutes (editable), -90 to +60" })
    table.insert(ctrls, { Name="NanoHost_LastShowStartOffset_Dec", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Decrease Last Show Start offset by 1 minute; hold to repeat" })
    table.insert(ctrls, { Name="NanoHost_LastShowStartOffset_Inc", ControlType="Button", ButtonType="Momentary", Count=1, UserPin=true, PinStyle="Both", Description="Increase Last Show Start offset by 1 minute; hold to repeat" })
  end

  -- ── Event Logging (v1.4, only when Enable_Event_Log=Yes) ──
  -- One master Enable plus six per-category enables. All default
  -- unselected, matching every other tier of this feature defaulting off.
  local enableEventLog = props["Enable_Event_Log"] and props["Enable_Event_Log"].Value or false
  if enableEventLog then
    table.insert(ctrls, { Name="Log_Enable", ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Master enable for Event Logging to Core Manager; individual category enables below have no effect unless this is on" })
    table.insert(ctrls, { Name="Log_Enable_Connection", ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Connection status changes, including the initial connection process" })
    table.insert(ctrls, { Name="Log_Enable_Inputs",     ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Input flag changes" })
    table.insert(ctrls, { Name="Log_Enable_Outputs",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Output state changes" })
    table.insert(ctrls, { Name="Log_Enable_Program",    ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Program state changes: Control State, Stopped State, Program Number, Segment, and CAI errors" })
    table.insert(ctrls, { Name="Log_Enable_Macros",     ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Macros triggered by this plugin; macros run directly on the eCNA are not visible to the plugin and are not logged" })
    table.insert(ctrls, { Name="Log_Enable_RDI",        ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log RDI commands triggered by this plugin; RDI commands run directly on the eCNA are not visible to the plugin and are not logged" })
    -- Per-device RDI sub-enables: only takes effect when Log_Enable_RDI
    -- above is also on. Lets a device that's wired up but not yet worth
    -- logging (e.g. a spare/unused RDI slot) be silenced individually
    -- without disabling RDI logging entirely. Same off-by-default rule.
    if numRDI > 0 then
      table.insert(ctrls, { Name="Log_Enable_RDI_Dev", ControlType="Button", Count=numRDI, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Per-device RDI logging enable; only takes effect when Log RDI (category) above is also on" })
    end
    -- Tied to Enable_QDC_Lighting only, not the current QDC_Zones count --
    -- a fixed count-based gate here would make the toggle disappear at the
    -- default QDC_Zones=2 and reappear/vanish again as that property is
    -- tuned, which is surprising. What actually gets logged (Zone 3 and
    -- above only) is enforced at the runtime call site regardless.
    if enableQDC then
      table.insert(ctrls, { Name="Log_Enable_Dimmer", ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log Dimmer Control preset changes for Zone 3 and above (Zones 1-2 preset is logged under Outputs), and offset changes for every zone including House/Stage, including offsets moving back to 0 percent" })
    end
    if enableNanoHost then
      table.insert(ctrls, { Name="Log_Enable_NanoHost", ControlType="Button", Count=1, UserPin=true, PinStyle="Both", ButtonType="Toggle", Description="Log NanoHost flag-type triggers (Day Start, Day End, First Show End, Last Show Start) and Status Flag changes" })
    end
    -- On-page history: the last 10 entries actually sent to the Core
    -- Manager Event Log, most recent first, each with a date/time stamp.
    -- Tied to Enable_Event_Log only (not the master Log_Enable or any
    -- category toggle) since it just mirrors whatever logEvent() actually
    -- sent -- if nothing was enabled, it naturally stays blank.
    table.insert(ctrls, { Name="Log_History", ControlType="Text", Count=10, UserPin=true, PinStyle="Output", Description="Most recent Event Log entries, newest first, with date/time stamp" })
  end

  return ctrls
end

-- ============================================================
-- PROPERTIES: User-configurable options shown in Q-SYS Designer
-- ============================================================
function GetProperties(props)
  local list = {
    { Name="Num_Macros",  Type="integer",  Min=0,   Max=50, Value=50 },
    { Name="Num_RDI",     Type="integer",  Min=0,   Max=5,  Value=5  },
    -- RST_Poll_Interval: the CAI status-poll cadence driving the whole
    -- Program page (Control State, Stopped State, Cue Number, Program
    -- Number, Segment, CAI Access). Made tunable in v1.4.0.9 specifically
    -- so a faster segment-change latency could be bench-tested without a
    -- new build per attempt -- per Steve, segment changes can happen
    -- purely via Macro execution with no accompanying CUE (or other)
    -- unsolicited event, so there is no reactive path for them; polling
    -- faster is the only lever. Max=55 preserves the original reasoning
    -- (stays under the eCNA's 60s idle-channel window, which can
    -- otherwise let a second client bump this connection, with some
    -- margin) -- do not raise the property's own Max past that without
    -- re-deriving the safe ceiling.
    -- Default lowered from 45s to 5s in v1.4.0.19. This was field-tested
    -- extensively during the connect-recovery investigation (Steve ran
    -- RST_Poll_Interval=5 across dozens of reboot/cold-boot cycles on
    -- three different QDS versions without incident -- see the punch
    -- list's QDS-comparison sections). Per Steve (2026-08-09): the impact
    -- on existing systems should be small and, if anything, an
    -- improvement -- Program-page fields (especially Segment) reflect
    -- reality up to 9x faster with no observed downside during testing.
    -- Existing installs pick up the new 5s cadence automatically unless
    -- this property is explicitly set otherwise.
    { Name="RST_Poll_Interval", Type="double", Min=2, Max=55, Value=5 },
    -- Enable_Ping_Gate (v1.4.0.20): ported from the out-of-band
    -- EXPERIMENTAL_ConnectDiag diagnostic build after weeks of bench
    -- testing across three QDS (Q-SYS Designer Software) versions --
    -- 9.4.8 LTS, 9.13.1 LTS, and 10.4.1 (Main). Root cause: the eCNA's own
    -- web/HTTP daemon can take anywhere from a few seconds to nearly a
    -- minute to start answering requests after a reboot or cold power-on,
    -- even though its CAI (port 13002) session and plain ICMP both come
    -- back promptly -- confirmed to be a property of the eCNA itself, not
    -- this plugin or any particular QDS version (reproduced identically
    -- across all three). When on, a real disconnect (reboot/power-cycle
    -- case) or a script-start connect against a not-yet-responding unit
    -- (already-off case) pauses CAI reconnect and ALL HTTP traffic and
    -- instead watches plain ICMP echo to the eCNA -- once it answers
    -- continuously for Ping_Stable_Window seconds, normal reconnect/
    -- connect resumes. This does not fully eliminate the eCNA's own
    -- slowness (an internal stall can still occur on the other side of the
    -- wait in some cases), but it measurably reduces both how often it
    -- happens and how long it lasts when it does, confirmed at
    -- Ping_Stable_Window=20 across all three QDS versions tested,
    -- including several dozen back-to-back reboot/cold-boot cycles.
    -- Default on (opt-out, not opt-in) per Steve (2026-08-09): ordinary
    -- brief network interruptions (a dropped packet, a momentary switch
    -- hiccup) never reach this gate at all -- CAI's own disconnect
    -- detection doesn't declare a fault until a real outage of several
    -- seconds has already occurred, confirmed on the bench by pulling the
    -- eCNA's network cable and timing how long before a genuine
    -- disconnect was even registered. A network unstable enough to trip
    -- this gate routinely is already a larger problem this plugin
    -- shouldn't have to compensate for.
    { Name="Enable_Ping_Gate", Type="boolean", Value=true },
    -- Ping_Stable_Window: how many continuous seconds of ICMP replies are
    -- required before reconnect/connect resumes (see Enable_Ping_Gate
    -- above). 20s is the value confirmed clean across all three QDS
    -- versions tested; left tunable, same rationale as RST_Poll_Interval,
    -- in case a different eCNA firmware revision or install needs a
    -- different margin. Min=5 avoids a window so short it stops being a
    -- meaningful settling period; Max=60 is a practical ceiling -- nothing
    -- tested has needed anywhere close to that.
    { Name="Ping_Stable_Window", Type="integer", Min=5, Max=60, Value=20 },
    { Name="Scrape_Interval", Type="double",  Min=0.5,   Max=20, Value=2  },
    -- The dimmer LIGHTPOLL (/rtLights.xml) runs on its own slower cadence,
    -- decoupled from Scrape_Interval, so Scrape_Interval controls real
    -- scrape cadence directly rather than both moving together. Meter
    -- animation between real polls already masks the slower dimmer refresh,
    -- so LIGHTPOLL doesn't need to be nearly as frequent as scrape.
    { Name="LightPoll_Interval", Type="double", Min=0.5, Max=20, Value=3 },
    { Name="Enable_QDC_Lighting", Type="boolean",  Value=false },
    -- QDC_Zones/QDC_Channels are conditionally hidden behind
    -- Enable_QDC_Lighting via RectifyProperties (see below); they only take
    -- effect once Enable_QDC_Lighting=Yes. Zone 1/2 are fixed by the eCNA as
    -- "House"/"Stage", but nothing requires an installation to use both --
    -- Min=1 allows a single-zone (House only) configuration.
    { Name="QDC_Zones",    Type="integer", Min=1, Max=16, Value=2 },
    { Name="QDC_Channels", Type="integer", Min=1, Max=16, Value=2 },
    -- Reveals the NanoHost page (appended after Program) and adds it to the
    -- HTTP poll rotation.
    { Name="Enable_NanoHost", Type="boolean", Value=false },
    -- Top tier of Event Logging (v1.4): reveals the Event Log page (last
    -- page) where a master Enable and six per-category enables live. When
    -- No (the default), no Log.Message/Log.Error call is ever made,
    -- regardless of what those page-level controls are set to.
    { Name="Enable_Event_Log", Type="boolean", Value=false },
  }
  return list
end

function RectifyProperties(props)
  if props["QDC_Zones"] then
    local v = props["QDC_Zones"].Value
    if     v < 1  then props["QDC_Zones"].Value = 1
    elseif v > 16 then props["QDC_Zones"].Value = 16 end
  end
  if props["QDC_Channels"] then
    local v = props["QDC_Channels"].Value
    if     v < 1  then props["QDC_Channels"].Value = 1
    elseif v > 16 then props["QDC_Channels"].Value = 16 end
  end

  -- Hide QDC_Zones/QDC_Channels unless Enable_QDC_Lighting=Yes.
  if props["Enable_QDC_Lighting"] then
    local qdcOn = props["Enable_QDC_Lighting"].Value == true
    if props["QDC_Zones"]    then props["QDC_Zones"].IsHidden    = not qdcOn end
    if props["QDC_Channels"] then props["QDC_Channels"].IsHidden = not qdcOn end
  end

  return props
end

-- ============================================================
-- PAGES: Tabs shown in the plugin UI
-- Macros and RDI tabs hidden if count is 0
-- Debug tab hidden unless Show_Debug property is true
-- ============================================================
function GetPages(props)
  local pages = {}
  for _, name in ipairs(buildPageList(props)) do
    table.insert(pages, { name = name })
  end
  return pages
end

-- ============================================================
-- LAYOUT: Per-page UI layout
-- Q-SYS calls this function once per page switch (driven by
-- the auto-injected page_index property). Only the current
-- page's controls and graphics are emitted.
-- ============================================================
function GetControlLayout(props)
  local layout   = {}
  local graphics = {}
  local pages    = buildPageList(props)
  local CurrentPage = pages[props["page_index"].Value]
  -- See buildPageList's identical comment above -- also guards the
  -- `for i = 1, numMacros do` / `for dev = 1, numRDI do` loops further
  -- down, which Lua 5.3 requires to be real numbers.
  local numMacros = tonumber(props["Num_Macros"] and props["Num_Macros"].Value) or 50
  local numRDI    = tonumber(props["Num_RDI"]    and props["Num_RDI"].Value)    or 5
  local enableQDC, qZones, qChannels = qdcConfig(props)
  -- Used only by the Event Log page below, to grow/shrink it with the
  -- NanoHost property exactly like enableQDC/qZones already do for Dimmer
  -- Control -- the NanoHost page itself doesn't need this local since its
  -- own elseif branch is only ever reached when CurrentPage=="NanoHost",
  -- which buildPageList already gates.
  local enableNanoHost = props["Enable_NanoHost"] and props["Enable_NanoHost"].Value or false

  local LX  = 10    -- left margin
  -- Wide enough to fit the Offset step (-/+) buttons on the Dimmer Control
  -- page, to the right of the Offset % text readout. Shared across all
  -- pages for a consistent look.
  local W   = 630   -- page width
  local FX  = 130   -- field/control start x

  -- Section header (horizontal rule with centred text)
  local function hdr(y, text, size)
    table.insert(graphics, { Type="Header", Text=text, Position={LX, y}, Size={W-20, size or 16} })
  end
  -- Right-aligned label (used for row labels left of controls)
  local function lbl(x, y, w, text, size)
    table.insert(graphics, { Type="Label", Text=text, Position={x, y}, Size={w, size or 18},
      HTextAlign="Right", FontSize=size and math.floor(size*0.75) or 12 })
  end
  -- Left-aligned small label (used for button labels, column headers)
  local function textlbl(x, y, w, text, size, align)
    table.insert(graphics, { Type="Label", Text=text, Position={x, y}, Size={w, size or 14},
      HTextAlign=align or "Left", FontSize=size and math.floor(size*0.75) or 11 })
  end
  -- A control declared with Count=1 is NOT an array on the Q-SYS side --
  -- its layout key must be the bare control Name, with no " 1" suffix.
  -- Every layout[Name.." "..i] built below for a control whose real Count
  -- can be exactly 1 -- Zone_Name/Zone_Offset*/Channel_* (QDC_Zones and
  -- QDC_Channels both now allow 1, see GetProperties) and Macros (Num_Macros
  -- allows 0-50) -- has to go through this helper instead of building the
  -- suffixed key directly, or the layout entry silently matches no real
  -- control and the whole row/element just never appears. Controls whose
  -- Count is always multiplied up to something >1 (Zone_Preset at
  -- qZones*5, RDI at numRDI*16) or is a fixed literal (House_Lights,
  -- Sound, Aux_Out, etc.) can never hit this and don't need it.
  local function layoutKey(name, count, idx)
    if count == 1 then return name else return name.." "..idx end
  end

  -- ================================================================
  -- SETUP TAB: Connection, device info, credits
  -- ================================================================
  if CurrentPage == "Setup" then
    local y = 8
    -- Eprad logo, centred
    table.insert(graphics, {
      Type     = "Image",
      Image    = "",
      Position = {(W-300)/2, y},
      Size     = {300, 64}
    })
    y = y + 74

    hdr(y, 'Connection', 18)
    y = y + 24
    lbl(LX, y, 115, 'IP Address:', 16)
    layout["IP_ADDRESS"] = { PrettyName="Setup~IP Address", Style="Text", Position={FX,y}, Size={220,22} }
    y = y + 28
    lbl(LX, y, 115, 'TCP Port:', 16)
    layout["TCP_PORT"] = { PrettyName="Setup~TCP Port", Style="Text", Position={FX,y}, Size={80,22} }
    y = y + 28
    lbl(LX, y, 115, 'Status:', 16)
    layout["Status_LED"]        = { PrettyName="Setup~Status LED",  Style="Led",  IsReadOnly=true, Position={FX, y+5},    Size={14,14} }
    layout["Status"] = { PrettyName="Setup~Status",      Style="Text", IsReadOnly=true, Position={FX+20, y},   Size={238,22} }
    layout["Reconnect"]         = { PrettyName="Setup~Reconnect",   Style="Button", ButtonStyle="Momentary", Legend="Reconnect", Position={FX+264,y}, Size={88,22} }
    y = y + 36

    hdr(y, 'Device Info', 18)
    y = y + 24
    lbl(LX, y, 115, 'Model:', 16)
    layout["Model"]            = { PrettyName="Setup~Model",    Style="Text", IsReadOnly=true, Position={FX,y}, Size={180,22} }
    y = y + 28
    lbl(LX, y, 115, 'Firmware:', 16)
    layout["Firmware_Version"] = { PrettyName="Setup~Firmware", Style="Text", IsReadOnly=true, Position={FX,y}, Size={180,22} }
    y = y + 28
    -- Screen Id, from the same CAI RID response as Model/Firmware Version
    -- above -- always shown, unconditional, not tied to Enable_NanoHost.
    lbl(LX, y, 115, 'Screen Id:', 16)
    layout["Screen_Id"] = { PrettyName="Setup~Screen Id", Style="Text", IsReadOnly=true, Position={FX,y}, Size={60,22} }
    y = y + 36

    hdr(y, 'Refresh Setup Data', 18)
    y = y + 22
    table.insert(graphics, { Type="Label",
      Text="Input/output names, zone names, dimmer level/fade settings, and QDC-400 board count are only fetched once, at connect. If any of these are changed at the eCNA (Setup pages) after that, use this to pick up the changes.",
      Position={LX, y}, Size={W-20, 30}, HTextAlign="Left", FontSize=10 })
    y = y + 32
    layout["Refresh_Setup"] = { PrettyName="Setup~Refresh Setup Data", Style="Button", ButtonStyle="Trigger", Legend="Refresh Setup Data", Position={LX, y}, Size={150, 22} }
    y = y + 34

    hdr(y, 'Credits', 18)
    y = y + 24
    table.insert(graphics, { Type="Label", Text="\xc2\xa9 2026 By Jay Wyatt and Steve Guttag.  Built with Claude AI.",
      Position={LX, y}, Size={W-20, 18}, HTextAlign="Left", FontSize=12 })
    y = y + 26
    table.insert(graphics, { Type="Label",
      Text="This plugin may be freely distributed. It is supplied as-is and without support. Use at your own risk.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 18
    table.insert(graphics, { Type="Label",
      Text="There are no expressed or implied warranties. This plugin is not a product of Eprad.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 24
    -- STG logo, centred below Credits
    table.insert(graphics, {
      Type     = "Image",
      Image    = "",
      Position = {(W-21)/2, y},
      Size     = {21, 50}
    })
    -- Build number, lower-right corner -- full internal identifier, not
    -- the simplified outward-facing PluginInfo.Version (see BUILD_VERSION above).
    table.insert(graphics, { Type="Label", Text="Version "..BUILD_VERSION,
      Position={W-100, y+44}, Size={90, 14}, HTextAlign="Right", FontSize=9 })

  -- ================================================================
  -- OUTPUTS TAB: All eCNA outputs grouped by type
  -- Toggle buttons send OUT commands and reflect state from scrape
  -- ================================================================
  elseif CurrentPage == "Outputs" then
    local BW, BH, BS = 54, 26, 56   -- button width, height, stride
    local y = 10

    -- Digital Projectors (state from RST polling)
    lbl(LX, y, 115, 'Dig Proj1 Pwr:', 14)
    layout["Dig1_Power"] = { PrettyName="Outputs~Dig Proj1 Power", Style="Button", ButtonStyle="Toggle", Position={FX, y}, Size={60, BH} }
    y = y + BH+4
    lbl(LX, y, 115, 'Dig Proj1 Vid:', 14)
    layout["Dig1_Video"] = { PrettyName="Outputs~Dig Proj1 Video", Style="Button", ButtonStyle="Toggle", Position={FX, y}, Size={60, BH} }
    y = y + BH+4
    lbl(LX, y, 115, 'Dig Proj2 Pwr:', 14)
    layout["Dig2_Power"] = { PrettyName="Outputs~Dig Proj2 Power", Style="Button", ButtonStyle="Toggle", Position={FX, y}, Size={60, BH} }
    y = y + BH+4
    lbl(LX, y, 115, 'Dig Proj2 Vid:', 14)
    layout["Dig2_Video"] = { PrettyName="Outputs~Dig Proj2 Video", Style="Button", ButtonStyle="Toggle", Position={FX, y}, Size={60, BH} }
    y = y + BH+4
    lbl(LX, y, 115, 'Slide Projector:', 14)
    layout["Aux_Projector"] = { PrettyName="Outputs~Slide Projector", Style="Button", ButtonStyle="Toggle", Position={FX, y}, Size={60, BH} }
    y = y + BH+8

    -- House Lights (mutually exclusive, state from scrape)
    local HLLabels = {"None","Down","Mid1","Mid2","Up"}
    lbl(LX, y, 115, 'House Lights:', 14)
    for i,txt in ipairs(HLLabels) do
      layout["House_Lights "..i] = { PrettyName="Outputs~House Lights/"..txt, Style="Button", ButtonStyle="Toggle", Legend=txt, Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    y = y + BH+4

    -- Stage Lights
    local SLLabels = {"None","Down","Up"}
    lbl(LX, y, 115, 'Stage Lights:', 14)
    for i,txt in ipairs(SLLabels) do
      layout["Stage_Lights "..i] = { PrettyName="Outputs~Stage Lights/"..txt, Style="Button", ButtonStyle="Toggle", Legend=txt, Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    y = y + BH+4

    -- Curtain
    local CurtLabels = {"None","Close","Open"}
    lbl(LX, y, 115, 'Curtain:', 14)
    for i,txt in ipairs(CurtLabels) do
      layout["Curtain "..i] = { PrettyName="Outputs~Curtain/"..txt, Style="Button", ButtonStyle="Toggle", Legend=txt, Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    y = y + BH+4

    -- Masking
    local MskLabels = {"None","Flat","Scope","Special"}
    lbl(LX, y, 115, 'Masking:', 14)
    for i,txt in ipairs(MskLabels) do
      layout["Masking "..i] = { PrettyName="Outputs~Masking/"..txt, Style="Button", ButtonStyle="Toggle", Legend=txt, Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    y = y + BH+4

    -- Lens
    local LensLabels = {"None","Flat","Scope","Special"}
    lbl(LX, y, 115, 'Lens:', 14)
    for i,txt in ipairs(LensLabels) do
      layout["Lens "..i] = { PrettyName="Outputs~Lens/"..txt, Style="Button", ButtonStyle="Toggle", Legend=txt, Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    y = y + BH+4

    -- Sound: row1 = None Aux1 Aux2 Dig1 Dig2, row2 = Mono NonSync SR SVA + Mute
    local SndLabels = {"None","Aux1","Aux2","Dig1","Dig2","Mono","NonSync","SR","SVA"}
    lbl(LX, y, 115, 'Sound:', 14)
    for i=1,5 do
      layout["Sound "..i] = { PrettyName="Outputs~Sound/"..SndLabels[i], Style="Button", ButtonStyle="Toggle", Legend=SndLabels[i], Position={FX+(i-1)*BS, y}, Size={BW, BH} }
    end
    for i=6,9 do
      layout["Sound "..i] = { PrettyName="Outputs~Sound/"..SndLabels[i], Style="Button", ButtonStyle="Toggle", Legend=SndLabels[i], Position={FX+(i-6)*BS, y+BH+4}, Size={BW, BH} }
    end
    layout["Mute"] = { PrettyName="Outputs~Mute", Style="Button", ButtonStyle="Toggle", Legend="Mute", Position={FX+4*BS, y+BH+4}, Size={BW, BH} }
    y = y + (BH+4)*2 + 8

    -- Aux Output Flags 1-16: 2 columns of 8
    -- Each entry: [Out N button] [user name text field]
    hdr(y, 'Aux Output Flags 1-16', 16)
    y = y + 22
    table.insert(graphics, { Type="Label",
      Text="Note: Names refer to Output Flag names as configured in the eCNA, not physical output names on any I/O board.",
      Position={LX, y}, Size={W-20, 26}, HTextAlign="Left", FontSize=10 })
    y = y + 59
    local auxColW = math.floor((W-20)/2)  -- ~260px per column
    local auxBW   = 60                     -- button width
    local auxBH   = BH                     -- button height
    local auxRS   = 28                     -- row stride
    for i=1,16 do
      local col = math.floor((i-1)/8)      -- 0=left, 1=right
      local row = (i-1) % 8
      local bx  = LX + col*auxColW
      local by  = y + row*auxRS
      -- "Out N" label to the left of button
      textlbl(bx, by+4, 38, "Out "..i, 12, "Right")
      layout["Aux_Out "..i] = { PrettyName="Outputs~Aux Out "..i, Style="Button", ButtonStyle="Toggle", Position={bx+42, by}, Size={auxBW, auxBH} }
      -- User name text field to the right of button
      layout["Out_Names "..i] = { PrettyName="Outputs~Aux Out "..i.." Name", Style="Text", IsReadOnly=true, Position={bx+106, by}, Size={auxColW-110, auxBH} }
    end

  -- ================================================================
  -- DIMMER CONTROL TAB (v1.2): Eprad QDC-400 lighting monitor/control
  -- Replicates the eCNA's own Status: Light Control web page (manual §5.9)
  -- Only present when Enable_QDC_Lighting=Yes.
  -- Zone rows: name, 5 mutually-exclusive preset buttons, offset fader + text
  -- Channel bars: vertical level meter + % text + assigned zone name
  -- ================================================================
  elseif CurrentPage == "Dimmer Control" then
    local y = 10
    hdr(y, 'Zone Light Control', 18)
    y = y + 22

    -- QDC board count: label + narrow (single-digit, range is 0-4) box on
    -- the same line, positioned above the warning text so the two don't
    -- overlap.
    table.insert(graphics, { Type="Label", Text="QDC-400 boards found:", Position={LX, y+2}, Size={150, 16}, HTextAlign="Left", FontSize=10 })
    layout["QDC_Board_Count"] = { PrettyName="Dimmer Control~QDC Boards Found", Style="Text", IsReadOnly=true, Position={LX+110, y}, Size={26, 20} }
    y = y + 26

    table.insert(graphics, { Type="Label",
      Text="Warning: These controls cause action at the target device. Offset applies to all channels configured for that zone.",
      Position={LX, y-6}, Size={W-20, 28}, HTextAlign="Left", FontSize=10 })
    y = y + 41

    local presetLabels = {"Up","Down","Mid1","Mid2","None"}
    local zoneNameW = 90
    local presetBW  = 40
    local presetX   = LX + zoneNameW + 6
    local faderX    = presetX + 5*presetBW + 10
    local faderW    = 120
    local offTxtX   = faderX + faderW + 6
    local offTxtW   = 40
    local rowH      = 26
    -- -/+ step buttons, placed to the right of the Offset % text
    -- readout (not beside the fader itself) with a deliberate gap -- so
    -- someone dragging the slider has no chance of also catching a step
    -- button by accident. Sized to match the preset buttons exactly
    -- (stepBW == presetBW) rather than a smaller custom width -- Q-SYS
    -- auto-fits a button's Legend text to its own size, so the "+"/"-"
    -- looking noticeably smaller than "Up"/"Down"/etc. was really just a
    -- side effect of the button itself being smaller, not a separate font
    -- setting to adjust.
    local stepBW    = presetBW
    local decX      = offTxtX + offTxtW + 10
    local incX      = decX + stepBW + 6

    -- Column headers (once, above the rows -- not repeated per row)
    textlbl(LX,      y-16, zoneNameW, "Zone", 12, "Center")
    textlbl(presetX + 2*presetBW, y-16, presetBW, "Preset", 12, "Center")  -- centered over the Mid1 button (button 3 of 5), the natural midpoint of the row
    textlbl(faderX,  y-16, faderW, "Offset %", 12, "Center")
    textlbl(decX,    y-16, incX+stepBW-decX, "Adjust", 12, "Center")  -- spans both step buttons

    for i = 1, qZones do
      layout[layoutKey("Zone_Name", qZones, i)] = { PrettyName="Dimmer Control~Zone "..i.." Name", Style="Text", IsReadOnly=true, Position={LX, y}, Size={zoneNameW-4, rowH-4} }
      for b = 1, 5 do
        local idx = (i-1)*5 + b
        layout["Zone_Preset "..idx] = { PrettyName="Dimmer Control~Zone "..i.." "..presetLabels[b], Style="Button", ButtonStyle="Toggle", Legend=presetLabels[b], Position={presetX+(b-1)*presetBW, y}, Size={presetBW-2, rowH-4} }
      end
      -- Color for a Fader control must be an RGB table, not a string --
      -- confirmed against a working reference plugin (DSS_Server) and
      -- verified on both Windows 10 and 11. A string value here
      -- ("blue", "Blue", a hex string) is simply the wrong data type for
      -- this control's Color property.
      layout[layoutKey("Zone_Offset", qZones, i)]      = { PrettyName="Dimmer Control~Zone "..i.." Offset",      Style="Fader", Orientation="Horizontal", Color={72,147,217}, Min=-100, Max=100, Position={faderX, y}, Size={faderW, rowH-4} }
      layout[layoutKey("Zone_Offset_Text", qZones, i)] = { PrettyName="Dimmer Control~Zone "..i.." Offset Text", Style="Text", Position={offTxtX, y}, Size={offTxtW, rowH-4} }
      -- ButtonStyle="Momentary" to match the Momentary ControlType declared
      -- in GetControls -- Legend is the standard universally-understood
      -- "-"/"+" glyph rather than text, since the one-time "Adjust" header
      -- above already establishes what these do.
      layout[layoutKey("Zone_Offset_Dec", qZones, i)] = { PrettyName="Dimmer Control~Zone "..i.." Offset Decrease", Style="Button", ButtonStyle="Momentary", Legend="-", Position={decX, y}, Size={stepBW-2, rowH-4} }
      layout[layoutKey("Zone_Offset_Inc", qZones, i)] = { PrettyName="Dimmer Control~Zone "..i.." Offset Increase", Style="Button", ButtonStyle="Momentary", Legend="+", Position={incX, y}, Size={stepBW-2, rowH-4} }
      y = y + rowH
    end
    y = y + 14

    hdr(y, 'Dimmer Channels', 18)
    y = y + 24
    table.insert(graphics, { Type="Label",
      Text="Channel output level (%). More than one channel may be assigned to the same zone.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 22

    local chColW  = 56
    local barW    = 20
    local barH    = 90
    local perRow  = 8  -- fixed cap: a 16-channel system shows as two rows of 8
    local chBaseY = y
    for j = 1, qChannels do
      local col = (j-1) % perRow
      local row = math.floor((j-1)/perRow)
      local cx  = LX + col*chColW
      local cy  = chBaseY + row*(barH+56)
      textlbl(cx, cy, chColW-4, "Ch "..j, 12, "Center")
      -- Small LED in the corner: lit = this channel has confirmed a real,
      -- non-zero response at least once; dark = no confirmed dimmer yet,
      -- or 2+ consecutive unexpected 0% polls (see channelNoDimmer).
      layout[layoutKey("Channel_Present", qChannels, j)]    = { PrettyName="Dimmer Control~Channel "..j.." Present", Style="Led", IsReadOnly=true, Color="green", Position={cx+chColW-14, cy}, Size={10,10} }
      -- Style="Meter" (not "Fader") for a non-interactive level-bar look.
      -- Color is an RGB table (not a string) -- see the Zone_Offset comment above.
      layout[layoutKey("Channel_Level", qChannels, j)]      = { PrettyName="Dimmer Control~Channel "..j.." Level",      Style="Meter", Orientation="Vertical", IsReadOnly=true, Color={0,210,0}, Min=0, Max=100, Position={cx + (chColW-barW)/2, cy+16}, Size={barW, barH} }
      layout[layoutKey("Channel_Level_Text", qChannels, j)] = { PrettyName="Dimmer Control~Channel "..j.." Level Text", Style="Text", IsReadOnly=true, Position={cx, cy+16+barH+2}, Size={chColW-4, 16} }
      layout[layoutKey("Channel_Zone", qChannels, j)]       = { PrettyName="Dimmer Control~Channel "..j.." Zone",       Style="Text", IsReadOnly=true, Position={cx, cy+16+barH+20}, Size={chColW-4, 16} }
    end

  -- ================================================================
  -- INPUTS TAB: Web scrape input flags as LEDs with labels
  -- Two columns: In1-In16 on left, system inputs on right
  -- ================================================================
  elseif CurrentPage == "Inputs" then
    local y = 10
    local LED = 16   -- LED size
    local LS  = 22   -- row stride

    hdr(y, 'Input Flags', 20)
    y = y + 26
    table.insert(graphics, { Type="Label",
      Text="Note: Names below refer to Input Flag names as configured in the eCNA, not physical input names on any I/O board.",
      Position={LX, y-10}, Size={W-20, 32}, HTextAlign="Left", FontSize=10 })
    y = y + 38

    local col1 = {}   -- {index, name} for In1-In16
    local col2 = {}   -- {index, name} for system inputs
    local InFlagNames = {
      "Stop","Start","Dig1 Cue","Dig1 Fault","Dig1 Stop","Dig1 Start",
      "Dig2 Cue","Dig2 Fault","Dig2 Stop","Dig2 Start",
      "Bypass","Program Abort","Pause","In1","In2","In3","In4",
      "Fire Stop","In5","In6","In7","In8","In9","In10","In11","In12",
      "In13","In14","In15","In16","Cancel"
    }
    for i, name in ipairs(InFlagNames) do
      if name:sub(1,2) == "In" and tonumber(name:sub(3)) then
        table.insert(col1, {i, name})
      else
        table.insert(col2, {i, name})
      end
    end

    local colW = math.floor((W-20) / 2)

    -- Column headers sit 18px above the first row
    textlbl(LX,       y-20, colW, "General Inputs", 16)
    textlbl(LX+colW+80,  y-20, colW-80, "System Inputs",  16)

    -- Column 1: In1-In16 with user-defined name alongside
    -- In_Names[1..16] controls display the user name fetched from eCNA
    local y1 = y
    for idx, entry in ipairs(col1) do
      local inIdx = idx  -- In1=1, In2=2 ... In16=16
      layout["Inputs "..entry[1]] = { PrettyName="Inputs~"..entry[2], Style="Led", IsReadOnly=true, Color="green", Position={LX, y1+3}, Size={LED, LED} }
      textlbl(LX+LED+6, y1+2, 36, entry[2], 16)
      layout["In_Names "..inIdx] = { PrettyName="Inputs~"..entry[2].." Name", Style="Text", IsReadOnly=true, Position={LX+LED+46, y1}, Size={colW-LED-52, LS} }
      y1 = y1 + LS
    end

    -- Column 2: System inputs (shifted right with a visual gap from col1)
    local gap = 80   -- extra gap between columns
    local x2  = LX + colW + gap
    local col2W = W - x2 - 10
    local y2 = y
    for _, entry in ipairs(col2) do
      layout["Inputs "..entry[1]] = { PrettyName="Inputs~"..entry[2], Style="Led", IsReadOnly=true, Color="green", Position={x2, y2+3}, Size={LED, LED} }
      textlbl(x2+LED+6, y2+2, col2W-LED-6, entry[2], 16)
      y2 = y2 + LS
    end

  -- ================================================================
  -- MACROS TAB: Trigger buttons with text labels above (no legends)
  -- ================================================================
  elseif CurrentPage == "Macros" then
    local y = 10
    hdr(y, 'Macros', 18)
    y = y + 24
    local cols  = 10
    local bw    = math.floor((W-20) / cols) - 2
    local bh    = 24
    for i = 1, numMacros do
      local col = (i-1) % cols
      local row = math.floor((i-1) / cols)
      local bx  = LX + col*(bw+2)
      local by  = y + row*42
      -- Text label centred above button, no legend on button itself
      textlbl(bx, by, bw+2, "Macro "..i, 14, "Center")
      layout[layoutKey("Macros", numMacros, i)] = { PrettyName="Macros~Macro "..i, Style="Button", ButtonStyle="Trigger", Position={bx, by+16}, Size={bw, bh} }
    end

  -- ================================================================
  -- RDI TAB: 5 devices x 16 commands, text labels above Trigger buttons
  -- ================================================================
  elseif CurrentPage == "RDI" then
    local y = 10
    local bw     = 54
    local bh     = 24
    local stride = 56
    for dev = 1, numRDI do
      hdr(y, 'RDI '..dev, 18)
      y = y + 22
      for cmd = 1, 16 do
        local col = (cmd-1) % 8
        local row = math.floor((cmd-1) / 8)
        local idx = (dev-1)*16 + cmd
        local bx  = LX + col*stride
        local by  = y + row*42
        -- Text label: 'RDI N-N' centred above button
        textlbl(bx, by, bw, "RDI "..dev.."-"..cmd, 14, "Center")
        layout["RDI "..idx] = { PrettyName="RDI~RDI "..dev.." Cmd "..cmd, Style="Button", ButtonStyle="Trigger", Position={bx, by+16}, Size={bw, bh} }
      end
      y = y + 2*42 + 8
    end

  -- ================================================================
  -- PROGRAM TAB: Transport controls, program selection, run state
  -- ================================================================
  elseif CurrentPage == "Program" then
    local y = 10
    local BH2 = 30   -- taller buttons for program controls

    hdr(y, 'Transport', 18)
    y = y + 26
    layout["Cmd_Start"]        = { PrettyName="Program~Start",        Style="Button", ButtonStyle="Trigger",   Legend="Start",        Position={LX,    y}, Size={84,BH2} }
    layout["Cmd_Stop"]         = { PrettyName="Program~Stop",         Style="Button", ButtonStyle="Trigger",   Legend="Stop",         Position={LX+88, y}, Size={84,BH2} }
    layout["Cmd_Cue"]          = { PrettyName="Program~Cue",          Style="Button", ButtonStyle="Trigger",   Legend="Cue",          Position={LX+176,y}, Size={84,BH2} }
    layout["Cmd_Abort"]        = { PrettyName="Program~Abort",        Style="Button", ButtonStyle="Trigger",   Legend="Abort",        Position={LX+264,y}, Size={84,BH2} }
    y = y + BH2+6
    layout["Cmd_Fault"]        = { PrettyName="Program~Set Fault",    Style="Button", ButtonStyle="Trigger",   Legend="Set Fault",    Position={LX,    y}, Size={94,BH2} }
    layout["Cmd_Clear_Fault"]  = { PrettyName="Program~Clear Fault",  Style="Button", ButtonStyle="Trigger",   Legend="Clear Fault",  Position={LX+98, y}, Size={94,BH2} }
    layout["Cmd_Reset"]        = { PrettyName="Program~Reset Fault",  Style="Button", ButtonStyle="Trigger",   Legend="Reset Fault",  Position={LX+196,y}, Size={94,BH2} }
    layout["Cmd_Cancel_Alarm"] = { PrettyName="Program~Cancel Alarm", Style="Button", ButtonStyle="Trigger",   Legend="Cancel Alarm", Position={LX+294,y}, Size={108,BH2} }
    y = y + BH2+10

    hdr(y, 'Program Selection', 18)
    y = y + 26
    lbl(LX, y, 120, 'Program #:', 16)
    layout["Set_Program"]      = { PrettyName="Program~Set Program",  Style="ComboBox", Position={FX+5,y}, Size={120,22} }
    layout["Cmd_Set_Program"]  = { PrettyName="Program~Set Prog",     Style="Button", ButtonStyle="Trigger", Legend="Set Prog",  Position={FX+130,y}, Size={80,22} }
    layout["Cmd_Set_And_Run"]  = { PrettyName="Program~Set and Run",  Style="Button", ButtonStyle="Trigger", Legend="Set & Run", Position={FX+214,y}, Size={88,22} }
    y = y + 36

    hdr(y, 'Run State', 18)
    y = y + 26
    local stateRows = {
      {"Control_State",  "Control State"},
      {"Stopped_State",  "Stopped State"},
      {"Cue_Number",     "Cue Number"},
      {"Program_Number", "Program Number"},
      {"Segment_Name",   "Segment Name"},
      {"Segment_Index",  "Segment Index"},
      {"CAI_CMD_Access", "CMD Access"},
    }
    for _, row in ipairs(stateRows) do
      lbl(LX, y, 120, row[2]..':', 16)
      layout[row[1]] = { PrettyName="Program~"..row[2], Style="Text", IsReadOnly=true, Position={FX+5,y}, Size={190,22} }
      y = y + 28
    end

  -- ================================================================
  -- NANOHOST TAB: v1.3, informational only, appended after Program.
  -- Upper section (this build): Show Timers (left) + Status Flags (right),
  -- side by side, recreating (to a degree) the real nanoHost web page's own
  -- "Control Data" table layout. Lower section (shows schedule, variable
  -- row count) is NOT implemented yet -- pending a real field sample; see
  -- header comment and design notes.
  -- ================================================================
  elseif CurrentPage == "NanoHost" then
    local y = 10
    -- Show Timers (left) and Status Flags (right), side by side, to
    -- recreate (to a degree) the real nanoHost web page's own "Control
    -- Data" table layout (Name/MM:SS paired with Name/Flag columns -- see
    -- manual Sec. 5.10). Status Flags has its LEDs to the right of their
    -- labels; LED_X is a single fixed x for every flag row, so all six
    -- LEDs land in one vertical column regardless of label text length,
    -- same principle as the timers column's fields lining up via a fixed
    -- FX.
    hdr(y, 'Status', 18)
    y = y + 24

    -- Column geometry, named so the header-centering math below always
    -- matches the actual row layout, rather than duplicated magic numbers.
    local TLX = LX - 5      -- timer label box start x
    local TLW = 170          -- timer label box width
    local TFX = FX + 45      -- timer field start x
    local TFW = 100          -- timer field width
    local RLX = 340          -- flag label box start x
    local RLW = 150          -- flag label box width
    local LED = 14
    local LED_X = RLX + RLW + 10  -- fixed x for every LED -- vertical alignment

    -- Column headers: bold + black for stronger visual differentiation from
    -- the row labels below them, and centered so the MIDDLE of the header
    -- text sits on the dividing line between each column's labels and its
    -- value element (field start x=TFX for Show Timers, LED start x=LED_X
    -- for Status Flags). Built directly rather than via textlbl(), which
    -- has no TextColor/IsBold parameters and is shared by many regular-
    -- weight labels elsewhere in the file that shouldn't be affected.
    -- IsBold=true is the lever for bold text on a graphics Label --
    -- FontStyle="Bold" has no visible effect on this Label type.
    local HDR_W = 180
    table.insert(graphics, { Type="Label", Text="Show Timers",
      Position={TFX - HDR_W/2, y}, Size={HDR_W, 18},
      HTextAlign="Center", FontSize=13, IsBold=true, TextColor={0,0,0} })
    table.insert(graphics, { Type="Label", Text="Status Flags",
      Position={LED_X - HDR_W/2, y}, Size={HDR_W, 18},
      HTextAlign="Center", FontSize=13, IsBold=true, TextColor={0,0,0} })
    y = y + 22

    local timerRows = {
      {"NanoHost_TimeOfDay",        "Time of Day"},
      {"NanoHost_TimeOfShow",       "Feature Run Time"},
      {"NanoHost_TimeBetweenShows", "Time Between Features"},
      {"NanoHost_TimeBeforeStart",  "Time Before Feature Start"},
      {"NanoHost_TimeAfterStart",   "Time After Feature Start"},
      {"NanoHost_TimeBeforeEnd",    "Time Before Feature End"},
      {"NanoHost_TimeAfterEnd",     "Time After Feature End"},
    }
    local flagRows = {
      {"NanoHost_TicketSold", "POS Ticket Sold"},
      {"NanoHost_InShow",     "POS In Show"},
      {"NanoHost_PosOk",      "POS Ok"},
      {"NanoHost_PosEnabled", "POS Enabled"},
      {"NanoHost_HostUp",     "nanoHost Up"},
      {"NanoHost_Cancel",     "POS Cancel"},
    }
    local rowH = 26  -- shared row height -- keeps both columns on the same grid

    for i, row in ipairs(timerRows) do
      local ry = y + (i-1)*rowH
      lbl(TLX, ry, TLW, row[2]..':', 16)
      layout[row[1]] = { PrettyName="NanoHost~"..row[2], Style="Text", IsReadOnly=true, Position={TFX, ry}, Size={TFW,22} }
    end

    for i, row in ipairs(flagRows) do

      local ry = y + (i-1)*rowH
      -- Label right-aligned so it "meets" the fixed-position LED cleanly,
      -- same principle as the timer labels meeting their fields at FX+45.
      lbl(RLX, ry, RLW, row[2]..':', 16)
      -- Color set at runtime (green/red, reversed for Cancel) -- see
      -- setNanoFlag()/setNanoFlagRev() in the runtime section. "green" here
      -- is just the initial/default layout-time color before first poll.
      layout[row[1]] = { PrettyName="NanoHost~"..row[2], Style="Led", IsReadOnly=true, Color="green", Position={LED_X, ry+3}, Size={LED,LED} }
    end

    -- Advance past whichever column is taller (7 timer rows vs 6 flag rows).
    y = y + math.max(#timerRows, #flagRows) * rowH + 10

    hdr(y, 'Show Schedule', 18)
    y = y + 22

    -- Column x positions. The small marker cluster holds only FS/FE/LS/LE;
    -- Start/End highlight LEDs sit immediately adjacent to StartTime/
    -- RunTime instead, since those two represent "this is the currently-
    -- airing performance," which on the real page is a background
    -- highlight on the StartTime/RunTime cells themselves (cyan/yellow),
    -- not a separate marker column.
    local SNO_X    = LX
    local SFS_X    = SNO_X + 24
    local SFE_X    = SFS_X + 18
    local SLS_X    = SFE_X + 18
    local SLE_X    = SLS_X + 18
    local SSTARTHL_X = SLE_X + 22   -- Start highlight LED, immediately before StartTime
    local SST_X      = SSTARTHL_X + 16   -- StartTime
    local SENDHL_X   = SST_X + 130 + 2   -- End highlight LED, immediately before RunTime
    local SRT_X      = SENDHL_X + 16     -- RunTime
    local SPN_X    = SRT_X + 45    -- PerfNum
    local SPN_W    = 55            -- "PerfNum" needs more width than a narrower column would give
    local SSOLD_X  = SPN_X + SPN_W -- Sold
    local SCAN_X   = SSOLD_X + 25  -- Cancel
    local STITLE_X = SCAN_X + 45   -- Title ("Cancel" needs more header room than Sold/PerfNum)
    local SLED     = 12
    local SROWH    = 20
    -- Sold/Cancel LEDs centered under their headers rather than
    -- left-aligned at the header box's start x.
    local SSOLD_LED_X = SSOLD_X + (25 - SLED) / 2
    local SCAN_LED_X  = SCAN_X  + (45 - SLED) / 2 - 4  -- shifted 4px left to better center under "Cancel"

    -- Column headers (FS/FE/LS/LE only -- Start/End highlights sit right
    -- next to StartTime/RunTime below, with no separate header needed since
    -- the highlight IS the cue, same as the real page).
    textlbl(SNO_X,    y, 20,  'No.',      12)
    textlbl(SFS_X,    y, 16,  'FS',       10)
    textlbl(SFE_X,    y, 16,  'FE',       10)
    textlbl(SLS_X,    y, 16,  'LS',       10)
    textlbl(SLE_X,    y, 16,  'LE',       10)
    textlbl(SST_X,    y, 130, 'StartTime',12)
    textlbl(SRT_X,    y, 45,  'RunTime',  12)
    textlbl(SPN_X,    y, SPN_W, 'PerfNum',  12)
    textlbl(SSOLD_X,  y, 25,  'Sold',     12)
    textlbl(SCAN_X,   y, 45,  'Cancel',   12)
    textlbl(STITLE_X, y, (W-20)-STITLE_X, 'Title', 12)
    y = y + 18

    -- Layout-time (pre-poll) default color for each marker -- Boolean=false
    -- dims whatever Color is set, so this gives each marker its own dark
    -- shade from the very first render, before any poll has landed.
    -- "dimgray" (rgb 105,105,105) is the uniform off-color for all four --
    -- despite the names, it's actually darker/more muted than "darkgray"
    -- (rgb 169,169,169), the same naming trap as lime being brighter than
    -- green.
    local MARKER_OFF_FS = "dimgray"
    local MARKER_OFF_FE = "dimgray"
    local MARKER_OFF_LS = "dimgray"
    local MARKER_OFF_LE = "dimgray"
    for i = 1, MAX_SHOWS do
      local ry = y + (i-1)*SROWH
      -- Row number vertically centered (+3, matching the LEDs' own
      -- vertical offset). Value set once at startup, IsInvisible toggled
      -- per-row at runtime along with everything else in the row.
      layout["NanoHost_Show_RowNum "..i] = { PrettyName="NanoHost~Show "..i.."~Row Number", Style="Text", IsReadOnly=true, Position={SNO_X, ry+3}, Size={20,16} }
      layout["NanoHost_Show_FS "..i]    = { PrettyName="NanoHost~Show "..i.."~First Show Start", Style="Led", IsReadOnly=true, Color=MARKER_OFF_FS, Position={SFS_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_FE "..i]    = { PrettyName="NanoHost~Show "..i.."~First Show End",   Style="Led", IsReadOnly=true, Color=MARKER_OFF_FE, Position={SFE_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_LS "..i]    = { PrettyName="NanoHost~Show "..i.."~Last Show Start",  Style="Led", IsReadOnly=true, Color=MARKER_OFF_LS, Position={SLS_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_LE "..i]    = { PrettyName="NanoHost~Show "..i.."~Last Show End",    Style="Led", IsReadOnly=true, Color=MARKER_OFF_LE, Position={SLE_X, ry+3}, Size={SLED,SLED} }
      -- Start/End highlight LEDs: default IsInvisible=true (hidden) until
      -- the runtime marks them active -- see setHighlightLed().
      layout["NanoHost_Show_Start "..i] = { PrettyName="NanoHost~Show "..i.."~Show Start (Now Playing)", Style="Led", IsReadOnly=true, Color="green", IsInvisible=true, Position={SSTARTHL_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_End "..i]   = { PrettyName="NanoHost~Show "..i.."~Show End (Now Playing)",   Style="Led", IsReadOnly=true, Color="green", IsInvisible=true, Position={SENDHL_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_StartTime "..i] = { PrettyName="NanoHost~Show "..i.."~StartTime", Style="Text", IsReadOnly=true, Position={SST_X, ry}, Size={130,18} }
      layout["NanoHost_Show_RunTime "..i]   = { PrettyName="NanoHost~Show "..i.."~RunTime",   Style="Text", IsReadOnly=true, Position={SRT_X, ry}, Size={40,18} }
      layout["NanoHost_Show_PerfNum "..i]   = { PrettyName="NanoHost~Show "..i.."~PerfNum",   Style="Text", IsReadOnly=true, Position={SPN_X, ry}, Size={40,18} }
      layout["NanoHost_Show_Sold "..i]      = { PrettyName="NanoHost~Show "..i.."~Sold",   Style="Led", IsReadOnly=true, Color="green", Position={SSOLD_LED_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_Cancel "..i]    = { PrettyName="NanoHost~Show "..i.."~Cancel", Style="Led", IsReadOnly=true, Color="green", Position={SCAN_LED_X, ry+3}, Size={SLED,SLED} }
      layout["NanoHost_Show_Title "..i]     = { PrettyName="NanoHost~Show "..i.."~Title", Style="Text", IsReadOnly=true, Position={STITLE_X, ry}, Size={(W-20)-STITLE_X, 18} }
    end
    y = y + MAX_SHOWS * SROWH + 10

    hdr(y, 'Key', 14)
    y = y + 20
    table.insert(graphics, { Type="Label",
      Text="FS = First Show Start        FE = First Show End        LS = Last Show Start        LE = Last Show End",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 18
    -- The Cyan LED explanation is one paragraph (both sentences), allowed
    -- to word-wrap within a single, taller Label rather than being split
    -- into two explicit lines.
    table.insert(graphics, { Type="Label",
      Text="The Cyan LED and highlighted show indicate which is the active show. The \"POS Ticket Sold\" and \"POS In Show\" Status Flags refer to this show.",
      Position={LX, y}, Size={W-20, 32}, HTextAlign="Left", FontSize=10 })
    y = y + 32
    y = y + 8  -- blank line -- paragraph break before the Yellow LED paragraph
    table.insert(graphics, { Type="Label",
      Text="The Yellow LED and highlighted RunTime indicate that the show is in progress and past the posted showtime.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 16
    y = y + 8  -- blank line -- paragraph break before the help-file sentence
    table.insert(graphics, { Type="Label",
      Text="For additional information, please see the help file.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 16

    -- Day Start controls -- formatted to match the Dimmer Control page's
    -- Zone_Offset styling (fader 120 wide, offset text 40, step buttons 40,
    -- row height 22). Two rows: the Day Start LED sits above the
    -- Trigger LED, both to the left of the fader; the "Offset (minutes)"
    -- column header sits above the fader (same pattern as "Offset %" above
    -- Zone_Offset); the offset text and -/+ step buttons sit to the right of
    -- the fader, in the same order and spacing as Zone_Offset.
    y = y + 10
    hdr(y, 'Day Start', 16)
    y = y + 20
    table.insert(graphics, { Type="Label",
      Text="Set the Offset to the desired lead time before the first show, including your typical preshow length ahead of the posted Start Time.",
      Position={LX, y}, Size={W-20, 32}, HTextAlign="Left", FontSize=10 })
    y = y + 32
    y = y + 8  -- gap before the controls, matching the Key section's own header-to-body spacing
    lbl(LX, y, 130, 'Day Start:', 14)
    layout["NanoHost_DayStart"] = { PrettyName="NanoHost~Day Start", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+2}, Size={16,16} }
    textlbl(LX+161, y+2, 120, 'Offset (minutes)', 12, "Center")
    y = y + 20
    lbl(LX, y, 130, 'Trigger:', 14)
    layout["NanoHost_DayStart_Trigger"] = { PrettyName="NanoHost~Day Start Trigger", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+3}, Size={16,16} }
    layout["NanoHost_DayStartOffset"] = { PrettyName="NanoHost~Day Start Offset", Style="Fader", Orientation="Horizontal", Color={72,147,217}, Min=-180, Max=60, Position={LX+161, y}, Size={120, 22} }
    layout["NanoHost_DayStartOffset_Text"] = { PrettyName="NanoHost~Day Start Offset Text", Style="Text", Position={LX+287, y}, Size={40, 22} }
    layout["NanoHost_DayStartOffset_Dec"] = { PrettyName="NanoHost~Day Start Offset Decrease", Style="Button", ButtonStyle="Momentary", Legend="-", Position={LX+337, y}, Size={38, 22} }
    layout["NanoHost_DayStartOffset_Inc"] = { PrettyName="NanoHost~Day Start Offset Increase", Style="Button", ButtonStyle="Momentary", Legend="+", Position={LX+383, y}, Size={38, 22} }
    y = y + 32

    -- Day End controls -- identical formatting to Day Start above: fader
    -- 120 wide, offset text 40, step buttons 40, row height 22. Day End
    -- LED above Trigger LED, both left of the fader; "Offset
    -- (minutes)" header above the fader; offset text and -/+ step buttons
    -- to the right of the fader.
    y = y + 10
    hdr(y, 'Day End', 16)
    y = y + 20
    table.insert(graphics, { Type="Label",
      Text="Set the Offset to allow for normal cooling and content transfers, plus any compensation needed for preshow time ahead of the posted Start Time.",
      Position={LX, y}, Size={W-20, 32}, HTextAlign="Left", FontSize=10 })
    y = y + 32
    y = y + 8  -- gap before the controls, matching the Key section's own header-to-body spacing
    lbl(LX, y, 130, 'Day End:', 14)
    layout["NanoHost_DayEnd"] = { PrettyName="NanoHost~Day End", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+2}, Size={16,16} }
    textlbl(LX+161, y+2, 120, 'Offset (minutes)', 12, "Center")
    y = y + 20
    lbl(LX, y, 130, 'Trigger:', 14)
    layout["NanoHost_DayEnd_Trigger"] = { PrettyName="NanoHost~Day End Trigger", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+3}, Size={16,16} }
    layout["NanoHost_DayEndOffset"] = { PrettyName="NanoHost~Day End Offset", Style="Fader", Orientation="Horizontal", Color={72,147,217}, Min=-60, Max=240, Position={LX+161, y}, Size={120, 22} }
    layout["NanoHost_DayEndOffset_Text"] = { PrettyName="NanoHost~Day End Offset Text", Style="Text", Position={LX+287, y}, Size={40, 22} }
    layout["NanoHost_DayEndOffset_Dec"] = { PrettyName="NanoHost~Day End Offset Decrease", Style="Button", ButtonStyle="Momentary", Legend="-", Position={LX+337, y}, Size={38, 22} }
    layout["NanoHost_DayEndOffset_Inc"] = { PrettyName="NanoHost~Day End Offset Increase", Style="Button", ButtonStyle="Momentary", Legend="+", Position={LX+383, y}, Size={38, 22} }
    y = y + 32

    -- First Show End controls -- formatted identically to Day
    -- Start/Day End (state LED above Trigger LED): row 1 has the
    -- "First Show End:" label and state LED, plus
    -- the "Offset (minutes)" caption above the fader; row 2 is the Trigger
    -- row with the fader and step buttons.
    y = y + 10
    hdr(y, 'First Show End', 16)
    y = y + 20
    table.insert(graphics, { Type="Label",
      Text="Set the Offset to compensate for Preshow content.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 16
    y = y + 8  -- gap before the controls, matching the Key section's own header-to-body spacing
    lbl(LX, y, 130, 'First Show End:', 14)
    layout["NanoHost_FirstShowEnd"] = { PrettyName="NanoHost~First Show End", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+2}, Size={16,16} }
    textlbl(LX+161, y+2, 120, 'Offset (minutes)', 12, "Center")
    y = y + 20
    lbl(LX, y, 130, 'Trigger:', 14)
    layout["NanoHost_FirstShowEnd_Trigger"] = { PrettyName="NanoHost~First Show End Trigger", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+3}, Size={16,16} }
    layout["NanoHost_FirstShowEndOffset"] = { PrettyName="NanoHost~First Show End Offset", Style="Fader", Orientation="Horizontal", Color={72,147,217}, Min=-60, Max=60, Position={LX+161, y}, Size={120, 22} }
    layout["NanoHost_FirstShowEndOffset_Text"] = { PrettyName="NanoHost~First Show End Offset Text", Style="Text", Position={LX+287, y}, Size={40, 22} }
    layout["NanoHost_FirstShowEndOffset_Dec"] = { PrettyName="NanoHost~First Show End Offset Decrease", Style="Button", ButtonStyle="Momentary", Legend="-", Position={LX+337, y}, Size={38, 22} }
    layout["NanoHost_FirstShowEndOffset_Inc"] = { PrettyName="NanoHost~First Show End Offset Increase", Style="Button", ButtonStyle="Momentary", Legend="+", Position={LX+383, y}, Size={38, 22} }
    y = y + 32

    -- Last Show Start controls -- same two-row formatting as Day Start/Day
    -- End (state LED above Trigger LED, both left of the fader; "Offset
    -- (minutes)" header above the fader; offset text and -/+ step buttons
    -- to the right), gated on LS instead of FS/LE.
    y = y + 10
    hdr(y, 'Last Show Start', 16)
    y = y + 20
    table.insert(graphics, { Type="Label",
      Text="Set the Offset to compensate for the Preshow content.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 16
    y = y + 8  -- gap before the controls, matching the Key section's own header-to-body spacing
    lbl(LX, y, 130, 'Last Show Start:', 14)
    layout["NanoHost_LastShowStart"] = { PrettyName="NanoHost~Last Show Start", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+2}, Size={16,16} }
    textlbl(LX+161, y+2, 120, 'Offset (minutes)', 12, "Center")
    y = y + 20
    lbl(LX, y, 130, 'Trigger:', 14)
    layout["NanoHost_LastShowStart_Trigger"] = { PrettyName="NanoHost~Last Show Start Trigger", Style="Led", IsReadOnly=true, Color="dimgray", Position={LX+135, y+3}, Size={16,16} }
    layout["NanoHost_LastShowStartOffset"] = { PrettyName="NanoHost~Last Show Start Offset", Style="Fader", Orientation="Horizontal", Color={72,147,217}, Min=-90, Max=60, Position={LX+161, y}, Size={120, 22} }
    layout["NanoHost_LastShowStartOffset_Text"] = { PrettyName="NanoHost~Last Show Start Offset Text", Style="Text", Position={LX+287, y}, Size={40, 22} }
    layout["NanoHost_LastShowStartOffset_Dec"] = { PrettyName="NanoHost~Last Show Start Offset Decrease", Style="Button", ButtonStyle="Momentary", Legend="-", Position={LX+337, y}, Size={38, 22} }
    layout["NanoHost_LastShowStartOffset_Inc"] = { PrettyName="NanoHost~Last Show Start Offset Increase", Style="Button", ButtonStyle="Momentary", Legend="+", Position={LX+383, y}, Size={38, 22} }
    y = y + 32

  -- ================================================================
  -- EVENT LOG TAB: Core Manager Event Logging enables (v1.4)
  -- ================================================================
  elseif CurrentPage == "Event Log" then
    local y = 8
    hdr(y, 'Event Logging', 18)
    y = y + 24
    table.insert(graphics, { Type="Label",
      Text="Sends selected events to the Q-SYS Core Manager Event Log.",
      Position={LX, y}, Size={W-20, 16}, HTextAlign="Left", FontSize=10 })
    y = y + 22

    lbl(LX, y, 115, 'Enable:', 16)
    layout["Log_Enable"] = { PrettyName="Event Log~Enable", Style="Button", ButtonStyle="Toggle", Legend="Enable Event Logging", Position={FX,y}, Size={170,22} }
    y = y + 34

    hdr(y, 'Categories', 16)
    y = y + 24

    lbl(LX, y, 115, 'Connection:', 14)
    layout["Log_Enable_Connection"] = { PrettyName="Event Log~Connection", Style="Button", ButtonStyle="Toggle", Legend="Log Connection", Position={FX,y}, Size={160,22} }
    y = y + 28

    lbl(LX, y, 115, 'Inputs:', 14)
    layout["Log_Enable_Inputs"] = { PrettyName="Event Log~Inputs", Style="Button", ButtonStyle="Toggle", Legend="Log Inputs", Position={FX,y}, Size={160,22} }
    y = y + 28

    lbl(LX, y, 115, 'Outputs:', 14)
    layout["Log_Enable_Outputs"] = { PrettyName="Event Log~Outputs", Style="Button", ButtonStyle="Toggle", Legend="Log Outputs", Position={FX,y}, Size={160,22} }
    y = y + 28

    lbl(LX, y, 115, 'Program:', 14)
    layout["Log_Enable_Program"] = { PrettyName="Event Log~Program", Style="Button", ButtonStyle="Toggle", Legend="Log Program", Position={FX,y}, Size={160,22} }
    y = y + 28

    lbl(LX, y, 115, 'Macros:', 14)
    layout["Log_Enable_Macros"] = { PrettyName="Event Log~Macros", Style="Button", ButtonStyle="Toggle", Legend="Log Macros", Position={FX,y}, Size={160,22} }
    y = y + 28
    table.insert(graphics, { Type="Label",
      Text="Only Macros triggered by this plugin are logged, not macros run directly on the eCNA.",
      Position={FX, y}, Size={W-FX-10, 28}, HTextAlign="Left", FontSize=10 })
    y = y + 34

    lbl(LX, y, 115, 'RDI:', 14)
    layout["Log_Enable_RDI"] = { PrettyName="Event Log~RDI", Style="Button", ButtonStyle="Toggle", Legend="Log RDI", Position={FX,y}, Size={160,22} }
    y = y + 28
    -- Per-device sub-toggles, one row of small buttons labeled 1..N.
    -- Only takes effect when Log_Enable_RDI above is also on -- see the
    -- matching GetControls comment. Page genuinely grows/shrinks with
    -- numRDI, same reasoning as the Dimmer Control/NanoHost sections below.
    if numRDI > 0 then
      lbl(LX, y, 115, 'RDI Devices:', 12)
      local dbw = 34
      for dev = 1, numRDI do
        local dx = FX + (dev-1)*(dbw+4)
        layout[layoutKey("Log_Enable_RDI_Dev", numRDI, dev)] = { PrettyName="Event Log~RDI Device "..dev, Style="Button", ButtonStyle="Toggle", Legend=tostring(dev), Position={dx, y}, Size={dbw, 22} }
      end
      y = y + 28
    end
    table.insert(graphics, { Type="Label",
      Text="Only RDI commands triggered by this plugin are logged, not RDI run directly on the eCNA. Individual devices above can be silenced while RDI stays enabled.",
      Position={FX, y}, Size={W-FX-10, 28}, HTextAlign="Left", FontSize=10 })
    y = y + 34

    -- Tied to Enable_QDC_Lighting only -- see the matching comment in
    -- GetControls for why this isn't also gated on qZones>2. The page
    -- genuinely grows/shrinks with this property, since GetControlLayout is
    -- rebuilt from props on every call -- no IsInvisible/IsActive needed.
    if enableQDC then
      lbl(LX, y, 115, 'Dimmer Control:', 14)
      layout["Log_Enable_Dimmer"] = { PrettyName="Event Log~Dimmer Control", Style="Button", ButtonStyle="Toggle", Legend="Log Dimmer Control", Position={FX,y}, Size={160,22} }
      y = y + 28
      table.insert(graphics, { Type="Label",
        Text="Zone 3+ presets (Zones 1-2 preset is under Outputs); any offset change for every zone, including House/Stage.",
        Position={FX, y}, Size={W-FX-10, 28}, HTextAlign="Left", FontSize=10 })
      y = y + 34
    end

    -- Only present when NanoHost is enabled -- same page grow/shrink
    -- reasoning as Dimmer Control above.
    if enableNanoHost then
      lbl(LX, y, 115, 'NanoHost:', 14)
      layout["Log_Enable_NanoHost"] = { PrettyName="Event Log~NanoHost", Style="Button", ButtonStyle="Toggle", Legend="Log NanoHost", Position={FX,y}, Size={160,22} }
      y = y + 28
      table.insert(graphics, { Type="Label",
        Text="Logs the Day Start/Day End/First Show End/Last Show Start triggers and Status Flag changes.",
        Position={FX, y}, Size={W-FX-10, 28}, HTextAlign="Left", FontSize=10 })
      y = y + 34
    end

    -- Recent history: last 10 entries actually sent to the Core Manager
    -- Event Log, newest first, each carrying its own date/time stamp.
    y = y + 6
    hdr(y, 'Recent Log Entries', 16)
    y = y + 22
    for i = 1, 10 do
      layout["Log_History "..i] = { PrettyName="Event Log~History "..i, Style="Text", IsReadOnly=true, HTextAlign="Left", Position={LX, y}, Size={W-20, 16} }
      y = y + 18
    end
  end

  return layout, graphics
end

-- ============================================================
-- RUNTIME: Executes on Q-SYS Core when Controls table is available
-- All live device communication happens in this block
-- ============================================================
if Controls then

  -- ── Configuration ──────────────────────────────────────────
  local TCP_PORT    = 13002  -- default port; overridden by Setup page TCP Port field
  -- CAI status-poll cadence (drives the whole Program page). Was a fixed
  -- 45s internal constant; now reads RST_Poll_Interval (default lowered
  -- to 5s in v1.4.0.19 -- see that property's own comment in
  -- GetProperties for the full rationale and the 60s-idle-channel
  -- ceiling it must stay under). The `or 45` fallback below only matters
  -- if Properties["RST_Poll_Interval"] is somehow missing entirely (e.g.
  -- an old saved design predating this property) -- kept at 45 rather
  -- than 5 deliberately, so that edge case falls back to the original,
  -- longest-standing behavior rather than silently opting into the new
  -- faster default.
  local POLL_RATE   = (Properties["RST_Poll_Interval"] and Properties["RST_Poll_Interval"].Value or 45)
  -- Use property values; fall back to defaults if not set
  local SCRAPE_RATE = (Properties["Scrape_Interval"] and Properties["Scrape_Interval"].Value or 2)
  -- Converts the dimmer LIGHTPOLL's own decoupled cadence into "every Nth
  -- routine turn," since the plugin only reasons in turns/ticks (no
  -- wall-clock query available). Rounds to the nearest whole tick, floored
  -- at 2: if this floor were 1 instead, a routine cadence close enough to
  -- Scrape_Interval could round down to exactly 1 tick, and since
  -- httpRequest()'s "routineTicks >= lightPollEveryNTicks" check would then
  -- be satisfied on every single routine tick, LIGHTPOLL would win every
  -- turn and scrape would never run at all (Status stuck on "Initializing"
  -- forever, since populated.scrape can never become true). Flooring at 2
  -- guarantees scrape at least every-other-tick no matter how close the two
  -- intervals are.
  local LIGHTPOLL_RATE = (Properties["LightPoll_Interval"] and Properties["LightPoll_Interval"].Value or 3)
  local lightPollEveryNTicks = math.max(2, math.floor(LIGHTPOLL_RATE / SCRAPE_RATE + 0.5))
  -- nanoHost POS management data -- not a user property, because the
  -- nanoHost itself only updates what the eCNA reports at most every few
  -- minutes, so anything meaningfully faster just burns HTTP turns for
  -- stale data; this is the lowest-priority poll in the plugin. Same "every
  -- Nth routine tick" conversion and floor-at-2 pattern as LIGHTPOLL_RATE
  -- above, for the same starvation-guard reason.
  local NANO_POLL_RATE = 120
  local nanoPollEveryNTicks = math.max(2, math.floor(NANO_POLL_RATE / SCRAPE_RATE + 0.5))
  -- Names (input, output, and dimmer zone/channel setup) are fetched once
  -- on connect and otherwise only via their manual Refresh buttons -- they
  -- essentially never change after commissioning, so no periodic
  -- auto-refresh competes with the flag scrape / light poll for a slot.
  local ENABLE_QDC   = Properties["Enable_QDC_Lighting"] and Properties["Enable_QDC_Lighting"].Value or false
  local qdcZones     = ENABLE_QDC and (Properties["QDC_Zones"]    and Properties["QDC_Zones"].Value    or 2) or 0
  local qdcChannels  = ENABLE_QDC and (Properties["QDC_Channels"] and Properties["QDC_Channels"].Value or 2) or 0
  -- When off, nanoHost is fully out of the poll rotation (see
  -- httpRequest()'s priority chain below), not just hidden controls.
  local ENABLE_NANOHOST = Properties["Enable_NanoHost"] and Properties["Enable_NanoHost"].Value or false
  -- Top tier of Event Logging (v1.4) -- see logEvent() below. When off, the
  -- Log_Enable* controls don't even exist, so every logEvent() call must
  -- check this first, before touching any Controls.Log_Enable* reference.
  local ENABLE_EVENT_LOG = Properties["Enable_Event_Log"] and Properties["Enable_Event_Log"].Value or false
  -- RDI device names (v1.4): fetched from Setup.xml?PgIdx=69..73 (one page
  -- per device, PgIdx = 68+device#, confirmed against a real eCNA-5 --
  -- <rdevices><rdevice>N ... <rdnam>NAME</rdnam> ... </rdevice></rdevices>,
  -- one <rdevice> block per request). Used only to decorate RDI Event Log
  -- messages, e.g. "RDI device 1 [Barco] command 5 triggered" -- same
  -- bracket style as In_Names/Out_Names. Declared here (not down by
  -- inputNames/outputNames) so it's already a valid upvalue for the
  -- Connected-event bootstrap closure below, which runs textually earlier
  -- in the file than the input/output name tables.
  local RDI_COUNT = tonumber(Properties["Num_RDI"] and Properties["Num_RDI"].Value) or 5
  local rdiNames    = {}  -- rdiNames[1..RDI_COUNT] = user-defined device name; nil until fetched
  local rdiCmdNames = {}  -- rdiCmdNames[dev][1..16] = user-defined command name (<rdcnam> inside the same PgIdx=69..73 response); nil until fetched or if left blank on the eCNA
  local applyRDIName = nil -- forward declaration; defined after dbg() below (its closure calls dbg)

  -- Macro names (v1.4): unlike In/Out (one page lists all 16) or RDI (one
  -- page per device, 5 max), each Macro's name lives on its OWN page --
  -- Setup.xml?PgIdx=15+macro#, confirmed against a real eCNA-5 --
  -- <macros><macro>N <mnam>NAME</mnam> ...other macro step data...
  -- </macro></macros> -- and Num_Macros can be as high as 50. Fetching all
  -- of those eagerly at connect, the same way RDI/In/Out do, would add up
  -- to 50 HTTP round trips ahead of reaching "OK" -- a real, not
  -- theoretical, connect-time regression. Per Steve, these are instead
  -- queued into their own macroNameQueue and drained at the LOWEST
  -- priority of all HTTP traffic -- one fetch every MACRO_FETCH_EVERY_N_TICKS
  -- scrape-equivalent turns (see httpRequest()), never stealing a turn from
  -- lightCmd/nameQueue/lightpoll/nanohost, and only occasionally from
  -- scrape. Not part of checkFullyPopulated()'s gate -- purely log-message
  -- decoration, same reasoning as rdiNames.
  local NUM_MACROS   = tonumber(Properties["Num_Macros"] and Properties["Num_Macros"].Value) or 50
  local macroNames      = {}  -- macroNames[1..NUM_MACROS] = user-defined macro name; nil until fetched
  local macroNameQueue  = {}  -- queue of {url, applyFn}, drained one at a time, lowest priority (see above)
  local applyMacroName  = nil -- forward declaration; defined after dbg() below (its closure calls dbg)

  -- Q-SYS hands back a Count=1 control as the control itself (Controls.Foo),
  -- not a 1-element array (Controls.Foo[1] does not exist). Normalizing
  -- here, once, up front, means every other place in this file that does
  -- Controls.Channel_Level[j] / Controls.Zone_Offset[i] / etc. keeps
  -- working exactly as written, regardless of whether the count is 1.
  local function normalizeSingleControl(name, count)
    if count == 1 and Controls[name] then
      Controls[name] = { Controls[name] }
    end
  end
  if ENABLE_QDC then
    normalizeSingleControl("Zone_Name",          qdcZones)
    normalizeSingleControl("Zone_Offset",        qdcZones)
    normalizeSingleControl("Zone_Offset_Text",   qdcZones)
    normalizeSingleControl("Zone_Offset_Inc",    qdcZones)
    normalizeSingleControl("Zone_Offset_Dec",    qdcZones)
    normalizeSingleControl("Channel_Level",      qdcChannels)
    normalizeSingleControl("Channel_Level_Text", qdcChannels)
    normalizeSingleControl("Channel_Zone",       qdcChannels)
    normalizeSingleControl("Channel_Present",    qdcChannels)
  end
  -- Same Count=1 gotcha, same fix -- Num_Macros allows 0-50, so a
  -- single-macro design is just as reachable as single-zone/single-
  -- channel. Without this, Controls.Macros at Num_Macros=1 would be the
  -- bare control rather than a 1-element array, and the
  -- "ipairs(Controls.Macros)" wiring loop below would silently iterate
  -- zero times -- the button would be visible but would never actually do
  -- anything when pressed.
  normalizeSingleControl("Macros", (Properties["Num_Macros"] and Properties["Num_Macros"].Value or 50))

  -- ── Flag name tables (used to initialise LED legends) ──────
  local InFlagNames = {
    "Stop","Start","Dig1 Cue","Dig1 Fault","Dig1 Stop","Dig1 Start",
    "Dig2 Cue","Dig2 Fault","Dig2 Stop","Dig2 Start",
    "Bypass","Program Abort","Pause","In1","In2","In3","In4",
    "Fire Stop","In5","In6","In7","In8","In9","In10","In11","In12",
    "In13","In14","In15","In16","Cancel"
  }

  -- ── State variables ────────────────────────────────────────
  local psn          = 0       -- Packet Sequence Number (0-65535, wraps)
  local nameQueue    = {}      -- queue of {pgIdx, applyFn} name fetch requests
  local currentReq   = nil     -- current httpSock request context (nil=scrape)
  local httpBusy     = false   -- true while a request is in-flight; prevents double-sends
  local applyInputNames  = nil -- forward declaration; defined after name tables
  local applyOutputNames = nil -- forward declaration; defined after name tables
  local httpSock         = nil -- forward declaration; assigned after httpSock section
  local scrapeTimer      = nil -- forward declaration (v1.4.0.20, moved up from the httpSock section below); PingGate's stability-window resolution needs to reach this as an upvalue, and PingGate itself has to sit before sock.EventHandler (which is textually earlier than the httpSock section) -- same forward-decl pattern as httpSock just above. Actual Timer.New() assignment stays where it was.
  local sock         = TcpSocket.New()  -- CAI TCP connection (port 13002)
  -- Disable TcpSocket's own built-in auto-reconnect (v1.4.0.15). Its default
  -- ReconnectTimeout is 5s, and it runs independently of reconnectTmr below
  -- -- confirmed in the field via debug logs where every retry landed ~5s
  -- after the last one regardless of what the backoff logic (5/15/30s) had
  -- just scheduled. The built-in loop was winning the race every time,
  -- silently hammering the eCNA with a fresh TCP connect (and RID/CFG send)
  -- every 5s through an entire lockout, no matter what reconnectTmr intended.
  -- Setting this to 0 makes reconnectTmr the sole driver of reconnect
  -- timing, so the backoff actually takes effect.
  sock.ReconnectTimeout = 0
  -- Detect a silently-unresponsive eCNA promptly (v1.4.0.16). Without this,
  -- TcpSocket only raises Closed/Error when the OS notices the TCP
  -- connection itself died -- if the eCNA stops answering polls without
  -- actually tearing down the connection (observed in the field: two
  -- consecutive RST polls sent with zero reply), nothing catches that on its
  -- own, and Status is left showing stale "OK" indefinitely while nothing is
  -- actually being gathered. Margin of +10s over POLL_RATE tolerates one
  -- missed/slow response without false-triggering on ordinary jitter, while
  -- still catching real silence well before a second poll cycle would.
  -- POLL_RATE is fixed for the plugin instance's lifetime (a Designer
  -- property, not runtime-adjustable), so this only needs to be set once.
  sock.ReadTimeout = POLL_RATE + 10
  local pollTimer    = Timer.New()      -- Fires RST poll at POLL_RATE seconds
  local reconnectTmr = Timer.New()      -- Fires reconnect attempt after disconnect
  local meterTimer   = nil              -- forward decl; assigned via Timer.New() below only if ENABLE_QDC. MUST live at this persistent scope, not inside "if ENABLE_QDC then" -- a Timer.New() declared as a `local` fully inside that block has no reference from outside it once the block finishes executing, and despite its EventHandler self-referencing it (a closure cycle), an object unreachable from any persistent root can still be garbage collected. That was very likely why the meter animation went choppy/stopped ticking in the field: the timer was probably being collected shortly after creation instead of running for the plugin's whole lifetime like pollTimer/reconnectTmr/scrapeTimer do.
  local nanoTickTimer = nil             -- v1.3: forward decl; same persistent-scope requirement as meterTimer above -- assigned via Timer.New() below only if ENABLE_NANOHOST.
  local rxBuf        = ""      -- Receive buffer for incoming CAI data
  local isConnected  = false   -- True when CAI TCP socket is connected
  -- Event Logging (v1.4) change-tracking baselines. nil means "never
  -- observed yet" -- the first observation for any key only ever sets the
  -- baseline, it is never itself logged (that would report the device's
  -- current state at connect time, not a real change). A key is only
  -- logged once it has a non-nil prior baseline AND statusIsOK is already
  -- true AND the new value actually differs -- see logChanged() below.
  local inputsBaseline  = {}  -- inputsBaseline[idx] = last-known Inputs[idx] boolean
  local outputsBaseline = {}  -- outputsBaseline[key] = last-known boolean, key is a control name or "GroupName" for exclusive groups
  local programBaseline = {}  -- programBaseline[field] = last-known string value (Control_State/Stopped_State/Program_Number)
  local nanoBaseline     = {} -- nanoBaseline[field] = last-known boolean for one of the six top-level NanoHost Status Flags
  -- Event Log (Connection category) tracks three logical states, separate
  -- from the five-value STATUS_* display states -- see logConnTransition's
  -- own comment below for how/why. Starts "Disconnected" -- functionally
  -- identical to "never yet connected" for every check that reads this.
  local connLogState = "Disconnected"  -- "Disconnected" | "Initializing" | "OK"
  local connecting        = false  -- true from the moment doConnect() actually calls sock:Connect() until Connected/Closed/Error resolves it; also used by the 10s failsafe below
  local connectingGen     = 0      -- bumped on every connect() call; debounces the whole disconnect-cooldown-reconnect sequence so rapid repeated calls collapse into one attempt (see connect()), and also invalidates a stale 10s failsafe timeout once a newer attempt has started
  local cooldownPending   = false  -- true from the moment a disconnect-then-reconnect cooldown is scheduled until doConnect() actually runs (whether it proceeds or stands down). Needed because between "we disconnected" and "we reconnect", isConnected and connecting are BOTH false -- without this, a second connect() call arriving in that window looks identical to "nothing in progress" and would skip the cooldown entirely.
  local intentionalDisconnect = false  -- true only for the brief window between connect()'s own deliberate sock:Disconnect() and the Closed event it causes; lets that event be correctly classified as expected teardown, not a fault
  -- True from the moment we've reacted to an unexpected disconnect (Fault
  -- status set, reconnectTmr:Start(5) scheduled) until the NEXT connect()
  -- attempt actually begins (doConnect() calling sock:Connect()). Guards
  -- against a single failed connection attempt generating more than one
  -- terminal Closed/Reconnect/Error notification -- the raw socket layer
  -- can report failure more than once for what is, from our perspective,
  -- the same outstanding attempt (e.g. an initial low-level error followed
  -- later by a formal socket-closed notification). Without this guard,
  -- each of those redundant notifications would re-log Fault and restart
  -- the 5s countdown from scratch, pushing the actual retry further out
  -- and making Status flap Initializing/Disconnected unpredictably instead
  -- of retrying on a clean, predictable cadence.
  local reconnectScheduled = false

  -- Reconnect backoff after an explicit eCNA rejection (v1.4.0.14).
  -- RSP,ERR,...,998,Resource Unavailable is the eCNA explicitly telling us
  -- it has no session to give right now -- observed almost exclusively in
  -- the minutes right after an eCNA power cycle (debug captures
  -- 2026-08-07), where it can recur for anywhere from a few seconds to
  -- several minutes. Retrying every fixed 5s regardless, the prior
  -- behavior, meant dozens of fresh CAI connection attempts landing on the
  -- eCNA during exactly the window it said it was constrained. This widens
  -- the gap between attempts after repeated rejections instead -- 5s, then
  -- 15s, then 30s, capped -- so we back off rather than hammer, while still
  -- reconnecting automatically once the eCNA is ready. Does NOT change
  -- behavior for any other disconnect reason (network blip, intentional
  -- reconnect, connect timeout on an unreachable target) -- those keep the
  -- existing flat 5s retry.
  local RECONNECT_BACKOFF_STEPS = {5, 15, 30}  -- seconds; index clamps at the last entry
  local reconnectBackoffIdx = 1
  -- Set the instant a RSP,ERR with code 998 (Resource Unavailable) is
  -- received; consumed and cleared by the very next Closed/Error/Reconnect
  -- socket event (which, per the observed logs, follows within
  -- milliseconds -- the eCNA sends the rejection and then closes the
  -- connection). Also cleared on a fresh TCP-level Connected event as a
  -- staleness guard, in case some future firmware behavior ever leaves the
  -- socket open after an ERR instead of closing it.
  local lastErrWasResourceUnavailable = false

  -- ── QDC-400 Dimmer Lighting state (v1.2) ────────────────────
  -- Forward-declared per the scoping rule in DESIGN NOTES §4: anything
  -- referenced inside a closure defined earlier in this block (socket
  -- EventHandlers, Control EventHandlers) must be declared here first.
  local applyDimmerSetup = nil    -- forward decl; defined after zoneNames/channelZone tables
  local resetForNewTarget = nil  -- forward decl; defined once all state tables below exist. Clears every queued command and every learned assumption about the connected device -- called whenever IP_ADDRESS actually changes, so a command queued for one unit (e.g. while testing against an unreachable address) can never be flushed out and applied to a DIFFERENT unit once connectivity resumes.
  local applyLinNetwork  = nil    -- forward decl; defined near applyDimmerSetup. Parses /rtLin.xml (Status: Local I/O Network) to count active QDC-400 boards -- a structural "is there even a dimmer on the bus" signal, independent of per-channel level polling.
  local qdcBoardCount    = nil    -- nil = not yet checked; 0+ = active QDC-400 boards found on the LIN network at last check
  local queueLightCmd    = nil    -- forward decl; defined after lightCmdQueue setup
  local parseLights       = nil   -- forward decl; defined near scrape()
  local parseNanoHost     = nil   -- v1.3: forward decl; defined near parseLights/scrape()
  local lightCmdQueue     = {}    -- queue of {zone0based, state, level, fader}; max depth 4, mirrors eCNA's own CmdBuf
  local zoneNames         = {}    -- zoneNames[3..16] = user-defined zone name (House/Stage are fixed, not fetched)
  local channelZone       = {}    -- channelZone[1..qdcChannels] = 0-based rtLights.xml zone index, or -1 if unassigned
  local currentReqType    = "SCRAPE" -- "SCRAPE" | "LIGHTPOLL" | "NAME" | "LIGHTCMD" | "NANOHOST" -- routes the HTTP response to the right parser
  local currentApplyFn    = nil      -- used only when currentReqType == "NAME"
  -- Scrape is the default action on every routine turn; the dimmer
  -- LIGHTPOLL only steals a turn once its own decoupled interval elapses,
  -- tracked as a tick count (see routineTicks/lightPollEveryNTicks near
  -- httpRequest).

  -- Optimistic-UI masking: while a user-initiated zone change is
  -- in flight, the eCNA's rtLights.xml poll can still echo back the OLD
  -- level for a cycle or two (single shared HTTP connection = latency).
  -- Without masking this makes the offset slider visibly crawl/overshoot
  -- toward the released position across several refreshes. Fix: once the
  -- user changes a zone, ignore polled updates for that zone's controls
  -- until the polled value matches what was requested, or 15s elapses
  -- (whichever comes first) -- then resume normal live updates.
  local beginOffsetPending = nil  -- forward decl; defined after queueLightCmd
  local beginPresetPending = nil  -- forward decl; defined after queueLightCmd
  local offsetPending = {}  -- offsetPending[zone] = true while masking Zone_Offset/_Text for that zone
  local offsetDebounceGen = {}  -- offsetDebounceGen[zone] = generation counter for the 1s fader-settle debounce
  local offsetTarget  = {}  -- offsetTarget[zone]  = offset value we're waiting to see echoed back
  local offsetGen      = {} -- offsetGen[zone]      = generation counter; invalidates stale 15s timeouts
  local presetPending  = {} -- presetPending[zone]  = true while masking Zone_Preset buttons for that zone
  local presetTarget   = {} -- presetTarget[zone]   = preset state (0-4) we're waiting to see echoed back
  local presetGen      = {} -- presetGen[zone]      = generation counter; invalidates stale 15s timeouts

  -- ── Local dimmer meter simulation ────────────────
  -- The shared HTTP connection can only poll rtLights.xml every couple of
  -- seconds, which is far slower than a real dimmer fade (e.g. Mid1->Up in
  -- 2.5s per the configured level/fade-time). Rather than have the meter
  -- visibly jump or lag, we animate it locally between polls using the
  -- actual configured Level%/Fade-time for the preset being transitioned
  -- to (fetched from Setup.xml PgIdx=13, manual §4.3.29/§4.3.19-21), then
  -- hand back control to the live poll once our own predicted ramp
  -- finishes -- "verify/correct" happens naturally at that point since
  -- parseLights() only trusts the local simulation while animating.
  local channelPresetLevel = {} -- channelPresetLevel[ch][0..3] = configured target level % for state Up/Down/Mid1/Mid2
  local channelPresetFade  = {} -- channelPresetFade[ch][0..3]  = configured fade-in seconds for that same preset (nil/0 = instant)
  local zoneCurrentPreset  = {} -- zoneCurrentPreset[zone] = last known preset state (0-4), used to combine with a later offset-only change
  local zoneLastOffset     = {} -- zoneLastOffset[zone] = last known confirmed offset value, used (alongside zoneCurrentPreset) to detect whether a poll update represents a genuine preset and/or offset change, so the two can be combined into one correct animation target instead of animating to the bare preset level first
  -- Event Log (Dimmer Control category, v1.4): readable labels for zsta's
  -- 0-4 preset codes, indexed sta+1 -- matches the design-time presetLabels
  -- used for button Legends in GetControlLayout.
  local ZonePresetLabels   = {"Up","Down","Mid1","Mid2","None"}
  local zoneFastPreset     = {} -- zoneFastPreset[zone: 1 or 2 only] = last House/Stage state as derived from the fast CAI output flags; triggers early animation only, never used for offset math (see scrape())
  local channelAnimating   = {} -- channelAnimating[ch] = true while locally simulating (parseLights ignores live cact for this channel)
  local channelSimTarget   = {} -- channelSimTarget[ch] = level % the local simulation is ramping toward
  local channelSimRate     = {} -- channelSimRate[ch]   = %/second ramp rate (100 / configured fade seconds)
  -- Must be declared here (before parseLights, below) rather than
  -- alongside channelWaitZone/channelWaitKind further down -- parseLights
  -- references channelPendingUnmask directly, and it's defined earlier in
  -- the file than that later declaration block, so a `local` placed after
  -- it would silently resolve to a global inside parseLights instead of the
  -- intended upvalue. See the longer design comment near channelWaitZone.
  local channelInvolvesOffset = {} -- channelInvolvesOffset[ch] = true if this channel's current/most recent transition had a non-zero offset at either end
  local channelPendingUnmask  = {} -- channelPendingUnmask[ch] = true for exactly one parseLights pass: local ramp + zone flag(s) are done, but this next poll is still skipped; cleared (and channelAnimating unmasked) after that one pass
  local startChannelAnim   = nil -- forward decl; defined near queueLightCmd/parseLights
  local animatePresetChange = nil -- forward decl; defined near startChannelAnim (preset button transitions -- uses the preset's configured fade time)
  local animateOffsetChange = nil -- forward decl; defined near startChannelAnim (offset slider/text changes -- always OFFSET_FADE_SECONDS, regardless of active preset)

  -- ── Dimmer-presence detection ────────────────────
  -- Guards against the "meter ramps toward a computed target, poll shows
  -- real 0%, meter resets, ramps again, resets again" cycle when a channel
  -- has no physical dimmer connected (or it's unpowered) -- our LUT-based
  -- target is only ever a prediction, and if the real hardware never
  -- reports back anything but 0% while we expect otherwise, we should stop
  -- fighting it and just show the truth.
  local channelZeroStreak = {} -- channelZeroStreak[ch] = consecutive live polls reporting 0% while a non-zero level was expected
  local channelNoDimmer   = {} -- channelNoDimmer[ch]   = true once 2 such polls in a row are seen; cleared the instant any non-zero level is seen
  local channelConfirmed  = {} -- channelConfirmed[ch]  = true only once a genuine non-zero level has actually been observed; drives Channel_Present (starts unlit/unknown, not lit-by-default)

  -- IP address validator: rejects empty, 0.0.0.0, or malformed addresses
  local function isValidIP(ip)
    if not ip or #ip == 0 then return false end
    local a,b,c,d = ip:match("^(%d+)%.(%d+)%.(%d+)%.(%d+)$")
    if not a then return false end
    a,b,c,d = tonumber(a),tonumber(b),tonumber(c),tonumber(d)
    if a==0 and b==0 and c==0 and d==0 then return false end
    return (a<=255 and b<=255 and c<=255 and d<=255)
  end

  -- ── Debug helper: logs to Q-SYS debug window if Show_Debug is true ──
  -- Debug output: always prints to Q-SYS debug window when ShowDebug=true in PluginInfo
  local function dbg(msg)
    print('[eCNA] ' .. tostring(msg))
  end

  -- Script Start (v1.4.0.14): per the Q-SYS SDK's plugin debug
  -- recommendations, PluginInfo.Version is printed to the debug log at the
  -- very start of runtime, before any connection activity, so a captured
  -- debug session is unambiguous about which build produced it. BUILD_VERSION
  -- (the internal identifier, also shown on the Setup page Credits) is
  -- included alongside it since the two can differ post-release -- see
  -- BUILD_VERSION's own comment near the top of the file.
  dbg("Plugin version " .. PluginInfo.Version .. " (build " .. BUILD_VERSION .. ") starting")

  -- Builds the nameQueue applyFn for one RDI device's Setup.xml page
  -- (PgIdx=68+dev). One response covers both the device name (<rdnam>,
  -- confirmed against a real eCNA-5) and its 16 command names (<rdcmd>N
  -- ... <rdcnam>NAME</rdcnam> ... </rdcmd>, same response body -- no
  -- separate fetch needed). Factored out so both the connect-time
  -- bootstrap burst and the manual Refresh_Setup button call the exact
  -- same parsing logic instead of two copies drifting apart. Defined here
  -- (after dbg) rather than up by rdiNames/rdiCmdNames because its closure
  -- calls dbg, which must already be a valid local upvalue at the point
  -- this function is textually defined.
  applyRDIName = function(dev)
    return function(body)
      local nm = body:match("<rdnam>([^<]*)</rdnam>")
      nm = nm and nm:match("^%s*(.-)%s*$") or nil
      if nm and nm ~= "" then rdiNames[dev] = nm end
      rdiCmdNames[dev] = rdiCmdNames[dev] or {}
      local cIdx = 0
      for cmdBlock in body:gmatch("<rdcmd>(.-)</rdcmd>") do
        cIdx = cIdx + 1
        if cIdx <= 16 then
          local cn = cmdBlock:match("<rdcnam>([^<]*)</rdcnam>")
          cn = cn and cn:match("^%s*(.-)%s*$") or nil
          rdiCmdNames[dev][cIdx] = (cn and cn ~= "") and cn or nil
        end
      end
      dbg("RDI device "..dev.." name: "..(rdiNames[dev] or "(unnamed)")..", "..cIdx.." command names parsed")
    end
  end

  -- Builds the macroNameQueue applyFn for one Macro's Setup.xml page
  -- (PgIdx=15+macroIdx). Parses <mnam> only -- the rest of the response
  -- (<instrm> step list) isn't needed for logging.
  applyMacroName = function(idx)
    return function(body)
      local nm = body:match("<mnam>([^<]*)</mnam>")
      nm = nm and nm:match("^%s*(.-)%s*$") or nil
      if nm and nm ~= "" then macroNames[idx] = nm end
      dbg("Macro "..idx.." name: "..(macroNames[idx] or "(unnamed)"))
    end
  end

  -- ── Event Log history (v1.4) ────────────────────────────────
  -- In-memory ring buffer of the last 10 entries actually sent via
  -- logEvent() below, newest first, each carrying its own date/time stamp
  -- so it stays meaningful even if two entries land in the same second.
  -- Purely a plugin-side convenience display -- Core Manager's own Event
  -- Log is still the actual record; this resets on plugin/script reload
  -- like every other runtime state in this file.
  local logHistory = {}
  local function recordLogHistory(entry)
    table.insert(logHistory, 1, os.date("%m/%d %H:%M:%S") .. "  " .. entry)
    if #logHistory > 10 then table.remove(logHistory, 11) end
    if Controls.Log_History then
      for i = 1, 10 do
        Controls.Log_History[i].String = logHistory[i] or ""
      end
    end
  end

  -- ── Event Log helper (v1.4) ─────────────────────────────────
  -- Sends msg to the Core Manager Event Log via Log.Message/Log.Error, and
  -- ONLY when Enable_Event_Log (top tier), the page master Log_Enable
  -- toggle, and the category's own Log_Enable_<category> toggle are all on.
  -- category must be one of Connection/Inputs/Outputs/Program/Macros/RDI/
  -- Dimmer/NanoHost -- the exact suffix of the matching Log_Enable_<category>
  -- control. Every call site is already gated (via logChanged's statusIsOK
  -- check, or its own explicit "if statusIsOK then logEvent(...)") so this
  -- only ever runs for a genuine, already-identified event -- never spammed
  -- every tick -- which is what makes an unconditional dbg() here safe and
  -- meaningful rather than noisy.
  --
  -- The dbg() call below is UNCONDITIONAL -- it fires before any of the
  -- Event Log gates, so every categorized event gets a matching debug line
  -- regardless of whether Enable_Event_Log/Log_Enable/the category toggle
  -- actually end up forwarding it. This is deliberately centralized here
  -- rather than duplicated at each of the 20+ call sites, so coverage can't
  -- drift as categories are added later. A few call sites (setStatus's own
  -- "Status: ..." line, RST's per-poll summary, the RPT EVT/TX/ERR lines)
  -- already had their own dbg() before this existed; those still fire too --
  -- a little overlap there, not a gap, and left as-is rather than trimmed.
  local function logEvent(category, msg, isError)
    dbg("[" .. category .. "] " .. msg)
    if not ENABLE_EVENT_LOG then return end
    if not (Controls.Log_Enable and Controls.Log_Enable.Boolean) then return end
    local catCtl = Controls["Log_Enable_" .. category]
    if not (catCtl and catCtl.Boolean) then return end
    -- Screen_Id (0-63) comes from the CAI RID response and is only known
    -- once the eCNA has answered at least once; "?" is the honest label for
    -- entries logged before that (e.g. the very first connect attempt).
    local id = (Controls.Screen_Id.String ~= "" and Controls.Screen_Id.String) or "?"
    local prefix = "eCNA-" .. id .. ": "
    if isError then
      Log.Error(prefix .. msg)
    else
      Log.Message(prefix .. msg)
    end
    recordLogHistory(prefix .. msg)
  end

  -- Per-device RDI logging sub-enable (v1.4). Log_Enable_RDI_Dev is
  -- Count=RDI_COUNT, which collapses to the bare control (not a table) in
  -- the Q-SYS Count=1 case -- Num_RDI's own Min is 0, so RDI_COUNT==1 is a
  -- real, reachable configuration, not just a theoretical edge case. This
  -- checks RDI_COUNT directly rather than sniffing the control shape.
  -- Does NOT check Log_Enable_RDI itself -- that's logEvent()'s own gate;
  -- this only adds the finer-grained per-device layer on top of it.
  local function rdiDevEnabled(dev)
    if not Controls.Log_Enable_RDI_Dev then return true end
    if RDI_COUNT == 1 then
      return Controls.Log_Enable_RDI_Dev.Boolean
    end
    return Controls.Log_Enable_RDI_Dev[dev] and Controls.Log_Enable_RDI_Dev[dev].Boolean
  end

  -- ── CAI Protocol helpers ────────────────────────────────────
  -- Compute CAI checksum: sum of all ASCII bytes in the prefix, mod 65536
  local function checksum(s)
    local sum = 0
    for i = 1, #s do sum = sum + string.byte(s, i) end
    return tostring(sum % 65536)
  end

  -- Increment and return the next Packet Sequence Number (wraps at 65535)
  local function nextPSN()
    psn = (psn + 1) % 65536
    return tostring(psn)
  end

  -- Build and send a CAI command: CMD,<body>,<checksum>\r\n
  local function sendCmd(body)
    local prefix = "CMD,"..body..","
    local msg    = prefix..checksum(prefix).."\r\n"
    dbg("TX: " .. msg:gsub("\r\n",""))
    if isConnected then
      sock:Write(msg)
    else
      dbg("Not connected - dropped: "..msg:gsub("\r\n",""))
    end
  end

  -- Split a comma-separated string into a table
  local function split(str, sep)
    local t = {}
    for field in str:gmatch("([^"..sep.."]*)"..sep.."?") do
      if field ~= "" then table.insert(t, field) end
    end
    return t
  end

  -- Set one button in a group active (lit), clear all others
  local function setExclusive(group, idx)
    for i, c in ipairs(group) do c.Boolean = (i == idx) end
  end

  -- ── Q-SYS Status indicator values ──────────────────────────
  -- Used for Status (text box) and Status_LED
  -- 0=OK(green) 1=Compromised(yellow) 2=Fault(red)
  -- 3=NotPresent(grey) 4=Missing(orange) 5=Initializing(blue)
  local STATUS_OK=0; local STATUS_FAULT=2
  local STATUS_MISSING=4; local STATUS_INITIALIZING=5

  -- Connection-category Event Logging (v1.4.0.18): three states -- OK,
  -- Initializing, Disconnected -- each logged only at the specific moment
  -- it's actually EARNED, not generically off setStatus()'s value. A device
  -- that's genuinely unreachable retries every 5s (see reconnectTmr) with
  -- ZERO response the whole time; none of those blind attempts call this,
  -- so nothing logs past the first Disconnected -- same noise protection
  -- the old two-state design had. What's different: once a real response
  -- actually arrives (a parsed RID or RST -- see their own call sites),
  -- THAT'S proof of life worth logging as "Initializing," and it stays
  -- logged there (repeat responses while already Initializing or OK are
  -- deduped below) until either OK is reached or the connection is
  -- confirmed lost again (Disconnected). Per Steve: "if we receive real
  -- data, then we can move to initializing from Disconnected...and sit
  -- there, until we receive an OK or stop receiving data, then we move back
  -- to disconnected." dbg() elsewhere still prints every individual status
  -- transition and its full message unconditionally, so no detail is ever
  -- lost from the debug log, just kept out of the curated Event Log.
  local function logConnTransition(newState, isError)
    if connLogState ~= newState then
      logEvent("Connection", newState, isError)
      connLogState = newState
    end
  end

  -- Update both the status text box and the LED indicator. STATUS_OK is
  -- unambiguous proof of full population (see checkFullyPopulated()), so
  -- it's safe to drive the "OK" log transition generically from here.
  -- Initializing/Disconnected are NOT driven generically from `value` --
  -- STATUS_INITIALIZING in particular fires on every bare TCP connect,
  -- including blind retries that never get a response, so logging it here
  -- would reintroduce exactly the flapping this design avoids. Those two
  -- are instead logged explicitly at the specific real-data/real-failure
  -- call sites (parseRID/parseStatusRecord for Initializing; the CAI
  -- Closed/Error/Timeout fault path, the connect-timeout failsafes, and
  -- STATUS_MISSING for Disconnected) -- see logConnTransition's comment.
  local function setStatus(value, msg)
    Controls.Status.String = msg
    Controls.Status.Value  = value
    Controls.Status_LED.Value         = value
    dbg("Status: " .. msg)
    if value == STATUS_OK then
      logConnTransition("OK")
    end
  end
  -- v1.4.0.20: a fresh "Status" Indicator control has no explicit Value in
  -- GetControls, so its raw numeric Value silently defaults to 0 -- which
  -- is STATUS_OK. Previously invisible because script start went straight
  -- into connect() with no delay, so this accidental default lasted at
  -- most a few hundred milliseconds. With the ping gate (below) able to
  -- hold off any real connection attempt for the full Ping_Stable_Window
  -- while a unit comes up, that same accidental default would now sit
  -- there showing "OK" with zero connectivity for the whole wait. Explicit
  -- initial call closes the gap -- runs synchronously at script load,
  -- before any timer, so nothing can observe the stale default.
  setStatus(STATUS_FAULT, "Disconnected")

  -- Status only reaches "OK" once every data source has responded at least
  -- once since the current connection began -- not just the first RST.
  -- Seeing "OK" should mean everything on screen reflects a real response
  -- from the currently-connected unit, not just that the TCP/CAI handshake
  -- succeeded. QDC-specific sources are only required when lighting is
  -- enabled; a unit with zero physical dimmer boards still fully responds
  -- to Setup.xml PgIdx=13 and rtLin.xml (just with sparse/zero data), so
  -- this doesn't get stuck waiting for hardware that will never appear.
  local populated = {
    rid = false, rst = false, inNames = false, outNames = false,
    dimmerSetup = false, linScan = false, scrape = false, lightPoll = false,
    nanoHost = false,  -- part of checkFullyPopulated's gate when Enable_NanoHost is on -- see comment there.
  }
  local statusIsOK = false

  -- ── Change-tracked Event Log helper (v1.4) ──────────────────
  -- Shared by Inputs/Outputs/Program logging. Logs via logEvent() only when
  -- statusIsOK is already true, a prior baseline already exists for this
  -- key (i.e. this is not the first observation), and the value actually
  -- differs from that baseline -- satisfying "only log changes, not the
  -- current state" and "no logging before OK except Connection". The
  -- baseline itself is always updated regardless of statusIsOK, so state
  -- seen while not yet OK (including across a disconnect/reconnect) is
  -- still the most recent known value for comparison once OK returns --
  -- it is just never itself logged.
  local function logChanged(baselineTbl, key, newVal, category, describe, isError)
    local old = baselineTbl[key]
    baselineTbl[key] = newVal
    if statusIsOK and old ~= nil and old ~= newVal then
      logEvent(category, describe(old, newVal), isError)
    end
  end

  -- Sets a control's Boolean (or other named property) and Event-Logs the
  -- transition under the Outputs category, sharing outputsBaseline with
  -- setExclusiveLogged below. Used at every tier that can authoritatively
  -- set an Output control's confirmed state (RST, unsolicited RPT EVT,
  -- scrape) -- whichever tier actually flips the value first is the one
  -- that logs it; the others see old==new and log nothing, so a value
  -- confirmed by multiple tiers is never logged twice.
  local function setBoolLogged(ctl, key, label, newVal, propName)
    propName = propName or "Boolean"
    ctl[propName] = newVal
    logChanged(outputsBaseline, key, newVal, "Outputs", function(old, new)
      return label .. " " .. (new and "ON" or "OFF")
    end)
  end

  -- Change-tracked wrapper around setExclusive (mutually-exclusive button
  -- groups: House/Stage Lights, Curtain, Masking, Lens, Sound). groupKey is
  -- a stable string identifying the group; optionNames maps each 1-based
  -- index to a readable label for the log message.
  local function setExclusiveLogged(group, groupKey, optionNames, idx)
    setExclusive(group, idx)
    logChanged(outputsBaseline, groupKey, idx, "Outputs", function(old, new)
      return groupKey .. " changed from " .. (optionNames[old] or tostring(old))
        .. " to " .. (optionNames[new] or tostring(new))
    end)
  end

  -- nanoHost free-running timer extrapolation. The nanoHost only refreshes
  -- what the eCNA reports at most every few minutes, and the NANOHOST poll
  -- runs even slower than that (NANO_POLL_RATE) -- too coarse to display
  -- live-looking countdowns directly from poll data alone. So the four
  -- fields that behave as genuine live counters (BSTim/ASTim count down/up
  -- toward/from a show start; BETim/AETim do the same for a show end) are
  -- extrapolated locally, once per second, between polls -- corrected back
  -- to ground truth by each real poll. RunTim/BtwTim are NOT extrapolated:
  -- they are configured/reported values, not live counters, so ticking them
  -- locally would be fabricating movement with no evidence it's real.
  --
  -- NANO_TIME_MAX (255:59, i.e. 255*60+59=15359 seconds) is the eCNA's own
  -- observed cap for "Time Between Shows"/"Time After End" when not
  -- actively counting toward/from anything -- the up-counters (ASTim/AETim)
  -- are clamped to this ceiling every tick so local extrapolation can never
  -- exceed what the real device itself would ever report.
  --
  -- Time of Day is not sourced from nanoHost/rtmandata.xml at all -- it's
  -- generated directly from the Q-SYS Core's own clock (os.date), ticked
  -- every second, completely independent of nanoHost connectivity/HostUp/
  -- nanoValid. This is a deliberate, isolated exception to this file's
  -- otherwise-consistent no-wall-clock-dependency convention (MTICK-style
  -- fixed-step timers elsewhere) -- justified here because the alternative
  -- (extrapolating a parsed date+time string with no os.* support) is far
  -- more fragile than just asking the Core what time it is.
  --
  -- Explicit anti-faking guards for the FOUR extrapolated timers (both
  -- required) -- these do NOT apply to Time of Day, which is always
  -- live/self-generated regardless of nanoHost state:
  --   1) nanoValid stays false (timers stay blanked "--:--", nothing
  --      ticks) until the FIRST real poll response has actually landed --
  --      never extrapolate from a Text control's pre-poll default.
  --   2) Whenever the last-known NanoHost_HostUp flag is false, the timers
  --      are blanked and extrapolation stops immediately -- while Host Up
  --      is not true, the Time counters are not considered true either. A
  --      later poll with HostUp true again re-seeds everything from fresh
  --      ground truth before ticking resumes.
  local nanoValid      = false  -- true once at least one real (non-UpToDate) poll has landed
  local nanoHostUp     = false  -- last known NanoHost_HostUp flag value; gates ticking/display validity
  local nanoBSSec      = 0      -- Time Before Start, seconds, counts down
  local nanoASSec      = 0      -- Time After Start, seconds, counts up
  local nanoBESec      = 0      -- Time Before End, seconds, counts down
  local nanoAESec      = 0      -- Time After End, seconds, counts up
  local NANO_TICK      = 1      -- seconds per local extrapolation tick
  local NANO_TIME_MAX  = 255*60 + 59  -- 15359s -- the eCNA's own observed time-field ceiling (255:59)

  -- ===== Day Start =====
  -- NOTE ON PLACEMENT: earlier builds carried a comment here claiming this
  -- Never put an apostrophe in any GetControls/GetControlLayout string
  -- value (Description, PrettyName, Legend, ...). One apostrophe in one
  -- Description silently blanks EVERY control on EVERY page at design
  -- time -- no error, before emulation. Write "the first show StartTime",
  -- never "the first show's StartTime". Apostrophes in COMMENTS (like this
  -- one) are fine -- comments are stripped at parse. Semicolons, colons,
  -- parentheses, +/- in Descriptions are all fine and well-precedented.
  local function parseStartTimeToEpoch(str)
    if not str or str == "" then return nil end
    local mo, da, yr, hh, mi, ss = str:match("(%d+)/(%d+)/(%d+) (%d+):(%d+):(%d+)")
    if not mo then return nil end
    return os.time({ year = tonumber(yr), month = tonumber(mo), day = tonumber(da),
      hour = tonumber(hh), min = tonumber(mi), sec = tonumber(ss) })
  end

  local dayStartWasActive = false
  local function evaluateDayStart()
    if not (Controls.NanoHost_DayStart and Controls.NanoHost_DayStartOffset
        and Controls.NanoHost_Show_FS and Controls.NanoHost_Show_Start and Controls.NanoHost_Show_StartTime) then
      return
    end
    local offsetMin = Controls.NanoHost_DayStartOffset.Value or 0
    local nowEpoch = os.time()
    local active = false
    for i = 1, MAX_SHOWS do
      local fsCtl = Controls.NanoHost_Show_FS[i]
      if fsCtl and fsCtl.Boolean then
        -- Only one row can be FS at a time -- once found, this IS the row
        -- that determines Day Start, regardless of whether it goes on to
        -- satisfy the other two conditions, so there's no need to keep
        -- scanning the rest.
        local startCtl = Controls.NanoHost_Show_Start[i]
        local stCtl = Controls.NanoHost_Show_StartTime[i]
        if startCtl and startCtl.Boolean and stCtl and stCtl.String ~= "" then
          local epoch = parseStartTimeToEpoch(stCtl.String)
          if epoch and nowEpoch >= (epoch + offsetMin * 60) then
            active = true
          end
        end
        break
      end
    end
    Controls.NanoHost_DayStart.Boolean = active
    Controls.NanoHost_DayStart.Color = active and "green" or "dimgray"
    if active and not dayStartWasActive and Controls.NanoHost_DayStart_Trigger then
      -- Rising edge only -- one-shot pulse, not a level output. Boolean
      -- true then false shortly after, matching how Trigger-style buttons
      -- elsewhere in this file are driven (there's no separate ctl:Trigger()
      -- style method used anywhere in this codebase to model instead).
      Controls.NanoHost_DayStart_Trigger.Boolean = true
      if statusIsOK then logEvent("NanoHost", "Day Start triggered") end
      Timer.CallAfter(function()
        if Controls.NanoHost_DayStart_Trigger then Controls.NanoHost_DayStart_Trigger.Boolean = false end
      end, 0.2)
    end
    dayStartWasActive = active
  end

  -- ===== Day End =====
  -- Mirrors Day Start's scan/evaluate pattern, gated on the LE marker
  -- (Last Show End -- the eCNA's own report of which row is currently in
  -- that state) instead of FS, and comparing against StartTime + RunTime +
  -- offset rather than just StartTime + offset. True once Time of Day
  -- reaches (LE row's StartTime + RunTime + Day End Offset); goes false
  -- again once the eCNA itself drops the LE marker (which happens around
  -- 255:59 after ShowTime+RunTime -- the eCNA's own NANO_TIME_MAX ceiling
  -- -- not something this plugin times out on its own). Epoch-based
  -- arithmetic (not a naive time-of-day string compare) so the threshold
  -- correctly lands after midnight when StartTime + RunTime + Offset
  -- crosses into the next calendar day -- same technique as Day Start's
  -- own midnight-rollover case. Example: StartTime 22:00:00, RunTime 180
  -- (min), Offset 180 (min) -> Day End true and Trigger fires at 04:00:00
  -- the following day.
  local dayEndWasActive = false
  local function evaluateDayEnd()
    if not (Controls.NanoHost_DayEnd and Controls.NanoHost_DayEndOffset
        and Controls.NanoHost_Show_LE and Controls.NanoHost_Show_StartTime and Controls.NanoHost_Show_RunTime) then
      return
    end
    local offsetMin = Controls.NanoHost_DayEndOffset.Value or 0
    local nowEpoch = os.time()
    local active = false
    for i = 1, MAX_SHOWS do
      local leCtl = Controls.NanoHost_Show_LE[i]
      if leCtl and leCtl.Boolean then
        -- Only one row can be LE at a time -- once found, this IS the row
        -- that determines Day End, regardless of whether it goes on to
        -- satisfy the time condition, so there's no need to keep scanning.
        local stCtl = Controls.NanoHost_Show_StartTime[i]
        local rtCtl = Controls.NanoHost_Show_RunTime[i]
        if stCtl and stCtl.String ~= "" and rtCtl and rtCtl.String ~= "" then
          local epoch = parseStartTimeToEpoch(stCtl.String)
          local runMin = tonumber(rtCtl.String)
          if epoch and runMin and nowEpoch >= (epoch + runMin * 60 + offsetMin * 60) then
            active = true
          end
        end
        break
      end
    end
    Controls.NanoHost_DayEnd.Boolean = active
    Controls.NanoHost_DayEnd.Color = active and "green" or "dimgray"
    if active and not dayEndWasActive and Controls.NanoHost_DayEnd_Trigger then
      -- Rising edge only -- one-shot pulse, same convention as Day Start's
      -- trigger.
      Controls.NanoHost_DayEnd_Trigger.Boolean = true
      if statusIsOK then logEvent("NanoHost", "Day End triggered") end
      Timer.CallAfter(function()
        if Controls.NanoHost_DayEnd_Trigger then Controls.NanoHost_DayEnd_Trigger.Boolean = false end
      end, 0.2)
    end
    dayEndWasActive = active
  end

  -- ===== First Show End =====
  -- Has a state LED in addition to the Trigger, matching Day Start/Day
  -- End/Last Show Start. The Trigger fires exactly once per first-show
  -- cycle, on whichever of two conditions happens first:
  --   Condition 1: the FE row (First Show End marker) is true AND Time of
  --     Day has reached that row's StartTime + RunTime + Offset.
  --   Condition 2: FE itself transitions from true to false BEFORE
  --     Condition 1 has fired. FE stays true through the gap between the
  --     first and second shows (Time Between Features), only dropping once
  --     that gap times out -- i.e. around when the second show starts.
  --     Condition 2 is therefore a ceiling: if Offset is long enough that
  --     Condition 1's threshold hasn't been reached by the time FE
  --     actually drops, fire immediately rather than let a large Offset
  --     push the Trigger out past the second show's start.
  -- The state LED turns on with the same criteria as Condition 1, and
  -- turns off exactly when FE goes false -- the same moment the Time
  -- Before Feature Start counts to 0 for the next show. It is a LIVE
  -- recompute of Condition 1 every tick (`active = cond1`, i.e. feActive
  -- AND the StartTime+RunTime+Offset threshold currently reached) --
  -- deliberately NOT gated by fseTriggered, which is a one-shot latch that
  -- only clears on FE's rising edge. Gating the LED on the latch would let
  -- it stay true after Condition 1 fired under an earlier Offset value,
  -- even once the Offset is raised to a value whose threshold hasn't been
  -- reached yet -- recomputing live instead matches how Day Start/Day
  -- End/Last Show Start's own state LEDs already behave (pure levels, not
  -- latches) and lets the LED correctly flip back off if the Offset is
  -- raised past "now" after already going true. In the Condition-2 edge
  -- case (FE's drop IS what fires the Trigger), `cond1` requires feActive,
  -- which is already false
  -- at that same tick, so the LED still won't visibly light -- correct,
  -- since by then the next show has already started and there is no
  -- meaningful "on" window left to show. The Trigger still pulses once
  -- either way, via its own separate one-shot latch below.
  -- The "not fired twice" requirement is a one-shot latch (fseTriggered)
  -- that resets on FE's RISING edge -- i.e. the moment a new first show's
  -- scheduled window begins (today's, or tomorrow's) -- which is always
  -- well before either condition could fire for that new cycle.
  local fseTriggered = false  -- one-shot latch for the current FE cycle
  local fsePrevFE    = nil    -- previous tick's "is FE true anywhere" state, for edge-detecting FE in both directions
  local function evaluateFirstShowEnd()
    if not (Controls.NanoHost_FirstShowEnd and Controls.NanoHost_FirstShowEnd_Trigger and Controls.NanoHost_FirstShowEndOffset
        and Controls.NanoHost_Show_FE
        and Controls.NanoHost_Show_StartTime and Controls.NanoHost_Show_RunTime) then
      return
    end

    -- Locate the FE row, if any -- only one row can be FE at a time.
    local feActive, feRow = false, nil
    for i = 1, MAX_SHOWS do
      local feCtl = Controls.NanoHost_Show_FE[i]
      if feCtl and feCtl.Boolean then
        feActive, feRow = true, i
        break
      end
    end

    -- FE's rising edge -- a new first-show cycle has begun -- clear the
    -- latch so this cycle's End can fire.
    if fsePrevFE == false and feActive then
      fseTriggered = false
    end

    -- Condition 1: FE row's StartTime + RunTime + Offset reached while FE
    -- is still true.
    local cond1 = false
    if feActive then
      local offsetMin = Controls.NanoHost_FirstShowEndOffset.Value or 0
      local stCtl = Controls.NanoHost_Show_StartTime[feRow]
      local rtCtl = Controls.NanoHost_Show_RunTime[feRow]
      if stCtl and stCtl.String ~= "" and rtCtl and rtCtl.String ~= "" then
        local epoch = parseStartTimeToEpoch(stCtl.String)
        local runMin = tonumber(rtCtl.String)
        if epoch and runMin and os.time() >= (epoch + runMin * 60 + offsetMin * 60) then
          cond1 = true
        end
      end
    end

    -- Condition 2: FE was true, now false (edge), and Condition 1 has not
    -- yet fired -- the normal path whenever Offset is zero or positive.
    local cond2 = (fsePrevFE == true) and (not feActive) and not fseTriggered
    fsePrevFE = feActive

    if not fseTriggered and (cond1 or cond2) then
      fseTriggered = true
      Controls.NanoHost_FirstShowEnd_Trigger.Boolean = true
      if statusIsOK then logEvent("NanoHost", "First Show End triggered") end
      Timer.CallAfter(function()
        if Controls.NanoHost_FirstShowEnd_Trigger then Controls.NanoHost_FirstShowEnd_Trigger.Boolean = false end
      end, 0.2)
    end

    -- State LED: live recompute of Condition 1, NOT gated by fseTriggered
    -- -- see the header comment above for why.
    local active = cond1
    Controls.NanoHost_FirstShowEnd.Boolean = active
    Controls.NanoHost_FirstShowEnd.Color = active and "green" or "dimgray"
  end

  -- ===== Last Show Start =====
  -- Same shape as evaluateDayStart -- level-based, not a one-shot latch:
  -- it does not go false until LS goes false, so this simply recomputes
  -- the gate+threshold every tick, exactly like Day Start/Day End do.
  -- Gated on LS (Last Show Start marker) instead of FS, with no extra
  -- "currently airing" check -- only LS true AND StartTime+Offset true
  -- are required.
  local lastShowStartWasActive = false
  local function evaluateLastShowStart()
    if not (Controls.NanoHost_LastShowStart and Controls.NanoHost_LastShowStartOffset
        and Controls.NanoHost_Show_LS and Controls.NanoHost_Show_StartTime) then
      return
    end
    local offsetMin = Controls.NanoHost_LastShowStartOffset.Value or 0
    local nowEpoch = os.time()
    local active = false
    for i = 1, MAX_SHOWS do
      local lsCtl = Controls.NanoHost_Show_LS[i]
      if lsCtl and lsCtl.Boolean then
        -- Only one row can be LS at a time -- once found, this IS the row
        -- that determines Last Show Start, regardless of whether it goes
        -- on to satisfy the time condition, so there's no need to keep
        -- scanning the rest.
        local stCtl = Controls.NanoHost_Show_StartTime[i]
        if stCtl and stCtl.String ~= "" then
          local epoch = parseStartTimeToEpoch(stCtl.String)
          if epoch and nowEpoch >= (epoch + offsetMin * 60) then
            active = true
          end
        end
        break
      end
    end
    Controls.NanoHost_LastShowStart.Boolean = active
    Controls.NanoHost_LastShowStart.Color = active and "green" or "dimgray"
    if active and not lastShowStartWasActive and Controls.NanoHost_LastShowStart_Trigger then
      -- Rising edge only -- one-shot pulse, same convention as Day
      -- Start/Day End's own triggers.
      Controls.NanoHost_LastShowStart_Trigger.Boolean = true
      if statusIsOK then logEvent("NanoHost", "Last Show Start triggered") end
      Timer.CallAfter(function()
        if Controls.NanoHost_LastShowStart_Trigger then Controls.NanoHost_LastShowStart_Trigger.Boolean = false end
      end, 0.2)
    end
    lastShowStartWasActive = active
  end

  -- Day Start offset control wiring. Structure
  -- (fader+text mirror, momentary bump buttons with hold-to-repeat)
  -- deliberately mirrors the proven Zone_Offset/_Text/_Inc/_Dec pattern
  -- above, minus everything specific to that pattern's actual purpose
  -- (network debounce/commit to the eCNA, offset-masking during an
  -- in-flight command, animated channel-meter preview) -- there's nothing
  -- external to send here; changing this offset only changes a local
  -- Q-SYS-side comparison, so evaluateDayStart() just gets called directly
  -- and immediately on every change.
  if ENABLE_NANOHOST then
    if Controls.NanoHost_DayStartOffset then
      Controls.NanoHost_DayStartOffset.EventHandler = function()
        local v = math.floor(Controls.NanoHost_DayStartOffset.Value + 0.5)
        if Controls.NanoHost_DayStartOffset_Text then Controls.NanoHost_DayStartOffset_Text.String = tostring(v) end
        evaluateDayStart()
      end
    end

    if Controls.NanoHost_DayStartOffset_Text then
      Controls.NanoHost_DayStartOffset_Text.EventHandler = function()
        local v = tonumber(Controls.NanoHost_DayStartOffset_Text.String)
        if v then
          v = math.floor(v + 0.5)
          if     v < -180 then v = -180
          elseif v > 60   then v = 60 end
          Controls.NanoHost_DayStartOffset.Value = v
          Controls.NanoHost_DayStartOffset_Text.String = tostring(v)
          evaluateDayStart()
        else
          Controls.NanoHost_DayStartOffset_Text.String = tostring(math.floor((Controls.NanoHost_DayStartOffset.Value or 0) + 0.5))  -- reject non-numeric entry, restore last known value
        end
      end
    end

    -- Hold-to-repeat bump buttons -- same generation-counter/fresh-Timer
    -- pattern as Zone_Offset_Inc/_Dec above (see that block's comments for
    -- why: guards against a stale scheduled callback surviving past
    -- release or a fresh re-press). Rate: 4 minutes/second while held past
    -- the 2-second threshold -- 2 minutes per 0.5s repeat tick.
    local DS_HOLD_DELAY  = 2.0
    local DS_HOLD_REPEAT = 0.5
    local DS_HOLD_STEP   = 2  -- minutes per repeat tick -> 2/0.5s = 4 min/s
    local dsStepTimer = {}
    local dsStepGen   = {}

    local function dsStepOffset(delta)
      local ctl = Controls.NanoHost_DayStartOffset
      if not ctl then return end
      local cur = math.floor((ctl.Value or 0) + 0.5)
      local v = cur + delta
      if v < -180 then v = -180 elseif v > 60 then v = 60 end
      if v == cur then return end
      ctl.Value = v
      if Controls.NanoHost_DayStartOffset_Text then Controls.NanoHost_DayStartOffset_Text.String = tostring(v) end
      evaluateDayStart()
    end

    local function dsStartHold(dir, initialDelta, repeatDelta)
      dsStepGen[dir] = (dsStepGen[dir] or 0) + 1
      local myGen = dsStepGen[dir]
      local t = Timer.New()  -- always fresh -- see Zone_Offset's identical comment above
      dsStepTimer[dir] = t
      dsStepOffset(initialDelta)  -- immediate single-step on press
      t.EventHandler = function()
        if dsStepGen[dir] ~= myGen then return end  -- released (or re-pressed) since scheduled -- stale
        dsStepOffset(repeatDelta)
        t:Start(DS_HOLD_REPEAT)
      end
      t:Start(DS_HOLD_DELAY)
    end

    local function dsStopHold(dir)
      dsStepGen[dir] = (dsStepGen[dir] or 0) + 1  -- invalidates any pending timer callback
      if dsStepTimer[dir] then dsStepTimer[dir]:Stop() end
    end

    if Controls.NanoHost_DayStartOffset_Inc then
      local ctl = Controls.NanoHost_DayStartOffset_Inc
      ctl.EventHandler = function()
        if ctl.Boolean then dsStartHold("inc", 1, DS_HOLD_STEP) else dsStopHold("inc") end
      end
    end
    if Controls.NanoHost_DayStartOffset_Dec then
      local ctl = Controls.NanoHost_DayStartOffset_Dec
      ctl.EventHandler = function()
        if ctl.Boolean then dsStartHold("dec", -1, -DS_HOLD_STEP) else dsStopHold("dec") end
      end
    end
  end

  -- Day End offset control wiring -- identical structure to Day Start's
  -- above (fader+text mirror, momentary bump buttons with hold-to-repeat),
  -- same reasoning: nothing external to send, so evaluateDayEnd() just runs
  -- directly and immediately on every change.
  if ENABLE_NANOHOST then
    if Controls.NanoHost_DayEndOffset then
      Controls.NanoHost_DayEndOffset.EventHandler = function()
        local v = math.floor(Controls.NanoHost_DayEndOffset.Value + 0.5)
        if Controls.NanoHost_DayEndOffset_Text then Controls.NanoHost_DayEndOffset_Text.String = tostring(v) end
        evaluateDayEnd()
      end
    end

    if Controls.NanoHost_DayEndOffset_Text then
      Controls.NanoHost_DayEndOffset_Text.EventHandler = function()
        local v = tonumber(Controls.NanoHost_DayEndOffset_Text.String)
        if v then
          v = math.floor(v + 0.5)
          if     v < -60  then v = -60
          elseif v > 240  then v = 240 end
          Controls.NanoHost_DayEndOffset.Value = v
          Controls.NanoHost_DayEndOffset_Text.String = tostring(v)
          evaluateDayEnd()
        else
          Controls.NanoHost_DayEndOffset_Text.String = tostring(math.floor((Controls.NanoHost_DayEndOffset.Value or 0) + 0.5))  -- reject non-numeric entry, restore last known value
        end
      end
    end

    -- Hold-to-repeat bump buttons -- same generation-counter/fresh-Timer
    -- pattern as Day Start's dsStepOffset/dsStartHold/dsStopHold above.
    -- Same rate: 4 minutes/second while held past the 2-second threshold.
    local DE_HOLD_DELAY  = 2.0
    local DE_HOLD_REPEAT = 0.5
    local DE_HOLD_STEP   = 2  -- minutes per repeat tick -> 2/0.5s = 4 min/s
    local deStepTimer = {}
    local deStepGen   = {}

    local function deStepOffset(delta)
      local ctl = Controls.NanoHost_DayEndOffset
      if not ctl then return end
      local cur = math.floor((ctl.Value or 0) + 0.5)
      local v = cur + delta
      if v < -60 then v = -60 elseif v > 240 then v = 240 end
      if v == cur then return end
      ctl.Value = v
      if Controls.NanoHost_DayEndOffset_Text then Controls.NanoHost_DayEndOffset_Text.String = tostring(v) end
      evaluateDayEnd()
    end

    local function deStartHold(dir, initialDelta, repeatDelta)
      deStepGen[dir] = (deStepGen[dir] or 0) + 1
      local myGen = deStepGen[dir]
      local t = Timer.New()  -- always fresh -- see Zone_Offset's identical comment above
      deStepTimer[dir] = t
      deStepOffset(initialDelta)  -- immediate single-step on press
      t.EventHandler = function()
        if deStepGen[dir] ~= myGen then return end  -- released (or re-pressed) since scheduled -- stale
        deStepOffset(repeatDelta)
        t:Start(DE_HOLD_REPEAT)
      end
      t:Start(DE_HOLD_DELAY)
    end

    local function deStopHold(dir)
      deStepGen[dir] = (deStepGen[dir] or 0) + 1  -- invalidates any pending timer callback
      if deStepTimer[dir] then deStepTimer[dir]:Stop() end
    end

    if Controls.NanoHost_DayEndOffset_Inc then
      local ctl = Controls.NanoHost_DayEndOffset_Inc
      ctl.EventHandler = function()
        if ctl.Boolean then deStartHold("inc", 1, DE_HOLD_STEP) else deStopHold("inc") end
      end
    end
    if Controls.NanoHost_DayEndOffset_Dec then
      local ctl = Controls.NanoHost_DayEndOffset_Dec
      ctl.EventHandler = function()
        if ctl.Boolean then deStartHold("dec", -1, -DE_HOLD_STEP) else deStopHold("dec") end
      end
    end
  end

  -- First Show End offset control wiring -- identical structure to Day
  -- Start/Day End's above. Re-running evaluateFirstShowEnd() on every
  -- change is harmless even after the one-shot latch has fired: it will
  -- simply find fseTriggered already true and do nothing.
  if ENABLE_NANOHOST then
    if Controls.NanoHost_FirstShowEndOffset then
      Controls.NanoHost_FirstShowEndOffset.EventHandler = function()
        local v = math.floor(Controls.NanoHost_FirstShowEndOffset.Value + 0.5)
        if Controls.NanoHost_FirstShowEndOffset_Text then Controls.NanoHost_FirstShowEndOffset_Text.String = tostring(v) end
        evaluateFirstShowEnd()
      end
    end

    if Controls.NanoHost_FirstShowEndOffset_Text then
      Controls.NanoHost_FirstShowEndOffset_Text.EventHandler = function()
        local v = tonumber(Controls.NanoHost_FirstShowEndOffset_Text.String)
        if v then
          v = math.floor(v + 0.5)
          if     v < -60 then v = -60
          elseif v > 60  then v = 60 end
          Controls.NanoHost_FirstShowEndOffset.Value = v
          Controls.NanoHost_FirstShowEndOffset_Text.String = tostring(v)
          evaluateFirstShowEnd()
        else
          Controls.NanoHost_FirstShowEndOffset_Text.String = tostring(math.floor((Controls.NanoHost_FirstShowEndOffset.Value or 0) + 0.5))  -- reject non-numeric entry, restore last known value
        end
      end
    end

    -- Hold-to-repeat bump buttons -- same generation-counter/fresh-Timer
    -- pattern as Day Start/Day End above. Same rate: 4 minutes/second while
    -- held past the 2-second threshold.
    local FSE_HOLD_DELAY  = 2.0
    local FSE_HOLD_REPEAT = 0.5
    local FSE_HOLD_STEP   = 2  -- minutes per repeat tick -> 2/0.5s = 4 min/s
    local fseStepTimer = {}
    local fseStepGen   = {}

    local function fseStepOffset(delta)
      local ctl = Controls.NanoHost_FirstShowEndOffset
      if not ctl then return end
      local cur = math.floor((ctl.Value or 0) + 0.5)
      local v = cur + delta
      if v < -60 then v = -60 elseif v > 60 then v = 60 end
      if v == cur then return end
      ctl.Value = v
      if Controls.NanoHost_FirstShowEndOffset_Text then Controls.NanoHost_FirstShowEndOffset_Text.String = tostring(v) end
      evaluateFirstShowEnd()
    end

    local function fseStartHold(dir, initialDelta, repeatDelta)
      fseStepGen[dir] = (fseStepGen[dir] or 0) + 1
      local myGen = fseStepGen[dir]
      local t = Timer.New()  -- always fresh -- see Zone_Offset's identical comment above
      fseStepTimer[dir] = t
      fseStepOffset(initialDelta)  -- immediate single-step on press
      t.EventHandler = function()
        if fseStepGen[dir] ~= myGen then return end  -- released (or re-pressed) since scheduled -- stale
        fseStepOffset(repeatDelta)
        t:Start(FSE_HOLD_REPEAT)
      end
      t:Start(FSE_HOLD_DELAY)
    end

    local function fseStopHold(dir)
      fseStepGen[dir] = (fseStepGen[dir] or 0) + 1  -- invalidates any pending timer callback
      if fseStepTimer[dir] then fseStepTimer[dir]:Stop() end
    end

    if Controls.NanoHost_FirstShowEndOffset_Inc then
      local ctl = Controls.NanoHost_FirstShowEndOffset_Inc
      ctl.EventHandler = function()
        if ctl.Boolean then fseStartHold("inc", 1, FSE_HOLD_STEP) else fseStopHold("inc") end
      end
    end
    if Controls.NanoHost_FirstShowEndOffset_Dec then
      local ctl = Controls.NanoHost_FirstShowEndOffset_Dec
      ctl.EventHandler = function()
        if ctl.Boolean then fseStartHold("dec", -1, -FSE_HOLD_STEP) else fseStopHold("dec") end
      end
    end
  end

  -- Last Show Start offset control wiring -- identical structure to Day
  -- Start/Day End/First Show End above.
  if ENABLE_NANOHOST then
    if Controls.NanoHost_LastShowStartOffset then
      Controls.NanoHost_LastShowStartOffset.EventHandler = function()
        local v = math.floor(Controls.NanoHost_LastShowStartOffset.Value + 0.5)
        if Controls.NanoHost_LastShowStartOffset_Text then Controls.NanoHost_LastShowStartOffset_Text.String = tostring(v) end
        evaluateLastShowStart()
      end
    end

    if Controls.NanoHost_LastShowStartOffset_Text then
      Controls.NanoHost_LastShowStartOffset_Text.EventHandler = function()
        local v = tonumber(Controls.NanoHost_LastShowStartOffset_Text.String)
        if v then
          v = math.floor(v + 0.5)
          if     v < -90 then v = -90
          elseif v > 60  then v = 60 end
          Controls.NanoHost_LastShowStartOffset.Value = v
          Controls.NanoHost_LastShowStartOffset_Text.String = tostring(v)
          evaluateLastShowStart()
        else
          Controls.NanoHost_LastShowStartOffset_Text.String = tostring(math.floor((Controls.NanoHost_LastShowStartOffset.Value or 0) + 0.5))  -- reject non-numeric entry, restore last known value
        end
      end
    end

    -- Hold-to-repeat bump buttons -- same generation-counter/fresh-Timer
    -- pattern as Day Start/Day End/First Show End above. Same rate: 4
    -- minutes/second while held past the 2-second threshold.
    local LSS_HOLD_DELAY  = 2.0
    local LSS_HOLD_REPEAT = 0.5
    local LSS_HOLD_STEP   = 2  -- minutes per repeat tick -> 2/0.5s = 4 min/s
    local lssStepTimer = {}
    local lssStepGen   = {}

    local function lssStepOffset(delta)
      local ctl = Controls.NanoHost_LastShowStartOffset
      if not ctl then return end
      local cur = math.floor((ctl.Value or 0) + 0.5)
      local v = cur + delta
      if v < -90 then v = -90 elseif v > 60 then v = 60 end
      if v == cur then return end
      ctl.Value = v
      if Controls.NanoHost_LastShowStartOffset_Text then Controls.NanoHost_LastShowStartOffset_Text.String = tostring(v) end
      evaluateLastShowStart()
    end

    local function lssStartHold(dir, initialDelta, repeatDelta)
      lssStepGen[dir] = (lssStepGen[dir] or 0) + 1
      local myGen = lssStepGen[dir]
      local t = Timer.New()  -- always fresh -- see Zone_Offset's identical comment above
      lssStepTimer[dir] = t
      lssStepOffset(initialDelta)  -- immediate single-step on press
      t.EventHandler = function()
        if lssStepGen[dir] ~= myGen then return end  -- released (or re-pressed) since scheduled -- stale
        lssStepOffset(repeatDelta)
        t:Start(LSS_HOLD_REPEAT)
      end
      t:Start(LSS_HOLD_DELAY)
    end

    local function lssStopHold(dir)
      lssStepGen[dir] = (lssStepGen[dir] or 0) + 1  -- invalidates any pending timer callback
      if lssStepTimer[dir] then lssStepTimer[dir]:Stop() end
    end

    if Controls.NanoHost_LastShowStartOffset_Inc then
      local ctl = Controls.NanoHost_LastShowStartOffset_Inc
      ctl.EventHandler = function()
        if ctl.Boolean then lssStartHold("inc", 1, LSS_HOLD_STEP) else lssStopHold("inc") end
      end
    end
    if Controls.NanoHost_LastShowStartOffset_Dec then
      local ctl = Controls.NanoHost_LastShowStartOffset_Dec
      ctl.EventHandler = function()
        if ctl.Boolean then lssStartHold("dec", -1, -LSS_HOLD_STEP) else lssStopHold("dec") end
      end
    end
  end

  local function checkFullyPopulated()
    if statusIsOK then return end
    if not (populated.rid and populated.rst and populated.inNames
        and populated.outNames and populated.scrape) then return end
    if ENABLE_QDC and not (populated.dimmerSetup and populated.linScan and populated.lightPoll) then
      return
    end
    if ENABLE_NANOHOST and not populated.nanoHost then
      return
    end
    statusIsOK = true
    setStatus(STATUS_OK, "OK")
  end
  -- nanoHost gates Status=OK when enabled, for consistency with the QDC
  -- precedent (dimmerSetup/linScan/lightPoll) above -- better to wait a
  -- bit longer at "Initializing" than have "OK" appear before everything
  -- on screen actually reflects a real response. `populated.nanoHost` is
  -- set true on the FIRST response from
  -- the eCNA's nanoHost endpoint of any kind -- <UpToDate/>, HostUp=false,
  -- or a full dataset -- exactly parallel to how the QDC flags only
  -- require a response having landed, not that hardware is necessarily
  -- present. In practice this does NOT add the full NANO_POLL_RATE (120s)
  -- to connect time: /rtmandata.xml is already fetched in the same
  -- immediate on-connect bootstrap burst as the input/output names and QDC
  -- setup fetches (see the "get the nanoHost's initial conditions in the
  -- same bootstrap burst" comment above, near nameQueue), not on the slow
  -- routine poll cadence -- so this only adds the few seconds that fetch
  -- itself takes, same as every other startup fetch. `checkFullyPopulated()`
  -- is called after each of the three `populated.nanoHost = true` sites in
  -- `parseNanoHost` below so Status actually flips the moment that first
  -- response lands.

  -- CAI (RID/RST) and HTTP (names, dimmer setup, LIN scan, scrape, light
  -- poll) are independent channels/sockets, tracked separately -- a hiccup
  -- on one doesn't mean the other's already-fresh data is now suspect. An
  -- eCNA still finishing its own boot can reject the first couple of CAI
  -- sessions with "Resource Unavailable" while its HTTP interface is
  -- already up and successfully answering; wiping HTTP-side progress on
  -- every CAI retry would force the full Setup.xml/rtLin.xml sequence to
  -- restart from scratch each time, pushing "OK" out by tens of seconds
  -- even though the unit had been responding the whole time. So a CAI-only
  -- reconnect (button, IP unchanged, automatic retry) only re-earns the
  -- CAI side; HTTP-side freshness only resets on an actual target change
  -- (resetForNewTarget, i.e. IP_ADDRESS changed -- see below), since
  -- that's the only event that actually invalidates previously-fetched
  -- HTTP data. "OK" still requires every source fresh from ITS OWN
  -- channel's most recent (re)connection -- this only changes which
  -- events count as invalidating which half.
  local function resetCaiPopulationTracking()
    populated.rid = false; populated.rst = false
    statusIsOK = false
  end
  local function resetHttpPopulationTracking()
    populated.inNames = false; populated.outNames = false
    populated.dimmerSetup = false; populated.linScan = false
    populated.scrape = false; populated.lightPoll = false
    populated.nanoHost = false  -- v1.3
    statusIsOK = false
  end
  -- Full reset (both channels) -- used by resetForNewTarget() where the
  -- physical device itself may be entirely different.
  local function resetPopulationTracking()
    resetCaiPopulationTracking()
    resetHttpPopulationTracking()
  end

  -- Three-tier trust model for the 4 Digital Projector buttons
  -- (Dig1_Power/Dig1_Video/Dig2_Power/Dig2_Video).
  -- DP1ON/DP1OFF/DV1ON/DV1OFF/DP2ON/DP2OFF/DV2ON/DV2OFF are the only output
  -- changes with a dedicated unsolicited RPT,EVT code (confirmed against
  -- the manual's full event list -- Slide/Aux Projector has none, so it
  -- stays scrape-only, untouched by all of this).
  --
  --   Tier 1 (fastest): the unsolicited RPT,EVT notification itself sets
  --   the button immediately, at face value -- see parseRPTEVT. No round
  --   trip at all; the event is the eCNA telling us what already happened.
  --
  --   Tier 2 (first backstop): parseRPTEVT already triggers a reactive RST
  --   re-poll ~0.2s after the event; its response's D1P/D1V/D2P/D2V output-
  --   status fields (previously discarded entirely) now also set these 4
  --   buttons directly -- see parseStatusRecord below -- confirming/
  --   correcting Tier 1's guess almost immediately.
  --
  --   Tier 3 (second backstop): scrape is allowed to "fix" a DV status
  --   once two consecutive scrapes differ from what our state is showing.
  --   dpMismatch[1..4] tracks a per-button
  --   streak of consecutive scrapes that disagree with the current value;
  --   a single differing scrape is treated as a possible stale/
  --   transitional read and ignored, but two in a row overrides (see
  --   scrape() below). Both Tier 1 and Tier 2 reset the relevant counter to
  --   0, since a fresh assertion makes any prior streak against the OLD
  --   value no longer meaningful.
  --
  -- Declared here (not down near scrape() where it's also used) because
  -- parseStatusRecord is defined earlier in the file and references it as
  -- an upvalue -- same rule as channelAnimating/channelPendingUnmask above.
  local dpMismatch = {0, 0, 0, 0}  -- [1]=Dig1_Power [2]=Dig1_Video [3]=Dig2_Power [4]=Dig2_Video

  -- ── RST Response Parser ─────────────────────────────────────
  -- Parses the RSP,RST response which contains full device state
  local function parseStatusRecord(fields)
    if #fields < 6 or fields[4] ~= "0" then
      if fields[4] and fields[4] ~= "0" then
        dbg("RST error: " .. fields[4])
      end
      return
    end
    local f = fields
    Controls.Control_State.String    = f[6]  or ""
    -- Event Log (Program category, major transitions only): Control State
    -- (IDL/RUN) and Stopped State, with Stopped State reaching FLT logged
    -- as an error (per Log_Enable_Program's scope) and any other value,
    -- including FLT clearing, as an informational message.
    logChanged(programBaseline, "Control_State", f[6] or "", "Program", function(old, new)
      return "Control State changed to " .. new
    end)
    Controls.Stopped_State.String    = f[7]  or ""
    logChanged(programBaseline, "Stopped_State", f[7] or "", "Program", function(old, new)
      return "Stopped State changed to " .. new .. (new == "FLT" and " (Fault)" or "")
    end, f[7] == "FLT")
    Controls.Cue_Number.String       = f[8]  or ""
    -- RST's own Digital Projector Power/Video OUTPUT STATUS
    -- fields (codes 6/8/10/12 of the status record -- the "actual" state,
    -- not the "desired" control-flag field right before each) -- comma
    -- positions f[10]/f[12]/f[14]/f[16]. Guarded on record length since
    -- these sit well past the minimum-6 check above. Any RST response
    -- (periodic, reactive, or the one-time post-connect poll) authoritatively
    -- sets these 4 -- see scrape() for the mismatch-correction backstop.
    if #f >= 16 then
      setBoolLogged(Controls.Dig1_Power, "Dig1_Power", "Dig Proj1 Power", (f[10] == "D1P"))
      setBoolLogged(Controls.Dig1_Video, "Dig1_Video", "Dig Proj1 Video", (f[12] == "D1V"))
      setBoolLogged(Controls.Dig2_Power, "Dig2_Power", "Dig Proj2 Power", (f[14] == "D2P"))
      setBoolLogged(Controls.Dig2_Video, "Dig2_Video", "Dig Proj2 Video", (f[16] == "D2V"))
      dpMismatch[1] = 0; dpMismatch[2] = 0; dpMismatch[3] = 0; dpMismatch[4] = 0
    end
    -- Note: Aux_Projector (Slide Projector, "SLD" on this hardware rather
    -- than the manual's documented "AUX") has no unsolicited RPT,EVT of its
    -- own, so RST offers no faster path for it than scrape -- it stays
    -- scrape-only (flag 19), unaffected by this change.
    -- Program/segment info
    Controls.Segment_Index.String    = f[29] or ""
    Controls.Segment_Name.String     = f[30] or ""
    -- Event Log (Program category): index and name are logged as one
    -- combined entry, keyed on both together, since a real segment change
    -- moves them in the same poll -- avoids two separate entries for what
    -- is a single event.
    logChanged(programBaseline, "Segment", (f[29] or "").."|"..(f[30] or ""), "Program", function(old, new)
      return "Segment changed to " .. (f[30] or "") .. " (index " .. (f[29] or "") .. ")"
    end)
    Controls.CAI_CMD_Access.String   = f[31] or ""
    Controls.Program_Number.String   = f[32] or ""
    logChanged(programBaseline, "Program_Number", f[32] or "", "Program", function(old, new)
      return "Program Number changed to " .. new
    end)
    populated.rst = true
    -- Real data received (v1.4.0.18) -- proof of life. Only actually a
    -- transition when we were logged as Disconnected; guarded explicitly
    -- (not left to logConnTransition's own dedup) because every routine RST
    -- poll response during normal OK operation also reaches this line, and
    -- "OK" ~= "Initializing" would otherwise look like a real transition
    -- backward every single poll.
    if connLogState == "Disconnected" then
      logConnTransition("Initializing")
    end
    checkFullyPopulated()
    dbg("RST: state=" .. (f[6] or "") .. " seg=" .. (f[30] or ""))
  end

  -- ── RID Response Parser ─────────────────────────────────────
  -- Parses the RSP,RID response containing model, firmware version, and
  -- Screen Id. Manual confirms all three are the record's three
  -- codes in this exact order (code1=Device Name, code2=Software Version,
  -- code3=Screen Id) -- e.g. "RSP,RID,0,0,eCNA-10,1007,27,1630" has Screen
  -- Id "27" as field 7. The existing `#fields < 7` guard already ensures
  -- field 7 is present whenever this function actually processes a
  -- response, so no additional length check is needed for Screen Id.
  local function parseRID(fields)
    if #fields < 7 or fields[4] ~= "0" then return end
    Controls.Model.String = fields[5] or ""
    local ver = tonumber(fields[6])
    Controls.Firmware_Version.String = ver and string.format("%.3f", ver/1000) or (fields[6] or "")
    Controls.Screen_Id.String = fields[7] or ""
    populated.rid = true
    -- A successful RID is direct proof the eCNA accepted this CAI session --
    -- whatever caused any prior Resource Unavailable rejections is resolved,
    -- so a future disconnect should start backoff fresh rather than
    -- inheriting an inflated delay from this now-resolved episode.
    reconnectBackoffIdx = 1
    -- Real data received (v1.4.0.18) -- same guard/reasoning as parseRID's
    -- RST-side counterpart above.
    if connLogState == "Disconnected" then
      logConnTransition("Initializing")
    end
    checkFullyPopulated()
    dbg("RID: model=" .. (fields[5] or "") .. " fw=" .. (fields[6] or "") .. " screen=" .. (fields[7] or ""))
  end

  -- ── Unsolicited Event Parser ────────────────────────────────
  -- Handles RPT,EVT messages sent by the eCNA without being polled
  -- Re-polls RST on state-changing events for immediate UI update
  --
  -- For the 4 Digital Projector buttons, trust the unsolicited event
  -- itself at face value the instant it arrives. This is as fast as it
  -- gets: no round trip at all, since the event is
  -- the eCNA telling us what already happened. The reactive RST re-poll
  -- below still fires exactly as before and is now the FIRST backstop
  -- (confirms/corrects within ~0.2-0.4s if the event turns out to have been
  -- stale or superseded); scrape's existing 2-consecutive-mismatch rule
  -- (see scrape()) remains the SECOND backstop. Resetting dpMismatch here
  -- too, same as parseStatusRecord -- a fresh face-value assertion is a new
  -- baseline, so any prior scrape-disagreement streak against the OLD value
  -- is no longer meaningful.
  local function parseRPTEVT(fields)
    local evt = fields[4] or ""
    dbg("RPT EVT: " .. evt)
    if     evt == "DP1ON"  then setBoolLogged(Controls.Dig1_Power, "Dig1_Power", "Dig Proj1 Power", true);  dpMismatch[1] = 0
    elseif evt == "DP1OFF" then setBoolLogged(Controls.Dig1_Power, "Dig1_Power", "Dig Proj1 Power", false); dpMismatch[1] = 0
    elseif evt == "DV1ON"  then setBoolLogged(Controls.Dig1_Video, "Dig1_Video", "Dig Proj1 Video", true);  dpMismatch[2] = 0
    elseif evt == "DV1OFF" then setBoolLogged(Controls.Dig1_Video, "Dig1_Video", "Dig Proj1 Video", false); dpMismatch[2] = 0
    elseif evt == "DP2ON"  then setBoolLogged(Controls.Dig2_Power, "Dig2_Power", "Dig Proj2 Power", true);  dpMismatch[3] = 0
    elseif evt == "DP2OFF" then setBoolLogged(Controls.Dig2_Power, "Dig2_Power", "Dig Proj2 Power", false); dpMismatch[3] = 0
    elseif evt == "DV2ON"  then setBoolLogged(Controls.Dig2_Video, "Dig2_Video", "Dig Proj2 Video", true);  dpMismatch[4] = 0
    elseif evt == "DV2OFF" then setBoolLogged(Controls.Dig2_Video, "Dig2_Video", "Dig Proj2 Video", false); dpMismatch[4] = 0
    end
    if evt=="START" or evt=="IDLE"    or evt=="ALLSTOP"
    or evt=="DP1ON" or evt=="DP1OFF"  or evt=="DV1ON"  or evt=="DV1OFF"
    or evt=="DP2ON" or evt=="DP2OFF"  or evt=="DV2ON"  or evt=="DV2OFF"
    or evt=="CUE"   or evt=="FIRESTOP" then
      Timer.CallAfter(function() sendCmd("RST,"..nextPSN()) end, 0.2)
    end
  end

  -- ── Incoming Line Processor ─────────────────────────────────
  -- Routes each complete CAI response line to the appropriate parser
  local function processLine(line)
    line = line:gsub("[\r\n]","")
    if #line == 0 then return end
    dbg("RX: " .. line)
    local f = split(line, ",")
    if #f < 2 then return end
    if f[1] == "RSP" then
      if     f[2] == "RST" or f[2] == "XST" then parseStatusRecord(f)
      elseif f[2] == "RID"                   then parseRID(f)
      elseif f[2] == "ERR"                   then
        dbg("ERR: " .. line)
        -- Code 998 (Resource Unavailable) is the eCNA explicitly rejecting
        -- this CAI session -- see reconnectBackoffIdx's comment. Flagged
        -- here; consumed by the socket's Closed/Error handler, which
        -- follows within milliseconds per the observed logs.
        if f[4] == "998" then lastErrWasResourceUnavailable = true end
        -- Event Log (Program category): a CAI-level error response. Gated
        -- directly on statusIsOK (not logChanged/a baseline) since each ERR
        -- is its own one-shot event, not a persisting state to compare
        -- against -- consistent with "no logging before OK except
        -- Connection" all the same.
        if statusIsOK then logEvent("Program", "CAI error: " .. line, true) end
      end
    elseif f[1] == "RPT" and f[2] == "EVT" then
      parseRPTEVT(f)
    end
  end

  -- Ping-gated reconnect (v1.4.0.20, ported from the EXPERIMENTAL_ConnectDiag
  -- diagnostic build -- see Enable_Ping_Gate's Properties comment for the
  -- full rationale/history). Once a real disconnect is declared, pause ALL
  -- CAI reconnect and HTTP traffic and instead watch for the eCNA
  -- answering plain ICMP echo requests, which it keeps doing even while
  -- CAI/HTTP are stalled during its own boot window. Only once ping stays
  -- up continuously for Ping_Stable_Window seconds do we resume the real
  -- CAI reconnect and HTTP scrape -- any dropped ping during that window
  -- resets the stability clock back to zero rather than carrying over
  -- partial credit. Packed as one table local (obj/timer/bootTimer/
  -- preCheckWatchdog/active/counting/isBootWait/enabled/stableWindow as
  -- table fields, not separate top-level locals) -- this file sits right
  -- at Lua's 200-local-per-function ceiling (confirmed the hard way: two
  -- more top-level locals for the enable flag and window size pushed it
  -- over, "too many local variables" at parse time), so `enabled` and
  -- `stableWindow` are read from Properties directly into table fields
  -- here instead of their own top-level locals.
  --
  -- MUST be declared here, before sock.EventHandler -- that handler's real-
  -- fault branch is what calls PingGate.start(), and Lua's lexical scoping
  -- only lets a nested function capture a local as an upvalue if that
  -- local's `local` declaration is textually earlier in an enclosing
  -- scope. scrapeTimer has the same constraint (PingGate's stability-
  -- window resolution calls scrapeTimer:Start()), which is why its `local`
  -- declaration was moved up near httpSock's forward declaration, with the
  -- Timer.New() assignment left in place down in the httpSock section --
  -- same forward-declare-then-assign pattern used for httpSock itself.
  -- reconnectTmr does NOT need this treatment: it's already declared well
  -- above (before this point), so PingGate.timer.EventHandler calling
  -- reconnectTmr:Start() is a normal, already-in-scope upvalue reference.
  local PingGate = {
    -- `== nil` (not `and/or`) because the default is true -- Lua's
    -- `and/or` idiom breaks for a true default.
    enabled      = (Properties["Enable_Ping_Gate"] == nil) or Properties["Enable_Ping_Gate"].Value,
    stableWindow = tonumber(Properties["Ping_Stable_Window"] and Properties["Ping_Stable_Window"].Value) or 20,
    obj        = nil,          -- Ping object; (re)created fresh each time .start() runs, since the target IP may have changed since the last gate
    timer      = Timer.New(),  -- counts the grace-period seconds once pings are landing
    bootTimer  = Timer.New(),  -- fires the ORIGINAL script-start bootstrap sequence (pollTimer/scrapeTimer/connect()/httpSock:Connect()) once it's actually safe to talk -- EventHandler assigned down in its natural bootstrap location, near the bottom of the file, since it needs pollTimer/scrapeTimer/connect/httpSock all in scope
    preCheckWatchdog = Timer.New(),  -- safety net for the boot-time single-shot ping pre-check (see the `do...end` block near the bottom of the file) -- if the Q-SYS Ping object fails to invoke EITHER its EventHandler or ErrorHandler within a few seconds, this forces the gate into its normal fail-cautious watch instead so a flaky single-shot ping can't hang the whole plugin forever with zero traffic
    active     = false,        -- true from .start() until .stop()/resolution; gates connect()'s and httpRequest()'s fault-path reconnect scheduling
    counting   = false,        -- true once at least one successful ping has landed and the grace-period timer is running
    isBootWait = false,        -- true when THIS gate run is the boot-time gate (script start, nothing has ever connected yet) rather than a post-fault reconnect gate -- changes what resolution actually does (fire bootTimer vs. resume reconnectTmr/scrapeTimer) and whether Status/Event Log reflect the wait (see .start()'s own comment)
  }
  PingGate.stop = function()
    if PingGate.obj then PingGate.obj:stop() end
    PingGate.timer:Stop()
    PingGate.active     = false
    PingGate.counting   = false
    PingGate.isBootWait = false
  end
  PingGate.timer.EventHandler = function()
    dbg("Ping gate: eCNA stable on ICMP for " .. PingGate.stableWindow .. "s -- resuming " .. (PingGate.isBootWait and "initial connect" or "normal reconnect"))
    local wasBootWait = PingGate.isBootWait
    PingGate.stop()
    if wasBootWait then
      PingGate.bootTimer:Start(0.1)   -- runs the deferred script-start bootstrap sequence
    else
      reconnectTmr:Start(0.1)  -- resumes the normal connect(true) path -- CAI always resumes immediately, same as the boot case
      scrapeTimer:Start(SCRAPE_RATE)  -- resumes HTTP scrape, paused for the duration of the gate
    end
  end
  -- Returns true if a gate is (now, or already) active -- caller should NOT
  -- also schedule a normal reconnectTmr retry (or, for the boot case, the
  -- normal bootstrap sequence) in that case. Returns false (feature off, or
  -- no valid IP to ping) so the caller falls back to proceeding immediately
  -- instead of stranding the plugin with nothing watching for recovery at
  -- all. `isBoot`, when true, marks this as the boot-time gate -- see the
  -- boot-time ping gate at the bottom of the file for why that path exists
  -- and how it differs from a post-fault reconnect gate: per Steve's bench
  -- research (traced all the way back to the ORIGINAL vendor "WEB" script,
  -- confirming this predates any version of this plugin), talking to the
  -- eCNA within roughly 10s of its first ICMP response during its own boot
  -- sequence can wedge its web UI -- waiting Ping_Stable_Window seconds
  -- after that first response measurably reduces both how often that
  -- happens and how long it lasts when it still does. Also flips Status/
  -- Event Log to "Initializing" the moment that first ping lands, in the
  -- boot case only, per Steve's request ("it will indicate we are doing
  -- something to the user, and in the log") -- the reconnect case
  -- deliberately leaves Status showing Fault/Disconnected through this
  -- same wait, unchanged from before, since "Initializing" there is
  -- reserved for the real CAI reconnect actually succeeding (see
  -- connect()'s own isAutoRetry comment).
  PingGate.start = function(isBoot)
    if not PingGate.enabled then return false end
    if PingGate.active then return true end  -- already gating this same outage; both the CAI and HTTP fault paths can call this for the same underlying disconnect
    local ip = Controls.IP_ADDRESS.String
    if not isValidIP(ip) then return false end
    PingGate.active     = true
    PingGate.counting   = false
    PingGate.isBootWait = isBoot or false
    dbg("Ping gate: pausing " .. (PingGate.isBootWait and "initial connect" or "CAI reconnect + ALL HTTP traffic") .. ", watching ICMP for " .. ip .. " before " .. (PingGate.isBootWait and "contacting it" or "reconnecting"))
    PingGate.obj = Ping.New(ip)
    PingGate.obj:setPingInterval(2)  -- 2s, per Steve's choice
    PingGate.obj.EventHandler = function()
      if not PingGate.active then return end  -- stray response after the gate already resolved/cancelled
      if not PingGate.counting then
        PingGate.counting = true
        dbg("Ping gate: ICMP reply received, starting " .. PingGate.stableWindow .. "s grace period before " .. (PingGate.isBootWait and "any contact" or "reconnecting"))
        if PingGate.isBootWait then
          -- Boot case only (see this function's own comment) -- the device
          -- is physically present, so this is genuine proof-of-life worth
          -- surfacing, even though we haven't attempted CAI/HTTP yet.
          setStatus(STATUS_INITIALIZING, "Initializing (device found, waiting " .. PingGate.stableWindow .. "s before contacting)")
          logConnTransition("Initializing")
        end
        PingGate.timer:Start(PingGate.stableWindow)
      end
    end
    PingGate.obj.ErrorHandler = function()
      if not PingGate.active then return end
      if PingGate.counting then
        dbg("Ping gate: ICMP reply missed mid-window, resetting grace period")
        PingGate.counting = false
        PingGate.timer:Stop()
      end
    end
    PingGate.obj:start(false)  -- repeating, not single-shot
    return true
  end

  -- ── CAI TCP Socket Handler ──────────────────────────────────
  -- Manages connection state and incoming data buffering
  sock.EventHandler = function(sock, evt, err)
    if evt == TcpSocket.Events.Connected then
      isConnected = true
      connecting  = false
      -- Staleness guard for the backoff flag (v1.4.0.14): a fresh TCP-level
      -- connect is starting a brand new attempt, so any leftover flag from
      -- a previous attempt's ERR response is no longer meaningful here.
      -- Normally already false by this point (cleared when the prior
      -- disconnect was handled) -- this just removes any doubt.
      lastErrWasResourceUnavailable = false
      -- The raw TCP handshake succeeding doesn't mean we have real, current
      -- data yet (RID/RST/names/etc. below still have to arrive) -- but it
      -- IS genuine progress, and worth showing as such, rather than
      -- leaving Status sitting on a stale Fault message (e.g. "Connect
      -- timed out" from an earlier failed retry) right up until
      -- checkFullyPopulated() flips it directly to "OK". Guarded by
      -- `not statusIsOK` so a redundant/spurious Connected notification
      -- while already fully populated can't regress the display backwards.
      -- If we lose the connection again before reaching OK, the normal
      -- Closed/Error/Reconnect handling below (Fault + reconnectScheduled)
      -- takes over exactly as it already does -- nothing else needed to
      -- protect that case.
      if not statusIsOK then
        setStatus(STATUS_INITIALIZING, "Initializing")
      end
      -- Request device ID and enable unsolicited event reports
      sendCmd("RID,"..nextPSN())
      sendCmd("CFG,"..nextPSN()..",RPTON,N")
      -- Fetch both name pages (and dimmer setup, if QDC enabled) once on connect.
      Timer.CallAfter(function()
        -- Clear before repopulating (v1.4.0.13). Every TCP-level Connected
        -- event reaches this same callback, including ones where the eCNA
        -- immediately rejects RID/CFG (RSP,ERR,...,998,Resource
        -- Unavailable) -- e.g. during the ~60-70s window seen right after
        -- an eCNA power cycle, where the CAI socket reconnects roughly
        -- every 5s (reconnectTmr) while the eCNA is still settling. Without
        -- this clear, each of those failed attempts appended another full
        -- batch on top of whatever was still queued from the previous one,
        -- so the HTTP side kept firing a fresh name-fetch request every
        -- ~1.3-1.6s continuously for the entire lockout -- on top of the 5s
        -- CAI retries -- regardless of the eCNA having just told us it had
        -- no spare resource to give. This doesn't fix why the eCNA rejects
        -- reconnects after a power cycle in the first place (that looks
        -- like the eCNA's own boot behavior, not something in our
        -- control), but it stops the plugin from piling on unnecessary
        -- HTTP load while that is happening. macroNameQueue gets the same
        -- treatment for the same reason, even though it is lower priority.
        nameQueue = {}
        macroNameQueue = {}
        table.insert(nameQueue, {"/Setup.xml?PgIdx=75", applyInputNames})   -- inputs
        table.insert(nameQueue, {"/Setup.xml?PgIdx=74", applyOutputNames})  -- outputs
        if ENABLE_QDC then
          table.insert(nameQueue, {"/Setup.xml?PgIdx=13", applyDimmerSetup})  -- QDC zone names + channel assignments
          table.insert(nameQueue, {"/rtLin.xml", applyLinNetwork})  -- confirm QDC-400 board(s) actually present on the LIN network
        end
        -- Get the nanoHost's initial conditions in the same bootstrap
        -- burst as everything else while "Initializing", rather than
        -- waiting for the first slow NANOHOST poll tier turn (up to
        -- NANO_POLL_RATE seconds later). This is a ONE-TIME priority fetch --
        -- routine refresh after this still runs on its own much slower
        -- cadence via httpRequest()'s NANOHOST tier, unaffected by this.
        if ENABLE_NANOHOST then
          table.insert(nameQueue, {"/rtmandata.xml", parseNanoHost})
        end
        -- RDI device names (v1.4): one Setup.xml fetch per configured
        -- device, PgIdx=69..73 for devices 1-5. Not part of
        -- checkFullyPopulated()'s gate -- these only decorate RDI Event
        -- Log messages, not core status, so a slow/unresponsive device
        -- slot can't hold up reaching "OK".
        if RDI_COUNT > 0 then
          for d = 1, RDI_COUNT do
            table.insert(nameQueue, {"/Setup.xml?PgIdx="..(68+d), applyRDIName(d)})
          end
        end
        -- Macro names (v1.4): queued into macroNameQueue, NOT nameQueue --
        -- see the comment by macroNameQueue's declaration for why these
        -- stay out of the bootstrap priority tier entirely. Only bothers
        -- building the queue at all when Event Logging is enabled (top
        -- tier), since these names exist purely to decorate log messages.
        if ENABLE_EVENT_LOG and NUM_MACROS > 0 then
          for m = 1, NUM_MACROS do
            table.insert(macroNameQueue, {"/Setup.xml?PgIdx="..(15+m), applyMacroName(m)})
          end
        end
        dbg("Queuing initial name fetches")
      end, 0.3)
      -- Short delay before first RST poll to let device settle
      Timer.CallAfter(function() sendCmd("RST,"..nextPSN()) end, 0.5)
      pollTimer:Start(POLL_RATE)
    elseif evt == TcpSocket.Events.Data then
      -- Accumulate data and process complete lines
      rxBuf = rxBuf .. sock:Read(sock.BufferLength)
      while true do
        local nl = rxBuf:find("\n")
        if not nl then break end
        local line = rxBuf:sub(1, nl)
        rxBuf = rxBuf:sub(nl+1)
        local ok, err = pcall(processLine, line)
        if not ok then
          dbg("Parse error: " .. tostring(err))
        end
      end
    elseif evt == TcpSocket.Events.Closed
        or evt == TcpSocket.Events.Reconnect
        or evt == TcpSocket.Events.Error
        or evt == TcpSocket.Events.Timeout then
      -- Timeout (v1.4.0.16): distinct from Error in the TcpSocket API, and
      -- previously unhandled here -- meant sock.ReadTimeout (added this same
      -- build) would silently close the socket with nothing reacting to it.
      -- Routed into the same branch as Closed/Reconnect/Error since a
      -- read-timeout-triggered close is just as much a real disconnection as
      -- any other -- same Fault/backoff/reconnect handling applies.
      isConnected = false
      connecting  = false
      if intentionalDisconnect then
        -- This close is a direct result of connect()'s own sock:Disconnect()
        -- call, immediately followed by a fresh connection attempt for the
        -- same deliberate reconnect (manual button, IP change, or the
        -- automatic retry) -- not an unexpected fault. Don't flag Fault
        -- status or schedule a redundant 5s retry on top of the reconnect
        -- that's already happening.
        intentionalDisconnect = false
        lastErrWasResourceUnavailable = false  -- not a real rejection reaction; don't let a stray flag leak into a later unrelated disconnect
        dbg("Disconnected as part of our own reconnect -- not a fault")
      elseif reconnectScheduled then
        -- We already reacted to a failure for this outstanding attempt
        -- (Fault logged, 5s retry already ticking) -- this is a redundant
        -- terminal notification for that SAME failure, not a fresh
        -- disconnect. Ignore it: re-logging Fault and restarting
        -- reconnectTmr here would just push the actual retry further out
        -- every time one of these arrives, causing
        -- Initializing/Disconnected/Disconnected flapping against a
        -- genuinely unreachable IP.
        lastErrWasResourceUnavailable = false  -- redundant echo of the same failure; already accounted for when the real one was handled
        dbg("Redundant disconnect notification while a retry is already pending -- ignored")
      else
        reconnectScheduled = true
        setStatus(STATUS_FAULT, (err and err ~= "") and ("Disconnected: "..err) or "Disconnected")
        -- Real failure (v1.4.0.18): this branch only runs once per genuine
        -- outstanding disconnect (guarded by reconnectScheduled above, same
        -- as always) -- exactly the "stop receiving data" half of Steve's
        -- rule.
        logConnTransition("Disconnected", true)
        pollTimer:Stop()
        -- Backoff (v1.4.0.14): widen the retry gap after the eCNA has
        -- explicitly rejected us with Resource Unavailable, instead of
        -- retrying at a flat 5s regardless of what it just told us. Any
        -- OTHER disconnect reason resets straight back to the fast 5s
        -- retry -- this is specifically about not hammering a device that
        -- just said it has no session to give, not about being generally
        -- more cautious after every disconnect.
        local wasResourceUnavailable = lastErrWasResourceUnavailable  -- captured before the flag is cleared below (v1.4.0.20: needed again for the ping-gate skip check just below)
        if lastErrWasResourceUnavailable then
          reconnectBackoffIdx = math.min(reconnectBackoffIdx + 1, #RECONNECT_BACKOFF_STEPS)
        else
          reconnectBackoffIdx = 1
        end
        lastErrWasResourceUnavailable = false
        local delay = RECONNECT_BACKOFF_STEPS[reconnectBackoffIdx]
        -- Ping gate (v1.4.0.20): a Resource-Unavailable rejection means the
        -- eCNA's CAI session manager isn't ready yet -- it says nothing
        -- about ICMP, which has been fine the whole time (we only got this
        -- far because a prior ping-gate wait already proved it, or the
        -- gate is off). Re-arming the full gate wait here just adds
        -- another Ping_Stable_Window seconds of pure latency for no added
        -- safety -- ICMP was never in question. Skip straight to the
        -- normal backed-off retry in that case. Otherwise, if the gate is
        -- enabled, PingGate.start() takes over entirely (pausing CAI
        -- reconnect + ALL HTTP traffic until ICMP proves stable) and the
        -- normal backoff retry below is skipped; falls through to the
        -- normal retry if the gate declines (feature off or no valid IP).
        if wasResourceUnavailable then
          dbg("Resource Unavailable -- ICMP never dropped, skipping ping-gate re-wait -- reconnecting in " .. delay .. "s (backed off)")
          reconnectTmr:Start(delay)
        elseif not PingGate.start() then
          dbg("Reconnecting in " .. delay .. "s" .. (reconnectBackoffIdx > 1 and " (backed off after Resource Unavailable)" or ""))
          reconnectTmr:Start(delay)
        end
      end
    end
  end

  -- ── Timers ──────────────────────────────────────────────────
  -- RST poll: sends status request at POLL_RATE interval
  pollTimer.EventHandler = function()
    if isConnected then
      local ok, err = pcall(function() sendCmd("RST,"..nextPSN()) end)
      if not ok then dbg("Poll error: "..(err or "")) end
    end
  end

  -- ── Connect function ────────────────────────────────────────
  -- Initiates CAI TCP connection using current IP/port settings.
  --
  -- Clearing the old `connecting` guard the instant the raw TCP handshake
  -- completes (in the Connected handler) is too narrow a window: two
  -- Reconnect presses close together can otherwise race, with the second
  -- disconnecting the barely-established first connection and
  -- reconnecting again, which the eCNA rejects with "Resource Unavailable"
  -- because it hasn't yet fully released the just-closed session. A
  -- generation counter debounces the entire sequence instead: every
  -- connect() call bumps it, a fresh attempt only actually fires after a
  -- short cooldown, and if a NEWER connect() call arrives during that
  -- cooldown, the older one silently stands down rather than racing it.
  -- Repeated rapid presses collapse into a single attempt, timed from the
  -- last press.
  -- `isAutoRetry` distinguishes the automatic 5s-after-Fault retry (called
  -- only from reconnectTmr.EventHandler) from every other caller (initial
  -- startup, manual Reconnect button, IP change) -- all of which pass
  -- nothing, i.e. isAutoRetry=false. An automatic retry leaves Status
  -- showing whatever Fault/Missing state it already had (still fully
  -- updated the instant something actually responds, via the normal
  -- Connected/RST-populated path) rather than flashing back to
  -- "Initializing" on every cycle against a target that's been Faulted the
  -- whole time -- "Initializing" is reserved for attempts the operator
  -- actually initiated or that are happening for the first time.
  local function connect(isAutoRetry)
    local ip   = Controls.IP_ADDRESS.String
    local port = tonumber(Controls.TCP_PORT.String)
    if not port or port < 1 then port = TCP_PORT end
    if not isValidIP(ip) then
      setStatus(STATUS_MISSING, ip and #ip > 0 and "Invalid IP address" or "Missing")
      -- v1.4.0.18: an invalid/missing IP is just as much "not connected" as
      -- any other fault -- logConnTransition's own dedup keeps this a no-op
      -- if we were already logged as Disconnected.
      logConnTransition("Disconnected", true)
      return
    end

    connectingGen = connectingGen + 1
    local myGen = connectingGen
    -- Full reset, both CAI and HTTP sides (v1.4.0.17; previously CAI-only --
    -- see the removed resetCaiPopulationTracking comment this replaces).
    -- That earlier design let a CAI-only reconnect keep already-fresh
    -- HTTP-side flags (names/scrape/QDC/nanoHost) rather than re-earning
    -- them, specifically to avoid re-paying the HTTP fetch cost when only
    -- the CAI side had hiccuped. In the field this meant OK could reappear
    -- within a few hundred ms of a bare RID/RST success, off HTTP flags
    -- left over from BEFORE the disconnect -- not anything freshly
    -- reconfirmed since this reconnect began. Per Steve: "OK should always
    -- mean that all flags are correct (to within the last refresh timing)"
    -- -- a reconnect (of either channel) must always pass back through
    -- Initializing and actually repopulate before OK is allowed again, full
    -- stop. On this project's bench config (QDC/nanoHost both off) this
    -- costs about 3s (In+Out name fetch) on top of RID/RST, not the "tens
    -- of seconds" the old design was guarding against -- RDI/macro names
    -- remain excluded from this gate either way (pure log decoration, see
    -- checkFullyPopulated()).
    resetPopulationTracking()
    if not isAutoRetry then
      setStatus(STATUS_INITIALIZING, "Initializing")
    end

    local function doConnect()
      cooldownPending = false
      if connectingGen ~= myGen then
        dbg("Superseded by a newer connect() request, standing down")
        return  -- a newer connect() call arrived during the cooldown -- let it own the attempt
      end
      rxBuf = ""
      connecting = true
      reconnectScheduled = false  -- a fresh attempt is actually starting now -- the NEXT terminal event (whichever it is) is new information, not a redundant echo of the last failure
      Timer.CallAfter(function()
        if connecting and connectingGen == myGen then
          -- If the raw socket layer never delivers a terminal Closed/Error
          -- event at all for an unreachable address, nothing would
          -- otherwise un-stick the plugin -- it would sit at
          -- "Initializing" indefinitely. Treat a 10s non-resolution the
          -- same as an unexpected disconnect: flag Fault and schedule the
          -- normal 5s automatic retry, same path a real Closed/Error event
          -- would take. Guarded by
          -- `reconnectScheduled` like that path too, in case the real
          -- terminal event arrives at nearly the same moment.
          dbg("Connect attempt did not resolve within 10s, treating as failed")
          connecting = false
          isConnected = false
          if not reconnectScheduled then
            reconnectScheduled = true
            setStatus(STATUS_FAULT, "Connect timed out")
            -- v1.4.0.18: 10s with zero response at all is a real failure,
            -- same as the Closed/Error/Timeout path's own Disconnected log.
            logConnTransition("Disconnected", true)
            pollTimer:Stop()
            -- Ping gate (v1.4.0.20): same fallback pattern as the real
            -- Closed/Error/Timeout branch above -- if the gate declines,
            -- fall through to the normal 5s retry.
            if not PingGate.start() then
              reconnectTmr:Start(5)
            end
          end
        end
      end, 10)
      sock:Connect(ip, port)
    end

    if isConnected or connecting or cooldownPending then
      intentionalDisconnect = true
      if isConnected or connecting then sock:Disconnect() end
      -- Give the eCNA a moment to fully release the old CAI session before
      -- asking for a new one, rather than reconnecting in the same tick.
      cooldownPending = true
      Timer.CallAfter(doConnect, 1.5)
    else
      doConnect()
    end
  end

  -- Reconnect: fires 5 seconds after disconnect, attempts new connection.
  -- Routed through connect() (rather than calling sock:Connect() directly,
  -- as before) so the automatic retry gets the same re-entrancy guard,
  -- population-tracking reset, and status handling as every other
  -- reconnect path -- there's only one place connection attempts start now.
  -- Passes isAutoRetry=true so Status keeps showing Fault/Missing through
  -- repeated automatic retries instead of flashing back to "Initializing"
  -- every 5 seconds against a target that's been unreachable the whole
  -- time.
  reconnectTmr.EventHandler = function()
    reconnectTmr:Stop()
    connect(true)
  end

  -- ── Control Event Handlers ──────────────────────────────────
  -- Connect when IP is entered or changed. Reset first -- see
  -- resetForNewTarget's comment for why this matters: without it, a
  -- command queued while pointed at a different (or unreachable) address
  -- would otherwise get sent, with top priority, to whatever unit we
  -- connect to next.
  Controls.IP_ADDRESS.EventHandler = function()
    PingGate.stop()  -- v1.4.0.20: a new target invalidates any gate watching the OLD IP
    resetForNewTarget()
    if Controls.TCP_PORT.String == "" then
      Controls.TCP_PORT.String = tostring(TCP_PORT)
    end
    connect()
    httpConnected = false
    httpBuf = ""
    local ip = Controls.IP_ADDRESS.String
    if httpSock and isValidIP(ip) then httpSock:Connect(ip, 80) end
  end

  Controls.Reconnect.EventHandler = function()
    PingGate.stop()  -- v1.4.0.20: manual Reconnect is an explicit operator override -- don't leave a gate quietly watching in the background
    connect()
  end

  -- Single consolidated refresh: re-fetches everything that's normally
  -- only fetched once at connect. Queued in order at the FRONT of nameQueue so
  -- it executes on the next few HTTP cycles ahead of routine traffic.
  Controls.Refresh_Setup.EventHandler = function()
    local items = {
      {"/Setup.xml?PgIdx=75", applyInputNames},
      {"/Setup.xml?PgIdx=74", applyOutputNames},
    }
    if ENABLE_QDC then
      table.insert(items, {"/Setup.xml?PgIdx=13", applyDimmerSetup})
      table.insert(items, {"/rtLin.xml", applyLinNetwork})
    end
    if RDI_COUNT > 0 then
      for d = 1, RDI_COUNT do
        table.insert(items, {"/Setup.xml?PgIdx="..(68+d), applyRDIName(d)})
      end
    end
    for k = #items, 1, -1 do  -- reverse order so repeated front-inserts land in the right final sequence
      table.insert(nameQueue, 1, items[k])
    end
    -- Macro names refresh at the SAME low priority as the initial connect
    -- burst -- rebuilding this list front-inserted into nameQueue would
    -- reintroduce exactly the connect-time-style stall this design avoids,
    -- just triggered by a button press instead of a connect. Clearing and
    -- rebuilding macroNameQueue (rather than appending) avoids piling up
    -- duplicate fetches if Refresh_Setup is pressed more than once before
    -- the queue drains.
    if ENABLE_EVENT_LOG and NUM_MACROS > 0 then
      macroNameQueue = {}
      for m = 1, NUM_MACROS do
        table.insert(macroNameQueue, {"/Setup.xml?PgIdx="..(15+m), applyMacroName(m)})
      end
    end
    dbg("Manual setup refresh queued (priority): " .. #items .. " items" ..
        (ENABLE_EVENT_LOG and NUM_MACROS > 0 and (", "..NUM_MACROS.." macro names queued (low priority)") or ""))
  end

  -- Transport command buttons (Trigger type)
  Controls.Cmd_Start.EventHandler        = function() sendCmd("EVT,"..nextPSN()..",STA,Y") end
  Controls.Cmd_Stop.EventHandler         = function() sendCmd("EVT,"..nextPSN()..",STP,Y") end
  Controls.Cmd_Cue.EventHandler          = function() sendCmd("EVT,"..nextPSN()..",CUE,Y") end
  Controls.Cmd_Abort.EventHandler        = function() sendCmd("EVT,"..nextPSN()..",ABT,Y") end
  Controls.Cmd_Fault.EventHandler        = function() sendCmd("EVT,"..nextPSN()..",FLT,Y") end
  Controls.Cmd_Clear_Fault.EventHandler  = function() sendCmd("EVT,"..nextPSN()..",CLR,Y") end
  Controls.Cmd_Reset.EventHandler        = function() sendCmd("EVT,"..nextPSN()..",RES,Y") end
  Controls.Cmd_Cancel_Alarm.EventHandler = function() sendCmd("EVT,"..nextPSN()..",CNL,Y") end

  -- Program selection (Trigger type)
  Controls.Cmd_Set_Program.EventHandler = function()
    sendCmd("EVT,"..nextPSN()..",PGM,"..Controls.Set_Program.String..",Y")
  end
  Controls.Cmd_Set_And_Run.EventHandler = function()
    sendCmd("EVT,"..nextPSN()..",SPR,"..Controls.Set_Program.String..",Y")
  end

  -- Macro triggers (Trigger type, indexed 1-N). Event Log (Macros
  -- category): only macros this plugin itself sends are ever visible to
  -- it, so every send here is logged (gated on statusIsOK, same as every
  -- non-Connection category) -- there is no separate confirmation path, and
  -- none is needed for a fire-and-forget trigger.
  if Controls.Macros then
    for idx, ctl in ipairs(Controls.Macros) do
      ctl.EventHandler = function()
        sendCmd("EVT,"..nextPSN()..",MAC,"..idx..",Y")
        if statusIsOK then
          local label = "Macro "..idx
          if macroNames[idx] then label = label.." ["..macroNames[idx].."]" end
          logEvent("Macros", label.." triggered")
        end
      end
    end
  end

  -- RDI triggers (Trigger type, device and command derived from flat
  -- index). Event Log (RDI category): same fire-and-forget logging as
  -- Macros above, same reason.
  if Controls.RDI then
    for idx, ctl in ipairs(Controls.RDI) do
      local dev = math.ceil(idx/16)
      local cmd = ((idx-1) % 16) + 1
      ctl.EventHandler = function()
        sendCmd("EVT,"..nextPSN()..",RDI,"..dev..","..cmd..",Y")
        if statusIsOK and rdiDevEnabled(dev) then
          local devLabel = "RDI device "..dev
          if rdiNames[dev] then devLabel = devLabel.." ["..rdiNames[dev].."]" end
          local cmdLabel = "command "..cmd
          if rdiCmdNames[dev] and rdiCmdNames[dev][cmd] then cmdLabel = cmdLabel.." ["..rdiCmdNames[dev][cmd].."]" end
          logEvent("RDI", devLabel.." "..cmdLabel.." triggered")
        end
      end
    end
  end

  -- House Lights: mutually exclusive Toggle, sends HLNONE/HLDOWN/etc.
  local HouseLightCodes = {"HLNONE","HLDOWN","HLMID1","HLMID2","HLUP"}
  for idx, ctl in ipairs(Controls.House_Lights) do
    ctl.EventHandler = function()
      setExclusive(Controls.House_Lights, idx)
      sendCmd("OUT,"..nextPSN()..","..HouseLightCodes[idx]..",N")
    end
  end

  -- Stage Lights: mutually exclusive Toggle
  local StageLightCodes = {"SLNONE","SLDOWN","SLUP"}
  for idx, ctl in ipairs(Controls.Stage_Lights) do
    ctl.EventHandler = function()
      setExclusive(Controls.Stage_Lights, idx)
      sendCmd("OUT,"..nextPSN()..","..StageLightCodes[idx]..",N")
    end
  end

  -- Curtain: mutually exclusive Toggle
  local CurtainCodes = {"CURTNONE","CURTCLOS","CURTOPEN"}
  for idx, ctl in ipairs(Controls.Curtain) do
    ctl.EventHandler = function()
      setExclusive(Controls.Curtain, idx)
      sendCmd("OUT,"..nextPSN()..","..CurtainCodes[idx]..",N")
    end
  end

  -- Masking: mutually exclusive Toggle
  local MaskCodes = {"MSKNONE","MSKFLAT","MSKSCOPE","MSKSPECL"}
  for idx, ctl in ipairs(Controls.Masking) do
    ctl.EventHandler = function()
      setExclusive(Controls.Masking, idx)
      sendCmd("OUT,"..nextPSN()..","..MaskCodes[idx]..",N")
    end
  end

  -- Lens: mutually exclusive Toggle
  local LensCodes = {"LENNONE","LENFLAT","LENSCOPE","LENSPECL"}
  for idx, ctl in ipairs(Controls.Lens) do
    ctl.EventHandler = function()
      setExclusive(Controls.Lens, idx)
      sendCmd("OUT,"..nextPSN()..","..LensCodes[idx]..",N")
    end
  end

  -- Sound: mutually exclusive Toggle
  local SoundCodes = {"SNDNONE","SNDAUX1","SNDAUX2","SNDDIG1","SNDDIG2","SNDMONO","SNDNSYNC","SNDSR","SNDSVA"}
  for idx, ctl in ipairs(Controls.Sound) do
    ctl.EventHandler = function()
      setExclusive(Controls.Sound, idx)
      sendCmd("OUT,"..nextPSN()..","..SoundCodes[idx]..",N")
    end
  end

  -- Mute: independent Toggle. No scrape/RST readback exists for Mute, so
  -- unlike the other Outputs, its Boolean is never re-confirmed elsewhere --
  -- this EventHandler (Q-SYS has already applied the toggle to
  -- Controls.Mute.Boolean by the time it fires) is the only place its
  -- state ever changes, so it is also the only place to Event-Log it.
  Controls.Mute.EventHandler = function()
    sendCmd("OUT,"..nextPSN()..","..(Controls.Mute.Boolean and "MUTEON" or "MUTEOFF")..",N")
    logChanged(outputsBaseline, "Mute", Controls.Mute.Boolean, "Outputs", function(old, new)
      return "Mute " .. (new and "ON" or "OFF")
    end)
  end

  -- Digital Projector toggles (send ON/OFF commands)
  Controls.Dig1_Power.EventHandler    = function() sendCmd("OUT,"..nextPSN()..","..(Controls.Dig1_Power.Boolean    and "DP1ON"   or "DP1OFF")  ..",Y") end
  Controls.Dig1_Video.EventHandler    = function() sendCmd("OUT,"..nextPSN()..","..(Controls.Dig1_Video.Boolean    and "DV1ON"   or "DV1OFF")  ..",Y") end
  Controls.Dig2_Power.EventHandler    = function() sendCmd("OUT,"..nextPSN()..","..(Controls.Dig2_Power.Boolean    and "DP2ON"   or "DP2OFF")  ..",Y") end
  Controls.Dig2_Video.EventHandler    = function() sendCmd("OUT,"..nextPSN()..","..(Controls.Dig2_Video.Boolean    and "DV2ON"   or "DV2OFF")  ..",Y") end
  Controls.Aux_Projector.EventHandler = function() sendCmd("OUT,"..nextPSN()..","..(Controls.Aux_Projector.Boolean and "SPROJON" or "SPROJOFF")..",Y") end

  -- Aux Outputs 1-16
  for idx, ctl in ipairs(Controls.Aux_Out) do
    ctl.EventHandler = function()
      sendCmd("OUT,"..nextPSN()..","..(Controls.Aux_Out[idx].Boolean and "OUT"..idx.."ON" or "OUT"..idx.."OFF")..",Y")
    end
  end

  -- ── QDC-400 Dimmer Lighting: Zone preset / offset controls (v1.2) ──
  -- NOTE: unlike every other output group in this file, these are NOT sent
  -- via the CAI socket (sendCmd/"OUT,..."). The CAI protocol has no codes
  -- for Zone 3-16 lights, individual channel levels, or the offset -- the
  -- only path is HTTP GET /rtLights.xml?Zone=..&State=..&Level=..&Fader=..
  -- (see manual §4.3.19-21, §5.9, and the eCNA's own statLightCtrl.htm).
  -- Commands are queued via queueLightCmd() and sent by httpRequest(),
  -- sharing the single HTTP connection with the flag scrape and name
  -- fetches, exactly like the Refresh_Setup button already does for the name queue.
  if Controls.Zone_Preset then
    -- rtLights.xml State codes: 0=Up 1=Down 2=Mid1 3=Mid2 4=None
    -- (matches button order Up/Down/Mid1/Mid2/None used throughout this file)
    local ZonePresetState = {0,1,2,3,4}
    for i = 1, qdcZones do
      local base = (i-1)*5
      for b = 1, 5 do
        local ctl = Controls.Zone_Preset[base+b]
        if ctl then
          ctl.EventHandler = function()
            for k = 1, 5 do Controls.Zone_Preset[base+k].Boolean = (k == b) end
            -- Capture whatever offset was actually showing right
            -- before beginPresetPending resets it to 0, so the one-extra-
            -- poll-cycle settling guard knows this transition "started"
            -- with a non-zero offset even though the target itself (offset
            -- reset to 0 on a fresh preset selection) doesn't.
            local priorOffset = Controls.Zone_Offset[i] and Controls.Zone_Offset[i].Value or 0
            beginPresetPending(i, ZonePresetState[b])  -- mask until eCNA confirms (or 15s), avoids visible flicker/reversion
            zoneCurrentPreset[i] = ZonePresetState[b]  -- remembered so a later offset-only change knows which preset level to combine with
            -- A preset selection ALSO resets the zone's offset to 0
            -- (manual sec 5.9, mirrored above via beginPresetPending ->
            -- beginOffsetPending(i, 0)). zoneLastOffset[i] (the unified
            -- detection block's own "last known offset" bookkeeping) must
            -- be updated here too, alongside zoneCurrentPreset --
            -- otherwise it stays stale at whatever offset was active
            -- BEFORE this button press, since it's only refreshed inside
            -- the detection block itself, which stays fully gated off
            -- while offsetPending is true. The very poll that finally
            -- confirms our command (clearing both
            -- presetPending and offsetPending) runs that detection block
            -- immediately afterward, in the SAME call -- sees the stale
            -- prevOff no longer matches the real (now zero) offset, and
            -- mistakes it for a fresh, independent offset-only change --
            -- firing animateOffsetChange with applyCompensation=true, which
            -- uses the fixed ~3s OFFSET_FADE_SECONDS (minus
            -- DETECTION_LAG_COMPENSATION) instead of the PRESET's own,
            -- typically much longer, configured fade for whatever distance
            -- is left. Symptom: the meter starts out correctly on the
            -- preset's own fade, then suddenly speeds up partway through.
            -- Updating zoneLastOffset here, in step with zoneCurrentPreset,
            -- means that once the real confirmation arrives, the detection
            -- block sees no change at all (0 == 0) and stays quiet, exactly
            -- as it already correctly does for the preset side.
            zoneLastOffset[i] = 0
            animatePresetChange(i, ZonePresetState[b], 0, false, priorOffset)  -- offset resets to 0 on a fresh preset selection (manual §5.9); self-initiated, no detection-lag compensation needed
            queueLightCmd(i-1, ZonePresetState[b], 0, 0)  -- Level/Fader=0, mirrors the web page's preset buttons
          end
        end
      end
    end
  end

  if Controls.Zone_Offset then
    for i = 1, qdcZones do
      local ctl = Controls.Zone_Offset[i]
      if ctl then
        ctl.EventHandler = function()
          -- Debounced network commit: text updates on every tick, but the
          -- actual command only fires once the fader has been still for 1s
          -- -- sending on every intermediate tick while dragging was
          -- fighting the poll latency and made the slider feel broken (it
          -- would "chase" a stale in-flight value). Masking is engaged on
          -- every tick (not just at commit) so a poll landing mid-drag
          -- can't flip the displayed value back before the debounce fires.
          -- The local channel-meter animation, by contrast, previews live
          -- on every tick -- we already know the target instantly, no need
          -- to wait for the network round trip to show the user what's coming.
          local v = math.floor(ctl.Value + 0.5)
          if Controls.Zone_Offset_Text[i] then Controls.Zone_Offset_Text[i].String = tostring(v) end
          beginOffsetPending(i, v)  -- masks immediately; re-armed (target + 15s failsafe) on every tick
          -- Keep zoneLastOffset in step with our own optimistic
          -- change, same reasoning as the preset button handler above --
          -- otherwise the unified detection block, once offsetPending
          -- finally clears, would compare the real (now-matching) offset
          -- against this stale value and mistake it for a fresh change,
          -- re-triggering the animation with applyCompensation=true.
          zoneLastOffset[i] = v
          animateOffsetChange(i, v, false)  -- self-initiated (live drag preview), no detection-lag compensation needed
          offsetDebounceGen[i] = (offsetDebounceGen[i] or 0) + 1
          local myGen = offsetDebounceGen[i]
          Timer.CallAfter(function()
            if offsetDebounceGen[i] == myGen then  -- no further movement since this tick -- fader has settled
              queueLightCmd(i-1, 5, v, 3)  -- State=5 (offset-only), Fader=3, mirrors the web page's slider commit
            end
          end, 1)
        end
      end
    end
  end

  if Controls.Zone_Offset_Text then
    for i = 1, qdcZones do
      local ctl = Controls.Zone_Offset_Text[i]
      if ctl then
        ctl.EventHandler = function()
          local v = tonumber(ctl.String)
          if v then
            v = math.floor(v + 0.5)
            if     v < -100 then v = -100
            elseif v > 100  then v = 100 end
            Controls.Zone_Offset[i].Value = v
            ctl.String = tostring(v)
            beginOffsetPending(i, v)  -- mask until eCNA echoes back this exact value (or 15s)
            zoneLastOffset[i] = v  -- see the fader handler above -- avoids a stale-comparison false re-trigger once offsetPending clears
            animateOffsetChange(i, v, false)  -- self-initiated, no detection-lag compensation needed
            queueLightCmd(i-1, 5, v, 3)
          else
            ctl.String = tostring(Controls.Zone_Offset[i].Value)  -- reject non-numeric entry, restore last known value
          end
        end
      end
    end
  end

  -- ── Offset step buttons ──────────────────────────────
  -- Momentary Increase/Decrease buttons beside the Offset readout: a quick
  -- press/release nudges the offset by 1; holding past HOLD_DELAY begins
  -- repeating at 1 unit per HOLD_REPEAT seconds until released. Reuses the
  -- exact same self-initiated offset pipeline as the fader/text box
  -- (beginOffsetPending, zoneLastOffset sync, animateOffsetChange,
  -- queueLightCmd) so it gets the same masking/animation/race protections
  -- for free -- no new interaction with the eCNA beyond what a fader drag
  -- or text commit already does.
  if Controls.Zone_Offset_Inc or Controls.Zone_Offset_Dec then
    local HOLD_DELAY  = 2.0   -- seconds held before repeat kicks in
    local HOLD_REPEAT = 0.5   -- seconds between repeated steps once past HOLD_DELAY
    local offsetStepTimer = {} -- offsetStepTimer[zone][dir] = current Timer instance ("inc"/"dec" kept independent so pressing both at once can't cross-cancel each other)
    local offsetStepGen   = {} -- offsetStepGen[zone][dir]   = generation counter; invalidates a stale scheduled callback after release or a fresh press

    local function stepOffset(i, delta)
      local ctl = Controls.Zone_Offset[i]
      if not ctl then return end
      -- Zone_Offset (a Knob/Fader control) stores Value as a Lua float even
      -- when it's showing a whole number -- the fader itself can be
      -- dragged to fractional positions, though nothing else in this
      -- plugin ever intentionally sets a fractional offset. Reading it raw
      -- and adding an integer delta (float + integer = float, per Lua
      -- 5.3's arithmetic subtype rules) would keep the result a float too,
      -- so tostring(v) would print "6.0" instead of "6" until the next
      -- live poll's tonumber(zofs[i]) (a plain integer string, no decimal
      -- point) overwrote it with a genuine Lua integer and "corrected" the
      -- display. Rounding here forces the integer subtype up front, same
      -- as the fader/text handlers already do via math.floor(x + 0.5), so
      -- every write to Zone_Offset_Text from a self-initiated change is a
      -- clean integer string from the start.
      local cur = math.floor((ctl.Value or 0) + 0.5)
      local v = cur + delta
      if v < -100 then v = -100 elseif v > 100 then v = 100 end
      if v == cur then return end  -- already at the +/-100 limit -- nothing new to send
      ctl.Value = v
      if Controls.Zone_Offset_Text[i] then Controls.Zone_Offset_Text[i].String = tostring(v) end
      beginOffsetPending(i, v)   -- masks immediately; re-armed on every step, same as the fader drag
      zoneLastOffset[i] = v      -- keep the unified-detection baseline in sync
      animateOffsetChange(i, v, false)  -- self-initiated, no detection-lag compensation
      -- Debounced rather than sending on every tap: a fast burst of taps
      -- (or the HOLD_REPEAT auto-repeat, one step per 0.5s) can generate
      -- commands faster than httpRequest() drains them -- LIGHTCMD is
      -- serviced at most once per HTTP round trip, roughly once per
      -- Scrape_Interval -- and queueLightCmd's 4-deep cap (mirroring the
      -- eCNA's own command buffer) silently drops anything past it, with
      -- no guarantee the LAST tapped value is among the survivors. That
      -- would leave the real device short of the intended value while our
      -- own local prediction shows the full amount, only correcting once
      -- a later scrape catches the mismatch. Debounced exactly like the
      -- fader drag handler above, sharing its same offsetDebounceGen[i]
      -- counter (both ultimately commit the same zone offset, so unifying
      -- the debounce is correct regardless of which control last moved) --
      -- only the final value, once input has been idle for 1s, is ever
      -- sent. The local display/animation still updates instantly on every
      -- tap; only the network commit waits.
      offsetDebounceGen[i] = (offsetDebounceGen[i] or 0) + 1
      local myGen = offsetDebounceGen[i]
      Timer.CallAfter(function()
        if offsetDebounceGen[i] == myGen then  -- no further movement (button or fader) since this tick -- settled
          queueLightCmd(i-1, 5, v, 3)  -- State=5 (offset-only), Fader=3, mirrors the web page's slider commit
        end
      end, 1)
    end

    local function startOffsetHold(i, dir, delta)
      offsetStepGen[i] = offsetStepGen[i] or {}
      offsetStepGen[i][dir] = (offsetStepGen[i][dir] or 0) + 1
      local myGen = offsetStepGen[i][dir]
      offsetStepTimer[i] = offsetStepTimer[i] or {}
      -- Always a FRESH Timer here, never reused across separate
      -- press cycles. A stale scheduled fire from an earlier press (one
      -- Timer:Stop() didn't manage to cancel before it fired -- can't
      -- assume otherwise across every possible runtime) would otherwise
      -- call whatever EventHandler is CURRENTLY assigned to a shared,
      -- reused Timer object -- i.e. the latest closure, whose captured
      -- myGen matches the CURRENT generation and so isn't recognized as
      -- stale at all. A brand-new Timer per press means an old, abandoned
      -- one's EventHandler closure is permanently fixed to the OLD myGen,
      -- so the generation check above correctly catches it as stale
      -- regardless of whether Stop() actually prevented it from firing.
      local t = Timer.New()
      offsetStepTimer[i][dir] = t
      stepOffset(i, delta)  -- immediate first step on press
      t.EventHandler = function()
        if offsetStepGen[i][dir] ~= myGen then return end  -- released (or re-pressed) since this fire was scheduled -- stale, ignore
        stepOffset(i, delta)
        t:Start(HOLD_REPEAT)
      end
      t:Start(HOLD_DELAY)
    end

    local function stopOffsetHold(i, dir)
      offsetStepGen[i] = offsetStepGen[i] or {}
      offsetStepGen[i][dir] = (offsetStepGen[i][dir] or 0) + 1  -- invalidates any pending timer callback
      if offsetStepTimer[i] and offsetStepTimer[i][dir] then offsetStepTimer[i][dir]:Stop() end
    end

    if Controls.Zone_Offset_Inc then
      for i = 1, qdcZones do
        local ctl = Controls.Zone_Offset_Inc[i]
        if ctl then
          ctl.EventHandler = function()
            if ctl.Boolean then startOffsetHold(i, "inc", 1) else stopOffsetHold(i, "inc") end
          end
        end
      end
    end

    if Controls.Zone_Offset_Dec then
      for i = 1, qdcZones do
        local ctl = Controls.Zone_Offset_Dec[i]
        if ctl then
          ctl.EventHandler = function()
            if ctl.Boolean then startOffsetHold(i, "dec", -1) else stopOffsetHold(i, "dec") end
          end
        end
      end
    end
  end

  -- (Refresh_Dimmer_Setup and Refresh_LIN_Network consolidated into the
  -- single Refresh_Setup handler above.)

  -- ── User-defined name tables ────────────────────────────────
  -- Fetched from eCNA on connect; fall back to default names if empty
  local inputNames  = {}  -- inputNames[1..16]  = user name for In1..In16
  local outputNames = {}  -- outputNames[1..16] = user name for Out1..Out16
  for i=1,16 do
    inputNames[i]  = "In"..i
    outputNames[i] = "Out"..i
  end

  -- Parse <tx>...</tx> values from Setup.xml response in order
  local function parseNames(data)
    local names = {}
    for name in data:gmatch("<tx>([^<]*)</tx>") do
      table.insert(names, name ~= "" and name:match("^%s*(.-)%s*$") or nil)
    end
    return names
  end

  -- Apply fetched input names to controls and internal table.
  -- Takes the raw HTTP body (not pre-parsed) so the Closed handler can
  -- route to any NAME-type applyFn -- including applyDimmerSetup below,
  -- which needs the raw body since it parses different tags (<txt>/<zone>
  -- rather than <tx>) -- with one uniform `currentApplyFn(body)` call.
  applyInputNames = function(body)
    local names = parseNames(body)
    for i = 1, math.min(#names, 16) do
      if names[i] then
        inputNames[i] = names[i]
      end
      -- Update the In_Names control string (used as display text in layout)
      if Controls.In_Names[i] then
        Controls.In_Names[i].String = inputNames[i]
      end
    end
    dbg("Input names loaded: " .. inputNames[1] .. ", " .. inputNames[2] .. "...")
    populated.inNames = true
    checkFullyPopulated()
  end

  -- Apply fetched output names to controls and internal table
  applyOutputNames = function(body)
    local names = parseNames(body)
    for i = 1, math.min(#names, 16) do
      if names[i] then
        outputNames[i] = names[i]
      end
      if Controls.Out_Names[i] then
        Controls.Out_Names[i].String = outputNames[i]
      end
    end
    dbg("Output names loaded: " .. outputNames[1] .. ", " .. outputNames[2] .. "...")
    populated.outNames = true
    checkFullyPopulated()
  end

  -- Apply fetched Setup.xml PgIdx=13 (QDC dimmer setup) response.
  -- Unlike applyInputNames/applyOutputNames this parses two different
  -- structures out of one response body, so it does its own parsing
  -- rather than going through parseNames() (which matches <tx>, not <txt>).
  --   Zone names: /setup/dimmers/names/nam/txt -- 14 entries, Zone3..Zone16 in order
  --   Channels:   /setup/dimmers/channels/chan -- 16 <chan> blocks, one per
  --     channel, each containing <zone>, <lev><up/dn/m1/m2></lev> (target
  --     level % for each preset), and <fad><up/dn/m1/m2></fad> (fade-in
  --     seconds for each preset). Parsed per-<chan> block (not with a flat
  --     global gmatch) so level/fade/zone stay correctly correlated to the
  --     right channel. <zone> value is a 1-based index into
  --     [none, House, Stage, Zone3..Zone16], i.e. 0=unassigned, 1=House,
  --     2=Stage, 3..16=Zone 3..16 (matches the zone number directly).
  --     Converted to rtLights.xml's 0-based Zone index (0=House..15=Zone16)
  --     as channelZone[ch] = value - 1.
  -- The lev/fad tables feed the local meter-animation simulation (see
  -- startChannelAnim below) -- manual §4.3.29/§5.9: a preset drives a
  -- channel to its configured level, and the offset is an additive
  -- override on top of that (absolute value when preset=None).
  applyDimmerSetup = function(body)
    local nIdx = 0
    for txt in body:gmatch("<txt>([^<]*)</txt>") do
      nIdx = nIdx + 1
      local zi = nIdx + 2  -- zone number 3..16
      if zi <= 16 then
        local nm = txt ~= "" and txt:match("^%s*(.-)%s*$") or nil
        zoneNames[zi] = (nm and nm ~= "") and nm or ("Zone "..zi)
        if zi <= qdcZones and Controls.Zone_Name and Controls.Zone_Name[zi] then
          Controls.Zone_Name[zi].String = zoneNames[zi]
        end
      end
    end
    local cIdx = 0
    for chanBlock in body:gmatch("<chan>(.-)</chan>") do
      cIdx = cIdx + 1
      local zv = tonumber(chanBlock:match("<zone>(%d+)</zone>")) or 0
      channelZone[cIdx] = zv - 1  -- 0-based rtLights.xml zone index; -1 = unassigned

      local levBlock = chanBlock:match("<lev>(.-)</lev>") or ""
      local fadBlock = chanBlock:match("<fad>(.-)</fad>") or ""
      channelPresetLevel[cIdx] = {
        [0] = tonumber(levBlock:match("<up>(%-?%d+)</up>")) or 0,  -- index by rtLights State code: 0=Up
        [1] = tonumber(levBlock:match("<dn>(%-?%d+)</dn>")) or 0,  -- 1=Down
        [2] = tonumber(levBlock:match("<m1>(%-?%d+)</m1>")) or 0,  -- 2=Mid1
        [3] = tonumber(levBlock:match("<m2>(%-?%d+)</m2>")) or 0,  -- 3=Mid2
      }
      channelPresetFade[cIdx] = {
        [0] = tonumber(fadBlock:match("<up>(%d+)</up>")),
        [1] = tonumber(fadBlock:match("<dn>(%d+)</dn>")),
        [2] = tonumber(fadBlock:match("<m1>(%d+)</m1>")),
        [3] = tonumber(fadBlock:match("<m2>(%d+)</m2>")),
      }

      if cIdx <= qdcChannels and Controls.Channel_Zone and Controls.Channel_Zone[cIdx] then
        local label
        if     zv == 0 then label = "-"
        elseif zv == 1 then label = "House"
        elseif zv == 2 then label = "Stage"
        else                label = zoneNames[zv] or ("Zone "..zv) end
        Controls.Channel_Zone[cIdx].String = label
      end
    end
    dbg("Dimmer setup loaded: "..nIdx.." zone names, "..cIdx.." channel level/fade configs")
    populated.dimmerSetup = true
    checkFullyPopulated()
  end

  -- Apply fetched /rtLin.xml (Status: Local I/O Network) response.
  -- Structure (from the eCNA's own statLin.htm): <lin><id>NNNN<dtyp>7</dtyp>
  -- <stat>132</stat>...other fields...</id><id>...</id></lin> -- one <id>
  -- block per device responding on the LIN network. dtyp 7 = "QDC-400"
  -- (dtyp 8 is its boot-loader mode, not counted as a working board). The
  -- stat field is a bitmask; bit 0x80 = "Device Active". This is a
  -- structural, independent confirmation of dimmer hardware presence --
  -- if zero active QDC-400 boards are found, every channel is immediately
  -- marked unconfirmed/no-dimmer rather than waiting on the slower
  -- per-channel "2 unexpected 0% polls" heuristic in parseLights.
  applyLinNetwork = function(body)
    local activeCount = 0
    local totalCount  = 0
    for idBlock in body:gmatch("<id>(.-)</id>") do
      local dtyp = tonumber(idBlock:match("<dtyp>(%d+)</dtyp>"))
      local stat = tonumber(idBlock:match("<stat>(%d+)</stat>")) or 0
      if dtyp == 7 then
        totalCount = totalCount + 1
        if (stat % 256) >= 128 then activeCount = activeCount + 1 end  -- bit 0x80 (Device Active), computed via arithmetic rather than a bitwise operator for portability
      end
    end
    qdcBoardCount = activeCount
    if Controls.QDC_Board_Count then Controls.QDC_Board_Count.String = tostring(activeCount) end
    dbg("LIN network scan: "..totalCount.." QDC-400 board(s) found, "..activeCount.." active")

    if activeCount == 0 then
      -- Structurally confirmed: no working QDC-400 hardware on the bus at
      -- all. Mark every channel unconfirmed/no-dimmer immediately rather
      -- than waiting for a preset change and 2 failed polls to find out.
      for ch = 1, qdcChannels do
        channelNoDimmer[ch]  = true
        channelConfirmed[ch] = false
        if Controls.Channel_Present and Controls.Channel_Present[ch] then
          Controls.Channel_Present[ch].Boolean = false
        end
      end
    end
    -- Note: activeCount > 0 does NOT clear channelNoDimmer/channelConfirmed
    -- for any channel -- a board being present on the bus doesn't prove any
    -- *particular* channel is wired to a working fixture. That positive
    -- confirmation still only comes from an actual non-zero level reading.
    populated.linScan = true
    checkFullyPopulated()
  end

  -- Names -- input, output, and dimmer setup -- are fetched once on
  -- connect and otherwise only via their manual Refresh buttons; no
  -- periodic re-fetch. See the Connected handler above and the three
  -- Refresh_*_Names button handlers below.

  -- ── Web Scrape via raw TCP HTTP/1.0 ─────────────────────────
  -- scrapeTimer is the sole reconnect driver (fires every SCRAPE_RATE seconds).
  -- httpRequest() called from both scrapeTimer AND Connected handler:
  --   scrapeTimer: not connected -> Connect(); connected -> no-op (httpBusy)
  --   Connected handler: always sends the GET immediately
  httpSock            = TcpSocket.New()  -- assigns to forward-declared upvalue
  local httpBuf       = ""
  local httpConnected = false
  scrapeTimer         = Timer.New()  -- assigns to forward-declared upvalue (see its own comment above)
  -- Fast-fail via HTTP scrape (v1.4.0.17): the CAI side can take up to
  -- POLL_RATE+10s (55s at the 45s default) to notice a genuinely dead
  -- connection via sock.ReadTimeout -- but HTTP requests fire far more
  -- often (SCRAPE_RATE, default 2s), so a real outage shows up here first.
  -- Counts consecutive HTTP request cycles that came back completely empty
  -- (buf=0 -- the eCNA's web server gave us nothing at all), across every
  -- request type, not just SCRAPE, since any of them failing is equally
  -- valid evidence the HTTP interface is unresponsive. Reset to 0 on any
  -- request that gets real bytes back, so an isolated blip can't
  -- accumulate toward the threshold -- matches Steve's "one bad response
  -- isn't disconnected, but zero response for a while is" principle,
  -- applied to this channel the same way sock.ReadTimeout applies it to
  -- CAI. At HTTP_FAIL_THRESHOLD consecutive failures, forces the CAI
  -- socket closed (see the escalation call below) so both channels
  -- restart together through the normal Fault/backoff/reconnect path,
  -- instead of waiting on CAI's own much slower detection.
  local consecutiveHttpFailures = 0
  local HTTP_FAIL_THRESHOLD = 3
  -- Generation counter for the HTTP connect failsafe below -- bumped on
  -- every httpSock:Connect() attempt so a stale 10s timeout from a
  -- superseded attempt can't wrongly act on a newer one. Mirrors
  -- connectingGen on the CAI socket.
  local httpConnectingGen = 0

  -- Escalation for the fast-fail counter above: forces the CAI socket
  -- closed so the existing Closed/Reconnect/Error/Timeout handling (Fault
  -- status, backoff, reconnectTmr, and -- as of this same build -- the full
  -- population reset in connect()) takes over, rather than duplicating any
  -- of that logic here. No-op if CAI doesn't currently think it's
  -- connected -- nothing useful to force closed, and it's presumably
  -- already reconnecting on its own. Deliberately does NOT set
  -- intentionalDisconnect first -- this needs to be treated as a genuine
  -- fault, not our own expected teardown.
  local function declareHttpDrivenDisconnect()
    consecutiveHttpFailures = 0  -- avoid re-triggering on every failure past the threshold
    if isConnected then
      dbg("HTTP scrape failed " .. HTTP_FAIL_THRESHOLD .. "x in a row -- forcing CAI reconnect")
      sock:Disconnect()
    end
  end

  -- Send HTTP GET, tagging currentReqType so the Closed handler knows
  -- which parser to route the response to.
  local function httpSend(path)
    local ip = Controls.IP_ADDRESS.String
    local req = "GET " .. path .. " HTTP/1.0\r\n"
             .. "Host: " .. ip .. "\r\n"
             .. "Authorization: Basic YWRtaW46MzE0MTU5\r\n"
             .. "Connection: close\r\n"
             .. "\r\n"
    httpSock:Write(req)
    httpBusy = true
    dbg("HTTP GET " .. path)
  end

  -- Scrape (/rtIoFDetail.xml) is the plugin's core purpose -- it's how
  -- preset changes and every other CAI-flag-driven indicator (Inputs/
  -- Outputs pages, House/Stage fast-path) get detected, same as the
  -- original script this plugin replaced.
  --
  -- The dimmer LIGHTPOLL runs on its OWN slower cadence (LightPoll_Interval,
  -- tracked in routine "ticks" via lightPollEveryNTicks -- see
  -- GetProperties/config comments) rather than automatically claiming
  -- every other turn -- if LIGHTPOLL claimed every other turn, its cadence
  -- would stay coupled to Scrape_Interval (since scrapeTimer restarts
  -- fresh after every request regardless of type), so lowering
  -- Scrape_Interval would speed up scrape AND lightpoll together, never
  -- scrape alone. Decoupling them means Scrape_Interval directly controls
  -- real scrape cadence, and LightPoll_Interval independently controls how
  -- often the dimmer poll takes a turn.
  --
  -- Priority order per tick:
  --   1) lightCmdQueue (button/offset manual commands) -- immediate, always
  --   2) nameQueue while NOT yet fully populated (one-time init bootstrap,
  --      or re-init after a target change) -- immediate, always; nothing is
  --      trustworthy yet so there's no scrape cadence worth protecting
  --   3) nameQueue once populated (e.g. a manual Refresh_Setup press) --
  --      still manual control, still immediate -- no longer has to wait for
  --      an "other" turn at all, which is a small additional improvement
  --   4) dimmer LIGHTPOLL, only once its own slower interval has elapsed
  --   5) nanoHost NANOHOST poll, only once its own MUCH slower
  --      interval has elapsed -- checked here, still ahead of the SCRAPE
  --      default, because SCRAPE has no "due" gating of its own (it's
  --      unconditional once reached) -- if NANOHOST were checked after it,
  --      it would never actually get a turn. Lower priority than LIGHTPOLL
  --      is expressed simply by checking it second: on the rare tick where
  --      both are due at once, LIGHTPOLL wins and NANOHOST's counter just
  --      isn't reset, so it gets picked up the very next tick instead.
  --   6) macroNameQueue (v1.4), only once its own MUCH slower interval has
  --      elapsed -- same "checked ahead of the unconditional SCRAPE
  --      default" reasoning as NANOHOST above, but throttled far more
  --      aggressively (MACRO_FETCH_EVERY_N_TICKS, not a real time interval)
  --      since this is pure background trickle-in, never anything
  --      time-sensitive. Only occasionally preempts SCRAPE; never preempts
  --      LIGHTCMD/nameQueue/LIGHTPOLL/NANOHOST above it.
  --   7) SCRAPE -- the default, every tick nothing above claimed
  local routineTicks = 0  -- counts turns since the last LIGHTPOLL; reset on send or on a fresh target
  local nanoTicks    = 0  -- counts turns since the last NANOHOST poll; reset on send or on a fresh target
  local macroTicks   = 0  -- counts turns since the last macroNameQueue fetch; reset on send or on a fresh target
  local MACRO_FETCH_EVERY_N_TICKS = 5  -- steals roughly 1 in 5 would-be SCRAPE turns; not a Designer property, this is background trickle-in only
  local function httpRequest()
    local ip = Controls.IP_ADDRESS.String
    if not isValidIP(ip) then
      scrapeTimer:Start(SCRAPE_RATE)  -- ensure timer restarts if invalid IP
      return
    end
    scrapeTimer:Stop()  -- pause timer; restarted in Closed handler
    if not httpConnected then
      -- Mirrors the CAI socket's own 10s connect failsafe (see
      -- connect()/doConnect() above): if the target never responds at the
      -- network level at all (eCNA not yet powered on), the underlying
      -- TCP connect can hang far longer than a target that's up and
      -- actively refusing, and no terminal Closed/Error event arrives to
      -- let us retry. scrapeTimer is stopped the instant a connect attempt
      -- starts (above) and only restarts in the Closed handler, so without
      -- this failsafe a single hung attempt against a not-yet-booted eCNA
      -- could block Inputs/Outputs/QDC/nanoHost data (and therefore
      -- Status=OK) for well over a minute after the eCNA actually came up.
      -- Force it to give up and retry after 10s, same as the CAI side.
      httpConnectingGen = httpConnectingGen + 1
      local myHttpGen = httpConnectingGen
      Timer.CallAfter(function()
        if not httpConnected and httpConnectingGen == myHttpGen then
          dbg("HTTP connect attempt did not resolve within 10s, treating as failed")
          httpBusy = false
          consecutiveHttpFailures = consecutiveHttpFailures + 1
          if consecutiveHttpFailures >= HTTP_FAIL_THRESHOLD then
            declareHttpDrivenDisconnect()
          end
          -- Ping gate (v1.4.0.20): don't resume scrape if a gate is now
          -- active (declareHttpDrivenDisconnect() above may have just
          -- triggered one via the CAI Closed/Error path) -- PingGate's own
          -- stable-window resolution restarts scrapeTimer once it's safe.
          if not PingGate.active then
            scrapeTimer:Start(SCRAPE_RATE)
          end
        end
      end, 10)
      httpSock:Connect(ip, 80)
      return
    end
    if httpBusy then return end  -- request already in-flight, wait for Closed event

    if #lightCmdQueue > 0 then
      local cmd = table.remove(lightCmdQueue, 1)
      currentReqType = "LIGHTCMD"
      httpSend(string.format("/rtLights.xml?Zone=%d&State=%d&Level=%d&Fader=%d", cmd[1], cmd[2], cmd[3], cmd[4]))
      return
    end

    -- The one-time initial population (input/output names, dimmer setup,
    -- LIN scan -- queued in nameQueue right after Connected) keeps its
    -- top priority, ahead of scrape: until initialization is done, nothing
    -- on screen is trustworthy yet, so retrieving that information takes
    -- priority over the scrape function. statusIsOK is false during
    -- this window (and again briefly after a target change re-triggers
    -- population), so this only engages during genuine (re)initialization.
    if #nameQueue > 0 and not statusIsOK then
      local item = table.remove(nameQueue, 1)
      currentReqType = "NAME"
      currentApplyFn = item[2]
      httpSend(item[1])
      return
    end

    -- A LATER name fetch once already populated (e.g. a manual
    -- Refresh_Setup press) is manual control, same priority tier as light
    -- commands -- still immediate, doesn't wait for anything.
    if #nameQueue > 0 then
      local item = table.remove(nameQueue, 1)
      currentReqType = "NAME"
      currentApplyFn = item[2]
      httpSend(item[1])
      return
    end

    routineTicks = routineTicks + 1

    -- Dimmer LIGHTPOLL: decoupled from scrape -- only takes a turn once its
    -- OWN slower interval has elapsed, instead of automatically claiming
    -- every other tick. Meter animation between real polls already masks
    -- the slower refresh, since the meters are already being "faked" via
    -- animation rather than reading live from every poll.
    if ENABLE_QDC and routineTicks >= lightPollEveryNTicks then
      routineTicks = 0
      currentReqType = "LIGHTPOLL"
      httpSend("/rtLights.xml")
      return
    end

    -- nanoHost NANOHOST poll -- lowest priority, own much-slower cadence
    -- (NANO_POLL_RATE, ~2.5 min). Only takes a turn when enabled AND due;
    -- this data updates no faster than every 5 minutes at the source, so
    -- polling it any more aggressively than this buys nothing and would
    -- just compete with scrape/lightpoll for no benefit.
    nanoTicks = nanoTicks + 1
    if ENABLE_NANOHOST and nanoTicks >= nanoPollEveryNTicks then
      nanoTicks = 0
      currentReqType = "NANOHOST"
      httpSend("/rtmandata.xml")
      return
    end

    -- Macro names (v1.4): lowest priority of all HTTP traffic. Only takes a
    -- turn every MACRO_FETCH_EVERY_N_TICKS, and only ever at SCRAPE's
    -- expense -- never LIGHTPOLL/NANOHOST/nameQueue/lightCmd above. See the
    -- macroNameQueue declaration comment for why these are eager-queued at
    -- connect but drained this slowly: up to 50 devices, each on its own
    -- Setup.xml page, would otherwise meaningfully delay reaching "OK".
    if #macroNameQueue > 0 then
      macroTicks = macroTicks + 1
      if macroTicks >= MACRO_FETCH_EVERY_N_TICKS then
        macroTicks = 0
        local item = table.remove(macroNameQueue, 1)
        currentReqType = "NAME"
        currentApplyFn = item[2]
        httpSend(item[1])
        return
      end
    end

    -- Default: SCRAPE, every tick nothing above claimed. This is now the
    -- common case, so Scrape_Interval directly reflects real scrape cadence.
    currentReqType = "SCRAPE"
    httpSend("/rtIoFDetail.xml")
  end

  -- ── Web Scrape XML Parser ────────────────────────────────────
  -- Parses <outs> and <ins> flag lists from the XML response
  -- Updates button states and LED indicators accordingly
  local function csvSplit(s)
    local t, pos = {}, 1
    while true do
      local nx = string.find(s, ",", pos, true)
      if nx == nil then
        if pos <= #s then table.insert(t, string.sub(s, pos)) end
        break
      end
      table.insert(t, string.sub(s, pos, nx-1))
      pos = nx + 1
    end
    return t
  end

  local function scrape(data)
    local function fi(sub) return string.find(data, sub, 1, true) or 0 end
    local os, oe  = fi("<outs>"),  fi("</outs>")
    local is_, ie = fi("<ins>"),   fi("</ins>")
    if os == 0 or is_ == 0 then return end

    -- Parse comma-separated flag numbers from XML tags
    local OutputFlags, InputFlags = {}, {}
    for _, v in ipairs(csvSplit(string.sub(data, os+6, oe-1)))  do table.insert(OutputFlags, tonumber(v)) end
    for _, v in ipairs(csvSplit(string.sub(data, is_+5, ie-1))) do table.insert(InputFlags,  tonumber(v)) end
    dbg("Scrape: " .. #OutputFlags .. " out flags, " .. #InputFlags .. " in flags")

    -- Helper: returns true if flag n is in the active output list
    local function flagActive(n)
      for _, v in ipairs(OutputFlags) do if v == n then return true end end
      return false
    end

    -- Readable option labels for Event Log messages (Outputs category),
    -- matching each group's own Description in GetControls.
    local HouseLabels   = {"None","Down","Mid1","Mid2","Up"}
    local StageLabels   = {"None","Down","Up"}
    local CurtainLabels = {"None","Close","Open"}
    local MaskingLabels = {"None","Flat","Scope","Special"}
    local LensLabels    = {"None","Flat","Scope","Special"}
    local SoundLabels   = {"None","Aux1","Aux2","Dig1","Dig2","Mono","NonSync","SR","SVA"}

    for idx = 1, #Controls.Inputs do
      local a = false
      -- Input flags are offset by 3 from their InFlagNames index (per eCNA manual)
      for _, v in ipairs(InputFlags) do if (v - 3) == idx then a = true; break end end
      Controls.Inputs[idx].Value = a and 1 or 0
      -- Event Log (Inputs category): only the transition, never the value
      -- observed on the first scrape after connecting/reconnecting. For the
      -- generic In1-In16 flags (the only ones with a user-supplied name),
      -- append the eCNA-configured name in brackets, e.g. "In5 [Booth Door]".
      logChanged(inputsBaseline, idx, a, "Inputs", function(old, new)
        local label = InFlagNames[idx] or ("Input "..idx)
        local n = tonumber(label:match("^In(%d+)$"))
        if n and Controls.In_Names and Controls.In_Names[n] and Controls.In_Names[n].String ~= "" then
          label = label .. " [" .. Controls.In_Names[n].String .. "]"
        end
        return label .. " " .. (new and "active" or "inactive")
      end)
    end

    -- Sync mutually exclusive output button groups from active flags
    -- House Lights: flags 5=Down, 6=Mid1, 7=Mid2, 8=Up, none=None
    if     flagActive(8)  then setExclusiveLogged(Controls.House_Lights, "House_Lights", HouseLabels, 5)
    elseif flagActive(7)  then setExclusiveLogged(Controls.House_Lights, "House_Lights", HouseLabels, 4)
    elseif flagActive(6)  then setExclusiveLogged(Controls.House_Lights, "House_Lights", HouseLabels, 3)
    elseif flagActive(5)  then setExclusiveLogged(Controls.House_Lights, "House_Lights", HouseLabels, 2)
    else                       setExclusiveLogged(Controls.House_Lights, "House_Lights", HouseLabels, 1) end

    -- Stage Lights: flags 9=Down, 10=Up
    if     flagActive(10) then setExclusiveLogged(Controls.Stage_Lights, "Stage_Lights", StageLabels, 3)
    elseif flagActive(9)  then setExclusiveLogged(Controls.Stage_Lights, "Stage_Lights", StageLabels, 2)
    else                       setExclusiveLogged(Controls.Stage_Lights, "Stage_Lights", StageLabels, 1) end

    -- Fast-path dimmer animation trigger for House/Stage: the CAI I/O
    -- flags above are carried on /rtIoFDetail.xml, which is prioritized to
    -- stay responsive -- flags should never feel laggy, even if that
    -- means lighting is comparatively worse. House and Stage happen to be
    -- the only two
    -- zones with flag-level representation at all -- but they're also the
    -- most commonly the ONLY active zones in practice (a QDC-400 board has
    -- 4 channels, but real installs usually only populate 1-2 with actual
    -- power modules). So for those two zones specifically, we don't have
    -- to wait for the slower /rtLights.xml poll to notice a preset change
    -- and start the local ramp -- this scrape (which is already running at
    -- the fast, prioritized rate) can kick it off immediately.
    --
    -- This is DELIBERATELY decoupled from zoneCurrentPreset/animatePresetChange's
    -- authoritative bookkeeping: zoneFastPreset only ever triggers the
    -- animation early, and is never used for the offset-additive math (see
    -- animateOffsetChange) -- that stays governed exclusively by the
    -- full-fidelity rtLights.xml zsta poll, since Stage's flags can't
    -- distinguish Mid1/Mid2 from None (CAI only exposes Up/Down/None for
    -- Stage). A brief, self-correcting animation toward a possibly-wrong
    -- guess is an acceptable trade for smooth over momentarily-precise;
    -- the real rtLights.xml poll corrects it shortly after.
    if ENABLE_QDC and Controls.Zone_Preset then
      local houseState
      if     flagActive(8) then houseState = 0  -- Up
      elseif flagActive(7) then houseState = 3  -- Mid2
      elseif flagActive(6) then houseState = 2  -- Mid1
      elseif flagActive(5) then houseState = 1  -- Down
      else                       houseState = 4 end  -- None
      if zoneFastPreset[1] ~= nil and houseState ~= zoneFastPreset[1] then
        local curOffset = (Controls.Zone_Offset[1] and Controls.Zone_Offset[1].Value) or 0
        animatePresetChange(1, houseState, curOffset, true)
      end
      zoneFastPreset[1] = houseState

      if qdcZones >= 2 then
        local stageState
        if     flagActive(10) then stageState = 0  -- Up
        elseif flagActive(9)  then stageState = 1  -- Down
        else                        stageState = 4 end  -- None (CAI can't distinguish Mid1/Mid2 for Stage; corrected by the next rtLights.xml poll)
        if zoneFastPreset[2] ~= nil and stageState ~= zoneFastPreset[2] then
          local curOffset2 = (Controls.Zone_Offset[2] and Controls.Zone_Offset[2].Value) or 0
          animatePresetChange(2, stageState, curOffset2, true)
        end
        zoneFastPreset[2] = stageState
      end
    end

    -- Curtain: flags 11=Close, 12=Open
    if     flagActive(12) then setExclusiveLogged(Controls.Curtain, "Curtain", CurtainLabels, 3)
    elseif flagActive(11) then setExclusiveLogged(Controls.Curtain, "Curtain", CurtainLabels, 2)
    else                       setExclusiveLogged(Controls.Curtain, "Curtain", CurtainLabels, 1) end

    -- Masking: flags 13=Flat, 14=Scope, 15=Special
    if     flagActive(15) then setExclusiveLogged(Controls.Masking, "Masking", MaskingLabels, 4)
    elseif flagActive(14) then setExclusiveLogged(Controls.Masking, "Masking", MaskingLabels, 3)
    elseif flagActive(13) then setExclusiveLogged(Controls.Masking, "Masking", MaskingLabels, 2)
    else                       setExclusiveLogged(Controls.Masking, "Masking", MaskingLabels, 1) end

    -- Lens: flags 16=Flat, 17=Scope, 18=Special
    if     flagActive(18) then setExclusiveLogged(Controls.Lens, "Lens", LensLabels, 4)
    elseif flagActive(17) then setExclusiveLogged(Controls.Lens, "Lens", LensLabels, 3)
    elseif flagActive(16) then setExclusiveLogged(Controls.Lens, "Lens", LensLabels, 2)
    else                       setExclusiveLogged(Controls.Lens, "Lens", LensLabels, 1) end

    -- Sound: flags 20=Aux1, 21=Aux2, 22=Dig1, 23=Dig2, 24=Mono,
    --        26=NonSync, 27=SR, 28=SVA  (25=Mute handled separately)
    if     flagActive(28) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 9)
    elseif flagActive(27) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 8)
    elseif flagActive(26) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 7)
    elseif flagActive(24) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 6)
    elseif flagActive(23) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 5)
    elseif flagActive(22) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 4)
    elseif flagActive(21) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 3)
    elseif flagActive(20) then setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 2)
    else                       setExclusiveLogged(Controls.Sound, "Sound", SoundLabels, 1) end

    -- Aux Outputs 1-16: flags 29-44. Event Log label includes the
    -- eCNA-configured name in brackets when one is set, e.g. "Out 15
    -- [Booth Power]".
    for i = 1, 16 do
      local outLabel = "Out "..i
      if Controls.Out_Names and Controls.Out_Names[i] and Controls.Out_Names[i].String ~= "" then
        outLabel = outLabel .. " [" .. Controls.Out_Names[i].String .. "]"
      end
      setBoolLogged(Controls.Aux_Out[i], "Aux_Out"..i, outLabel, flagActive(28 + i))
    end

    -- Dig1/Dig2 Power+Video (flags 1-4) are primarily driven by RST (see
    -- parseStatusRecord/dpMismatch above) -- RST gets these events
    -- near-instantly via the reactive DP/DV re-poll, whereas scrape only
    -- refreshes on its own Scrape_Interval cadence. Scrape still acts as a
    -- backstop: only override the current (RST-set) value once it's
    -- disagreed for TWO CONSECUTIVE scrapes in a row -- a single differing
    -- reading is treated as a possible stale/transitional echo, not yet a
    -- correction. A fresh RST response resets the streak back to 0 (see
    -- parseStatusRecord).
    local function scrapeCorrectDP(idx, ctl, key, label)
      local newVal = flagActive(idx)
      if newVal == ctl.Boolean then
        dpMismatch[idx] = 0
      else
        dpMismatch[idx] = dpMismatch[idx] + 1
        if dpMismatch[idx] >= 2 then
          setBoolLogged(ctl, key, label, newVal)
          dpMismatch[idx] = 0
        end
      end
    end
    scrapeCorrectDP(1, Controls.Dig1_Power, "Dig1_Power", "Dig Proj1 Power")
    scrapeCorrectDP(2, Controls.Dig1_Video, "Dig1_Video", "Dig Proj1 Video")
    scrapeCorrectDP(3, Controls.Dig2_Power, "Dig2_Power", "Dig Proj2 Power")
    scrapeCorrectDP(4, Controls.Dig2_Video, "Dig2_Video", "Dig Proj2 Video")
    -- Slide (Aux) Projector: unaffected by the above -- no unsolicited
    -- RPT,EVT exists for it (confirmed against the manual's full event
    -- list), so RST offers no faster path here; scrape remains the sole,
    -- unconditional source, exactly as before.
    setBoolLogged(Controls.Aux_Projector, "Aux_Projector", "Slide Projector", flagActive(19))
    populated.scrape = true
    checkFullyPopulated()
  end

  -- ── QDC-400 Dimmer Lighting: rtLights.xml parser (v1.2) ─────────
  -- Handles both the routine poll (/rtLights.xml, no params) and the
  -- response to a queued command (/rtLights.xml?Zone=...&State=...) --
  -- both return the identical <rtlights> status document, exactly like
  -- the eCNA's own statLightCtrl.htm always routes through showXDoc().
  -- <zofs>/<zsta>/<cact> are always 16 comma-separated values regardless
  -- of how many zones/channels are actually configured; only the first
  -- qdcZones/qdcChannels entries are applied to controls.
  -- Predicts what channel `ch` should currently read, based on its zone's
  -- last known preset + offset (manual §4.3.29/§5.9 additive-override
  -- formula -- same one startChannelAnim/animatePresetChange/animateOffsetChange use). Returns
  -- nil when there isn't enough information yet to have an expectation
  -- (unassigned channel, or preset never observed).
  local function expectedChannelLevel(ch)
    local zone0 = channelZone[ch]
    if zone0 == nil or zone0 < 0 then return nil end
    local zone   = zone0 + 1
    local preset = zoneCurrentPreset[zone]
    if preset == nil then return nil end
    local offset = (Controls.Zone_Offset[zone] and Controls.Zone_Offset[zone].Value) or 0
    local t
    if preset >= 0 and preset <= 3 then
      local base = channelPresetLevel[ch] and channelPresetLevel[ch][preset]
      if not base then return nil end
      t = base + offset
    else -- None: offset is the absolute level (manual §5.9)
      t = offset
    end
    if t < 0 then t = 0 elseif t > 100 then t = 100 end
    return t
  end

  parseLights = function(data)
    local function fi(sub) return string.find(data, sub, 1, true) or 0 end
    local zs, ze = fi("<zofs>"), fi("</zofs>")
    local ss, se = fi("<zsta>"), fi("</zsta>")
    local cs, ce = fi("<cact>"), fi("</cact>")
    if zs == 0 or ze == 0 or ss == 0 or se == 0 or cs == 0 or ce == 0 then return end

    local zofs = csvSplit(string.sub(data, zs+6, ze-1))
    local zsta = csvSplit(string.sub(data, ss+6, se-1))
    local cact = csvSplit(string.sub(data, cs+6, ce-1))

    if Controls.Zone_Offset then
      for i = 1, qdcZones do
        local off = tonumber(zofs[i]) or 0
        local sta = tonumber(zsta[i])

        -- Offset masking: while a user change is pending for this zone, only
        -- accept a polled value once it matches the requested target -- a
        -- moving/settling intermediate value would otherwise make the fader
        -- visibly crawl across several refreshes. See forward-decl comment.
        if offsetPending[i] then
          if off == offsetTarget[i] then
            offsetPending[i] = false
            Controls.Zone_Offset[i].Value = off
            if Controls.Zone_Offset_Text[i] then Controls.Zone_Offset_Text[i].String = tostring(off) end
          end
          -- else: leave the UI showing the user's requested value (masked)
        else
          Controls.Zone_Offset[i].Value = off
          if Controls.Zone_Offset_Text[i] then Controls.Zone_Offset_Text[i].String = tostring(off) end
        end

        -- zsta: 0=Up 1=Down 2=Mid1 3=Mid2 4=None; anything else (e.g. before
        -- first command) leaves all 5 preset buttons unlit, matching the
        -- web page's own guard (`if(arZSta[i]<a.length)`).
        if Controls.Zone_Preset then
          local base = (i-1)*5
          if presetPending[i] then
            if sta == presetTarget[i] then
              presetPending[i] = false
              for b = 1, 5 do Controls.Zone_Preset[base+b].Boolean = (b == sta+1) end
            end
            -- else: leave the buttons showing the user's selection (masked)
          else
            for b = 1, 5 do
              Controls.Zone_Preset[base+b].Boolean = (sta ~= nil and sta >= 0 and sta <= 4 and (sta+1) == b)
            end
          end
        end

        -- Unified preset+offset change detection. Almost all
        -- real-world changes originate at the eCNA itself (a cinema server
        -- sends it a cue), not at this plugin -- we only find out via this
        -- poll. Skipped entirely while EITHER is still pending our own
        -- command (already animated optimistically at button-press/drag
        -- time -- re-triggering here would just restart that animation
        -- partway through) and on the very first observation of a zone
        -- (zoneCurrentPreset[i] still nil -- no known prior state to fade
        -- from). Combining them matters: if the eCNA changes preset AND
        -- offset together in the same update (e.g. a cue setting both at
        -- once), animating to the bare preset level first and correcting
        -- to the true combined level only once a later poll overwrote it
        -- looked like the meter animating, then popping to a different value.
        if sta ~= nil and sta >= 0 and sta <= 4 and not presetPending[i] and not offsetPending[i] then
          local prevSta = zoneCurrentPreset[i]
          local prevOff = zoneLastOffset[i]
          if prevSta ~= nil then
            if sta ~= prevSta then
              -- Preset changed (offset may have changed in the same update
              -- too) -- combine both into one target, using the PRESET's
              -- own fade time.
              animatePresetChange(i, sta, off, true, prevOff)
            elseif prevOff ~= nil and off ~= prevOff then
              -- Only the offset changed -- use the fixed offset fade time.
              animateOffsetChange(i, off, true)
            end
            -- Event Log (Dimmer Control category, v1.4): preset changes
            -- only log for zones 3+ -- zones 1-2 (House/Stage) preset
            -- selection is already covered under Outputs (House/Stage
            -- Lights). Offset changes log for EVERY zone, including 1-2 --
            -- Outputs only covers House/Stage's preset selection, never
            -- their dimmer offset, so Dimmer Control is still the only
            -- place that offset is visible for those two zones. Every real
            -- change logs, in both directions -- moving to a non-zero
            -- offset AND moving back down to 0% (an offset being cleared is
            -- just as worth knowing as one being set). The only thing still
            -- excluded is the initial baseline observation (prevOff == nil),
            -- same as everywhere else in this file.
            if statusIsOK then
              if i > 2 and sta ~= prevSta then
                logEvent("Dimmer", "Zone "..i.." preset changed to "..(ZonePresetLabels[sta+1] or tostring(sta)))
              end
              if prevOff ~= nil and off ~= prevOff then
                logEvent("Dimmer", "Zone "..i.." offset changed to "..off.."%")
              end
            end
          end
          zoneCurrentPreset[i] = sta
          zoneLastOffset[i]    = off
        end
      end
    end

    if Controls.Channel_Level then
      for j = 1, qdcChannels do
        local lvl = tonumber(cact[j]) or 0

        -- Deliberately no "2 identical polls = settled, stop simulating"
        -- check here: with multiple channels ramping at once (or even a
        -- single channel), a transient/coincidental repeated poll reading
        -- could otherwise be trusted as a not-actually-final intermediate
        -- value, snapping the meter to it and then jumping again once a
        -- later poll showed the real (different) reading. Smooth and
        -- eventually-accurate beats momentarily-accurate and jumpy. The
        -- local ramp runs to its own computed completion every time, full
        -- stop -- the only thing that still overrides it early is the
        -- no-dimmer detection just below (2 consecutive UNEXPECTED 0%
        -- polls), which is a distinct, narrower signal than "any 2
        -- identical readings".

        -- While locally animating (see startChannelAnim), trust the
        -- simulation over the poll -- the poll is slower than a real fade
        -- and would otherwise make the meter visibly lag/jump. Once the
        -- simulated ramp finishes (on its own clock, or via the settled
        -- check above), channelAnimating[j] clears and live polling
        -- resumes automatically -- that's the "verify/correct our
        -- position" behavior. If a level changes on the poll with no
        -- animation in progress at all (e.g. someone adjusted the offset
        -- directly at the physical unit), it just flows straight through
        -- here at ordinary polling cadence -- there's nothing to predict
        -- in that case, so a less-smooth appearance is expected/fine.
        if channelPendingUnmask[j] then
          -- One-extra-polling-cycle settling guard. The local ramp is done
          -- and the zone-level pending flag(s) have genuinely cleared, but
          -- this transition
          -- involved a non-zero offset at the start or the new position --
          -- real hardware can ack the protocol-level state fields slightly
          -- ahead of the physical dimmer output actually settling to the
          -- new combined level. Skip trusting THIS poll's cact once more;
          -- resume live trust starting with the poll after this one.
          channelPendingUnmask[j] = nil
          channelAnimating[j] = false  -- takes effect for the NEXT parseLights call, not this one
        elseif not channelAnimating[j] then
          -- Dimmer-presence detection: a real 0% reading is expected and
          -- fine (None preset, a preset configured to 0%, or an offset that
          -- clamps to 0) -- only an UNEXPECTED 0% (LUT says it should be
          -- non-zero) counts as evidence the channel isn't really there.
          -- Two such polls in a row => presume no dimmer/power; a single
          -- non-zero reading at any time clears that presumption immediately.
          if lvl == 0 then
            local expected = expectedChannelLevel(j)
            if expected and expected > 0 then
              channelZeroStreak[j] = (channelZeroStreak[j] or 0) + 1
              if channelZeroStreak[j] >= 2 then
                channelNoDimmer[j]  = true
                channelConfirmed[j] = false  -- revoke: we're no longer confident this channel is real
              end
            else
              channelZeroStreak[j] = 0  -- 0% was actually expected -- not a signal of absence
            end
          else
            channelZeroStreak[j] = 0
            channelNoDimmer[j]   = false
            channelConfirmed[j]  = true  -- a genuine non-zero reading is the only thing that lights the LED
          end
          if Controls.Channel_Present and Controls.Channel_Present[j] then
            Controls.Channel_Present[j].Boolean = (channelConfirmed[j] == true)
          end

          Controls.Channel_Level[j].Value = lvl
          if Controls.Channel_Level_Text[j] then Controls.Channel_Level_Text[j].String = string.format("%d%%", lvl) end
        end
      end
    end
    dbg("Lights: " .. #zofs .. " zone offsets, " .. #cact .. " channel levels")
    populated.lightPoll = true
    checkFullyPopulated()
  end

  -- ── nanoHost POS Management Data: rtmandata.xml parser ────
  -- Reference: eCNA-5 statManDataJs.js showXDoc()/arInfo -- eCNA-5/eCNA-10
  -- share the same CPU and command set, so this is treated as confirmed,
  -- not merely a hint. The real page issues
  -- rtmandata.xml?TimeStamp=<n> and the device may reply with a bare
  -- <UpToDate/> when nothing has changed since that TimeStamp -- we don't
  -- track our own TimeStamp state (always requesting fresh, unparameterized
  -- rtmandata.xml, see httpRequest above), so we should always get a full
  -- <PosData><Stat>...</Stat></PosData> body back, not an <UpToDate/> reply.
  -- If a real capture ever shows otherwise, that's the first thing to
  -- revisit here.
  --
  -- Flags (arInfo type 1): HostUp, PosEna, PosOk, InSho, Sold, Cancel.
  -- Timers (arInfo type 2, MM:SS as total seconds on the wire): RunTim,
  -- BtwTim, BSTim, ASTim, BETim, AETim. Tod is the plain time-of-day clock
  -- string, not a duration.
  --
  -- Used for both the upper Stat section below and the lower, variable-row
  -- Screen (shows schedule) section -- see extractShows() further down,
  -- which calls back into this same helper for each show's sub-fields.
  local function xmlTag(data, tag)
    local s = string.find(data, "<"..tag..">", 1, true)
    if not s then return nil end
    local e = string.find(data, "</"..tag..">", s, true)
    if not e then return nil end
    return string.sub(data, s + #tag + 2, e - 1)
  end

  -- Formats a raw seconds value (as the flags/timers appear on the wire,
  -- per the eCNA-5 reference's own `min:sec` conversion in showXDoc()) into
  -- "MM:SS" for the Text controls -- same format the real web page shows.
  local function fmtMinSec(secStr)
    local total = tonumber(secStr)
    if not total then return secStr or "" end
    local m = math.floor(total / 60)
    local s = total - (m * 60)
    return string.format("%d:%02d", m, s)
  end

  -- Sets an LED control's Boolean AND its display Color together --
  -- Green=1 (true/active), Red=0 (false/inactive). Used for every nanoHost
  -- flag except NanoHost_Cancel (see setNanoFlagRev below).
  local function setNanoFlag(ctl, active)
    if not ctl then return end
    ctl.Boolean = active
    ctl.Color = active and "green" or "red"
  end

  -- POS Cancel uses REVERSE logic: Green=0 (not cancelled),
  -- Red=1 (cancelled) -- the only one of the six flags where "flag true"
  -- means something bad rather than something good/normal.
  local function setNanoFlagRev(ctl, active)
    if not ctl then return end
    ctl.Boolean = active
    ctl.Color = active and "red" or "green"
  end

  -- Placeholder shown for the four extrapolated timer fields before the
  -- first valid poll ever lands, and whenever NanoHost_HostUp is false --
  -- any time Host Up is not true, the Time counters are not true either.
  -- Never show a numeric value (0:00, or a stale frozen
  -- number) that could be mistaken for real data in either of those states.
  -- Time of Day is intentionally NOT included here -- it's a self-generated
  -- live clock (see state-block comment), always valid regardless of
  -- nanoHost/HostUp state, so it's never blanked.
  local NANO_BLANK = "--:--"

  local function blankNanoTimers()
    if Controls.NanoHost_TimeOfShow        then Controls.NanoHost_TimeOfShow.String        = NANO_BLANK end
    if Controls.NanoHost_TimeBetweenShows  then Controls.NanoHost_TimeBetweenShows.String  = NANO_BLANK end
    if Controls.NanoHost_TimeBeforeStart   then Controls.NanoHost_TimeBeforeStart.String   = NANO_BLANK end
    if Controls.NanoHost_TimeAfterStart    then Controls.NanoHost_TimeAfterStart.String    = NANO_BLANK end
    if Controls.NanoHost_TimeBeforeEnd     then Controls.NanoHost_TimeBeforeEnd.String     = NANO_BLANK end
    if Controls.NanoHost_TimeAfterEnd      then Controls.NanoHost_TimeAfterEnd.String      = NANO_BLANK end
  end

  -- Clamps a raw seconds value into [0, NANO_TIME_MAX] -- applied both when
  -- seeding from a real poll (defensive -- the device is the authority, but
  -- there's no reason to trust an out-of-range value if one ever showed up)
  -- and every local extrapolation tick (where it matters in practice -- see
  -- NANO_TIME_MAX's comment: confirmed the up-counters can otherwise walk
  -- past the device's own observed 255:59 ceiling).
  local function clampNanoSec(v)
    if v < 0 then return 0 end
    if v > NANO_TIME_MAX then return NANO_TIME_MAX end
    return v
  end

  -- ── Show Schedule ────────────────────────────────────────────────
  -- Controls.X.Color only accepts a STRING at runtime on real Q-SYS
  -- hardware, not an RGB table -- an RGB triple crashes with "bad argument
  -- #2 to '__newindex' (string expected, got table)", including at plugin
  -- startup if blankShowSchedule() is what first hits the assignment.
  -- Every Color assignment in this file uses plain color-name strings
  -- (e.g. "green", "pink", "lime", "chocolate", "orange", "dimgray") for
  -- that reason. Active marker colors are pink/lime/chocolate/orange for
  -- FS/FE/LS/LE respectively; all four markers use a uniform "dimgray" for
  -- their inactive/off state (despite the name, "dimgray" rgb 105,105,105
  -- is darker/more muted than "darkgray" rgb 169,169,169 -- a common
  -- naming trap worth remembering when picking a muted neutral).
  local MARKER_COLOR_ACTIVE = {
    FS = "pink",
    FE = "lime",
    LS = "chocolate",
    LE = "orange",
  }
  local MARKER_COLOR_INACTIVE = {
    FS = "dimgray",
    FE = "dimgray",
    LS = "dimgray",
    LE = "dimgray",
  }
  -- Boolean=false renders as a dimmed/dark version of whatever Color is
  -- currently set -- setting the marker's OWN target hue regardless of
  -- active state, rather than always resetting to "green" first, gives
  -- each marker a dark version of its own color when off. "green" remains
  -- the ultra-safe fallback if the specific named color ever fails.
  local function setMarkerLed(ctl, active, colorKey)
    if not ctl then return end
    ctl.Boolean = active
    local palette = active and MARKER_COLOR_ACTIVE or MARKER_COLOR_INACTIVE
    local target = (colorKey and palette[colorKey]) or "green"
    local ok = pcall(function() ctl.Color = target end)
    if not ok then ctl.Color = "green" end
  end

  -- "Now Playing" highlight for the currently-airing performance
  -- (Start/End markers specifically) -- recreates the real page's
  -- cyan/yellow StartTime/RunTime cell highlighting, using a
  -- safer mechanism: a small LED next to each field that's hidden
  -- (IsInvisible=true) when not applicable, visible when it is, rather than
  -- always-visible-but-dim. Color is set to a KNOWN-SAFE baseline ("green",
  -- confirmed extensively across this project) first -- that assignment
  -- always succeeds -- then a pcall-wrapped attempt is made to upgrade to
  -- the actual requested hue (cyan/yellow). If that specific string isn't
  -- valid on real hardware, the pcall silently swallows the error and the
  -- LED just stays green instead of crashing the plugin a third time.
  local function setHighlightLed(ctl, active, preferredColor)
    if not ctl then return end
    ctl.Boolean = active
    ctl.IsInvisible = not active
    ctl.Color = "green"
    if active then
      pcall(function() ctl.Color = preferredColor end)
    end
  end

  -- Colors the StartTime/RunTime TEXT controls themselves, closer to the
  -- real page's actual cell-background highlight. Still pcall-wrapped
  -- (cheap insurance, no reason to remove it) -- the
  -- setHighlightLed() indicator LEDs above remain the mechanism this
  -- degrades to if it ever failed.
  local function tryExperimentalTextHighlight(ctl, active, preferredColor)
    if not ctl then return end
    pcall(function() ctl.Color = active and preferredColor or "black" end)
  end

  -- Extracts each performance from <Screen>...</Screen> -- confirmed
  -- structure via a real capture: each <StartTime> element carries BOTH its
  -- own direct text (the date/time string) AND child elements (RunTime/
  -- PerfNum/Sold/Cancel/Title). Returns an array in document order, which
  -- matches the 0-based row index the Stat block's FS/FE/Start/End/LS/LE
  -- markers point into.
  local function extractShows(data)
    local shows = {}
    local screenStart = string.find(data, "<Screen>", 1, true)
    local screenEnd    = string.find(data, "</Screen>", 1, true)
    if not screenStart or not screenEnd then return shows end
    local screenBody = string.sub(data, screenStart, screenEnd)

    local pos = 1
    while true do
      local s = string.find(screenBody, "<StartTime>", pos, true)
      if not s then break end
      local e = string.find(screenBody, "</StartTime>", s, true)
      if not e then break end
      local block = string.sub(screenBody, s, e)

      -- Direct text content: everything between "<StartTime>" and the
      -- first child tag, trimmed.
      local afterOpen = #"<StartTime>" + 1
      local nextTagPos = string.find(block, "<", afterOpen, true)
      local dateStr = string.sub(block, afterOpen, nextTagPos and (nextTagPos - 1) or #block)
      dateStr = dateStr:gsub("^%s+", ""):gsub("%s+$", "")

      table.insert(shows, {
        StartTime = dateStr,
        RunTime   = xmlTag(block, "RunTime"),
        PerfNum   = xmlTag(block, "PerfNum"),
        Sold      = xmlTag(block, "Sold"),
        Cancel    = xmlTag(block, "Cancel"),
        Title     = xmlTag(block, "Title"),
      })

      pos = e + 1
    end
    return shows
  end

  -- Blanks a single Show Schedule row -- used both for rows beyond the
  -- actual show count for the day, and (via blankShowSchedule) for the
  -- whole section whenever HostUp is false.
  -- Every control belonging to a Show Schedule row, so a whole
  -- row (including its RowNum control) can be shown/hidden
  -- together -- cleaner than leaving unused LEDs/boxes visible
  -- for rows with no scheduled performance. NanoHost_Show_Start/End are
  -- deliberately NOT in this list -- their IsInvisible is governed
  -- separately by setHighlightLed() ("is this the currently-airing
  -- performance"), a different, more granular concept than "does this row
  -- have a scheduled performance at all" -- including them here would
  -- unconditionally force them visible whenever the row has data, wiping
  -- out the "only the now-playing row's highlight shows" behavior.
  local ROW_CONTROL_NAMES = {
    "NanoHost_Show_RowNum", "NanoHost_Show_FS", "NanoHost_Show_FE", "NanoHost_Show_LS", "NanoHost_Show_LE",
    "NanoHost_Show_StartTime", "NanoHost_Show_RunTime",
    "NanoHost_Show_PerfNum", "NanoHost_Show_Sold", "NanoHost_Show_Cancel", "NanoHost_Show_Title",
  }
  local function setRowVisible(i, visible)
    for _, name in ipairs(ROW_CONTROL_NAMES) do
      if Controls[name] and Controls[name][i] then
        Controls[name][i].IsInvisible = not visible
      end
    end
  end

  local function blankShowRow(i)
    if Controls.NanoHost_Show_StartTime and Controls.NanoHost_Show_StartTime[i] then Controls.NanoHost_Show_StartTime[i].String = "" end
    if Controls.NanoHost_Show_RunTime   and Controls.NanoHost_Show_RunTime[i]   then Controls.NanoHost_Show_RunTime[i].String   = "" end
    if Controls.NanoHost_Show_PerfNum   and Controls.NanoHost_Show_PerfNum[i]   then Controls.NanoHost_Show_PerfNum[i].String   = "" end
    if Controls.NanoHost_Show_Title     and Controls.NanoHost_Show_Title[i]     then Controls.NanoHost_Show_Title[i].String     = "" end
    if Controls.NanoHost_Show_Sold      and Controls.NanoHost_Show_Sold[i]      then setNanoFlag(Controls.NanoHost_Show_Sold[i], false) end
    if Controls.NanoHost_Show_Cancel    and Controls.NanoHost_Show_Cancel[i]    then setNanoFlagRev(Controls.NanoHost_Show_Cancel[i], false) end
    if Controls.NanoHost_Show_FS    and Controls.NanoHost_Show_FS[i]    then setMarkerLed(Controls.NanoHost_Show_FS[i],    false, "FS") end
    if Controls.NanoHost_Show_FE    and Controls.NanoHost_Show_FE[i]    then setMarkerLed(Controls.NanoHost_Show_FE[i],    false, "FE") end
    if Controls.NanoHost_Show_LS    and Controls.NanoHost_Show_LS[i]    then setMarkerLed(Controls.NanoHost_Show_LS[i],    false, "LS") end
    if Controls.NanoHost_Show_LE    and Controls.NanoHost_Show_LE[i]    then setMarkerLed(Controls.NanoHost_Show_LE[i],    false, "LE") end
    if Controls.NanoHost_Show_Start and Controls.NanoHost_Show_Start[i] then setHighlightLed(Controls.NanoHost_Show_Start[i], false, "cyan") end
    if Controls.NanoHost_Show_End   and Controls.NanoHost_Show_End[i]   then setHighlightLed(Controls.NanoHost_Show_End[i],   false, "yellow") end
    if Controls.NanoHost_Show_StartTime and Controls.NanoHost_Show_StartTime[i] then tryExperimentalTextHighlight(Controls.NanoHost_Show_StartTime[i], false, "cyan") end
    if Controls.NanoHost_Show_RunTime   and Controls.NanoHost_Show_RunTime[i]   then tryExperimentalTextHighlight(Controls.NanoHost_Show_RunTime[i],   false, "yellow") end
    setRowVisible(i, false)
  end

  local function blankShowSchedule()
    for i = 1, MAX_SHOWS do blankShowRow(i) end
  end

  parseNanoHost = function(data)
    -- If the device ever does reply with <UpToDate/> (see comment above),
    -- there's nothing new to parse -- the local tick extrapolation (if
    -- already valid) just keeps running from where it was rather than being
    -- reset or blanked.
    if string.find(data, "<UpToDate", 1, true) then
      dbg("NanoHost: <UpToDate/> reply, no change since last request")
      populated.nanoHost = true
      checkFullyPopulated()
      return
    end

    -- xmlTag() finds the FIRST occurrence of "<tag>" anywhere in the
    -- string it's given. <Screen> (which comes BEFORE <Stat> in the
    -- document) contains its own per-show <Sold> and <Cancel> tags inside
    -- each <StartTime> block, and those are the exact same tag names the
    -- top-level Stat flags use -- so looking these up against the full
    -- response body would silently find the FIRST show's own per-show
    -- value instead of the real top-level Stat flag. No other Stat field
    -- collides with a per-show tag name (RunTim vs RunTime, Start vs
    -- StartTime, etc. differ enough that the "<tag>" substring search
    -- doesn't cross-match) -- every Stat tag has been checked against the
    -- per-show field set (RunTime/PerfNum/Sold/Cancel/Title) to confirm
    -- this. Every top-level lookup below is scoped to the
    -- <Stat>...</Stat> substring specifically, instead of the whole
    -- document, to avoid this collision.
    local statStart = string.find(data, "<Stat>", 1, true)
    local statEnd   = string.find(data, "</Stat>", 1, true)
    local statBlock = (statStart and statEnd) and string.sub(data, statStart, statEnd) or data

    local function flag(tag) return xmlTag(statBlock, tag) == "1" end

    -- Flags always reflect ground truth at face value, regardless of
    -- HostUp -- only the TIMERS get blanked/suppressed below (flags aren't
    -- durations, so "not true" doesn't apply the same way; the HostUp LED
    -- itself is exactly what tells the operator the timers can't be
    -- trusted right now).
    -- Event Log (NanoHost category, v1.4): only these six top-level Status
    -- Flags, never the per-show Sold/Cancel entries in the Show Schedule
    -- (setNanoFlag/setNanoFlagRev are shared with those, so the logging
    -- lives here at the call sites instead of inside the shared helpers).
    if Controls.NanoHost_TicketSold then
      local v = flag("Sold")
      setNanoFlag(Controls.NanoHost_TicketSold, v)
      logChanged(nanoBaseline, "TicketSold", v, "NanoHost", function(old, new)
        return "POS Ticket Sold " .. (new and "true" or "false")
      end)
    end
    if Controls.NanoHost_InShow then
      local v = flag("InSho")
      setNanoFlag(Controls.NanoHost_InShow, v)
      logChanged(nanoBaseline, "InShow", v, "NanoHost", function(old, new)
        return "POS In Show " .. (new and "true" or "false")
      end)
    end
    if Controls.NanoHost_PosOk then
      local v = flag("PosOk")
      setNanoFlag(Controls.NanoHost_PosOk, v)
      logChanged(nanoBaseline, "PosOk", v, "NanoHost", function(old, new)
        return "POS Ok " .. (new and "true" or "false")
      end)
    end
    if Controls.NanoHost_PosEnabled then
      local v = flag("PosEna")
      setNanoFlag(Controls.NanoHost_PosEnabled, v)
      logChanged(nanoBaseline, "PosEnabled", v, "NanoHost", function(old, new)
        return "POS Enabled " .. (new and "true" or "false")
      end)
    end
    if Controls.NanoHost_HostUp then
      local v = flag("HostUp")
      setNanoFlag(Controls.NanoHost_HostUp, v)
      logChanged(nanoBaseline, "HostUp", v, "NanoHost", function(old, new)
        return "nanoHost Up " .. (new and "true" or "false")
      end)
    end
    if Controls.NanoHost_Cancel then
      local v = flag("Cancel")
      setNanoFlagRev(Controls.NanoHost_Cancel, v)
      logChanged(nanoBaseline, "Cancel", v, "NanoHost", function(old, new)
        return "POS Cancel " .. (new and "true" or "false")
      end)
    end

    nanoHostUp = flag("HostUp")

    if not nanoHostUp then
      -- Host is down: the timers aren't true. Blank them and stop trusting/
      -- extrapolating from whatever numbers this response carried, even if
      -- it did include some -- the tick timer itself also checks
      -- nanoHostUp and won't advance anything while this is false. The Show
      -- Schedule is nanoHost-sourced data too, so it gets the same
      -- treatment.
      blankNanoTimers()
      blankShowSchedule()
      dbg("NanoHost: HostUp=false, timers and show schedule blanked")
      populated.nanoHost = true
      checkFullyPopulated()
      return
    end

    -- Host is up: this is a real, trustworthy dataset -- (re)seed everything
    -- from ground truth. RunTim/BtwTim are displayed as-is (not
    -- extrapolated, see the state-block comment above); BSTim/ASTim/BETim/
    -- AETim additionally seed the raw-second counters the 1Hz tick timer
    -- extrapolates between now and the next poll. Time of Day is NOT read
    -- from this response at all -- see the self-generated clock below.
    if Controls.NanoHost_TimeOfShow then
      local v = xmlTag(statBlock, "RunTim")
      if v then Controls.NanoHost_TimeOfShow.String = fmtMinSec(v) end
    end
    if Controls.NanoHost_TimeBetweenShows then
      local v = xmlTag(statBlock, "BtwTim")
      if v then Controls.NanoHost_TimeBetweenShows.String = fmtMinSec(v) end
    end
    local bs = tonumber(xmlTag(statBlock, "BSTim"))
    if bs then
      nanoBSSec = clampNanoSec(bs)
      if Controls.NanoHost_TimeBeforeStart then Controls.NanoHost_TimeBeforeStart.String = fmtMinSec(nanoBSSec) end
    end
    local as_ = tonumber(xmlTag(statBlock, "ASTim"))
    if as_ then
      nanoASSec = clampNanoSec(as_)
      if Controls.NanoHost_TimeAfterStart then Controls.NanoHost_TimeAfterStart.String = fmtMinSec(nanoASSec) end
    end
    local be = tonumber(xmlTag(statBlock, "BETim"))
    if be then
      nanoBESec = clampNanoSec(be)
      if Controls.NanoHost_TimeBeforeEnd then Controls.NanoHost_TimeBeforeEnd.String = fmtMinSec(nanoBESec) end
    end
    local ae = tonumber(xmlTag(statBlock, "AETim"))
    if ae then
      nanoAESec = clampNanoSec(ae)
      if Controls.NanoHost_TimeAfterEnd then Controls.NanoHost_TimeAfterEnd.String = fmtMinSec(nanoAESec) end
    end

    nanoValid = true  -- only ever set true once we've actually seen a real, HostUp=true dataset

    -- ── Show Schedule ────────────────────────────────────────────────
    -- Marker indices from Stat -- 0-based row pointers (or a 255 sentinel
    -- meaning "not applicable right now"); a plain equality check against
    -- each row's 0-based index handles this
    -- correctly without any special-casing, since 255 can never match a
    -- real row index within MAX_SHOWS=10).
    local fsIdx    = tonumber(xmlTag(statBlock, "FS"))
    local feIdx    = tonumber(xmlTag(statBlock, "FE"))
    local startIdx = tonumber(xmlTag(statBlock, "Start"))
    local endIdx   = tonumber(xmlTag(statBlock, "End"))
    local lsIdx    = tonumber(xmlTag(statBlock, "LS"))
    local leIdx    = tonumber(xmlTag(statBlock, "LE"))

    local shows = extractShows(data)
    for i = 1, MAX_SHOWS do
      local show = shows[i]
      if show then
        local rowIdx0 = i - 1  -- 0-based, matching FS/FE/Start/End/LS/LE
        if Controls.NanoHost_Show_StartTime and Controls.NanoHost_Show_StartTime[i] then Controls.NanoHost_Show_StartTime[i].String = show.StartTime or "" end
        if Controls.NanoHost_Show_RunTime   and Controls.NanoHost_Show_RunTime[i]   then Controls.NanoHost_Show_RunTime[i].String   = show.RunTime or "" end
        if Controls.NanoHost_Show_PerfNum   and Controls.NanoHost_Show_PerfNum[i]   then Controls.NanoHost_Show_PerfNum[i].String   = show.PerfNum or "" end
        if Controls.NanoHost_Show_Title     and Controls.NanoHost_Show_Title[i]     then Controls.NanoHost_Show_Title[i].String     = show.Title or "" end
        if Controls.NanoHost_Show_Sold      and Controls.NanoHost_Show_Sold[i]      then setNanoFlag(Controls.NanoHost_Show_Sold[i], show.Sold == "1") end
        if Controls.NanoHost_Show_Cancel    and Controls.NanoHost_Show_Cancel[i]    then setNanoFlagRev(Controls.NanoHost_Show_Cancel[i], show.Cancel == "1") end
        if Controls.NanoHost_Show_FS    and Controls.NanoHost_Show_FS[i]    then setMarkerLed(Controls.NanoHost_Show_FS[i],    fsIdx    == rowIdx0, "FS") end
        if Controls.NanoHost_Show_FE    and Controls.NanoHost_Show_FE[i]    then setMarkerLed(Controls.NanoHost_Show_FE[i],    feIdx    == rowIdx0, "FE") end
        if Controls.NanoHost_Show_LS    and Controls.NanoHost_Show_LS[i]    then setMarkerLed(Controls.NanoHost_Show_LS[i],    lsIdx    == rowIdx0, "LS") end
        if Controls.NanoHost_Show_LE    and Controls.NanoHost_Show_LE[i]    then setMarkerLed(Controls.NanoHost_Show_LE[i],    leIdx    == rowIdx0, "LE") end
        -- "Now Playing" highlight -- guaranteed-safe indicator
        -- LED (setHighlightLed) plus an experimental attempt to also color
        -- the StartTime/RunTime text itself (tryExperimentalTextHighlight,
        -- pcall-protected -- see its comment).
        local isNowStart = (startIdx == rowIdx0)
        local isNowEnd   = (endIdx   == rowIdx0)
        if Controls.NanoHost_Show_Start then setHighlightLed(Controls.NanoHost_Show_Start[i], isNowStart, "cyan") end
        if Controls.NanoHost_Show_End   then setHighlightLed(Controls.NanoHost_Show_End[i],   isNowEnd,   "yellow") end
        if Controls.NanoHost_Show_StartTime then tryExperimentalTextHighlight(Controls.NanoHost_Show_StartTime[i], isNowStart, "cyan") end
        if Controls.NanoHost_Show_RunTime   then tryExperimentalTextHighlight(Controls.NanoHost_Show_RunTime[i],   isNowEnd,   "yellow") end
        setRowVisible(i, true)
      else
        blankShowRow(i)
      end
    end

    dbg("NanoHost: Sold=" .. tostring(flag("Sold")) .. " InSho=" .. tostring(flag("InSho"))
      .. " PosOk=" .. tostring(flag("PosOk")) .. " PosEna=" .. tostring(flag("PosEna"))
      .. " HostUp=" .. tostring(flag("HostUp")) .. " Cancel=" .. tostring(flag("Cancel"))
      .. " | Show Schedule: " .. #shows .. " performance(s)")
    populated.nanoHost = true
    checkFullyPopulated()
  end

  -- Queue a Zone preset/offset command; capped at 4 in-flight, matching the
  -- eCNA's own web page (`if(CmdBuf.length<4)`) so rapid clicking can't
  -- grow this unbounded.
  queueLightCmd = function(zone0based, state, level, fader)
    if #lightCmdQueue < 4 then
      table.insert(lightCmdQueue, {zone0based, state, level, fader})
      dbg(string.format("Queued light cmd: zone=%d state=%d level=%d fader=%d", zone0based, state, level, fader))
    end
  end

  -- Begin masking Zone_Offset/_Text updates for `zone` (1-based) until the
  -- polled offset matches `v`, or 15s elapses. The generation counter lets a
  -- second change (or a device confirmation) invalidate an older pending
  -- timeout so it doesn't wrongly clear a newer mask.
  beginOffsetPending = function(zone, v)
    offsetPending[zone] = true
    offsetTarget[zone]  = v
    offsetGen[zone] = (offsetGen[zone] or 0) + 1
    local myGen = offsetGen[zone]
    Timer.CallAfter(function()
      if offsetGen[zone] == myGen then offsetPending[zone] = false end
    end, 15)
  end

  -- Begin masking Zone_Preset updates for `zone` (1-based) until the polled
  -- zsta matches `state`, or 15s elapses. Selecting a preset also resets the
  -- zone's offset to 0 on the device (manual §5.9), so this optimistically
  -- shows/masks that too, matching what the eCNA will actually do.
  beginPresetPending = function(zone, state)
    presetPending[zone] = true
    presetTarget[zone]  = state
    presetGen[zone] = (presetGen[zone] or 0) + 1
    local myPGen = presetGen[zone]
    Timer.CallAfter(function()
      if presetGen[zone] == myPGen then presetPending[zone] = false end
    end, 15)

    beginOffsetPending(zone, 0)
    if Controls.Zone_Offset[zone] then Controls.Zone_Offset[zone].Value = 0 end
    if Controls.Zone_Offset_Text[zone] then Controls.Zone_Offset_Text[zone].String = "0" end
  end

  -- ── Local dimmer meter simulation ──────────────────────────
  -- Begin animating channel `ch` (1-based) from wherever it's currently
  -- displayed toward `target` (0-100%).
  --
  -- Fade model, corrected from field measurement: `fadeSec` is the FULL
  -- TRANSITION DURATION for going from whichever preset was active to the
  -- one being selected now, regardless of how far apart their configured
  -- levels are -- NOT a constant %/second rate as originally assumed.
  -- Measured on the real hardware: Down(0%)->Up(100%) at a 10s configured
  -- rate took ~10-11s, and separately Mid1(50%)->Up(75%) at the SAME 10s
  -- rate ALSO took ~10-11s, even though that's a much shorter distance.
  -- So the ramp's %/sec speed is `distance / fadeSec`, computed fresh for
  -- every transition -- fast for a big jump, slow for a small one, but
  -- both finishing in about the same configured duration.
  --
  -- MTICK below steps channelSimLevel[ch] toward channelSimTarget[ch] at
  -- channelSimRate[ch] %/sec until it arrives, or until parseLights sees 2
  -- consecutive identical live poll readings (device has evidently settled
  -- before our estimate finished) -- whichever comes first -- then hands
  -- back to live polling.
  local MTICK = 0.2  -- animation tick interval, seconds
  -- By the time a change is detected (via HTTP poll or, for House/Stage,
  -- the fast flag scrape) and this animation actually starts, the real
  -- dimmer has typically already been moving for 1-2 seconds -- polling
  -- has inherent lag, we don't find out instantly. Running the full
  -- configured fade time from that late start would finish correspondingly
  -- late; shortening our own animation duration by roughly that same
  -- amount gets it finishing closer to when the real transition actually
  -- completes. This does not change anything sent to the eCNA -- it only
  -- affects how fast our local prediction moves.
  local DETECTION_LAG_COMPENSATION = 2  -- seconds
  local channelSimLevel = {}  -- channelSimLevel[ch] = current simulated level (float), only meaningful while channelAnimating[ch]
  -- For a SELF-initiated change (button press, fader drag), the
  -- eCNA hasn't actually made the change yet when our local animation
  -- starts -- our own command still has to travel the shared connection,
  -- possibly behind something already in flight. If the local animation's
  -- duration is shorter than that real round trip (most likely for the
  -- ~0.5s instant/None floor, but possible for any short fade), the
  -- channel unmasks and trusts live polling again before the eCNA has
  -- actually confirmed anything -- a poll that predates our command shows
  -- the OLD value, then our real confirmation arrives and corrects it:
  -- meter pops to old, then pops back. This is NOT a risk for a
  -- poll/flag-detected change, since the confirmation IS the detection --
  -- there's nothing else to wait for in that case.
  -- channelWaitZone/channelWaitKind track, for a self-initiated animation
  -- only, which zone-level pending flag (presetPending/offsetPending) must
  -- ALSO clear before the channel is allowed to trust live polls again --
  -- the local animation reaching its target just holds there, still
  -- masked, until real confirmation (or that flag's own 15s failsafe) says so.
  local channelWaitZone = {}  -- channelWaitZone[ch] = zone number to check, or nil (poll/flag-detected changes don't set this)
  local channelWaitKind = {}  -- channelWaitKind[ch] = "preset" or "offset" -- which pending flag to check for that zone

  -- beginPresetPending ALWAYS also resets the zone's offset to 0 (manual
  -- sec 5.9), setting BOTH presetPending[zone] AND offsetPending[zone]
  -- true -- so a preset-tagged channel wait (channelWaitKind[ch] ==
  -- "preset") must check BOTH flags, not just presetPending, before
  -- unmasking. Real hardware typically acks the preset state field (zsta)
  -- almost immediately -- well before the physical dimmer finishes its
  -- multi-second fade, and often before the offset has genuinely
  -- re-settled to 0 either -- so checking only presetPending would let the
  -- channel unmask while offsetPending is still genuinely pending, and the
  -- next poll's still-transitional cact reading would pop the meter back.
  --
  -- Even once both zone-level flags genuinely clear and the local ramp is
  -- done, the very first live poll that arrives still isn't trusted --
  -- wait one more full polling cycle. This absorbs the residual gap where
  -- the protocol-level state fields confirm slightly ahead of the physical
  -- dimmer output actually settling. Applies whenever the transition
  -- involved an offset, either at the start (a non-zero offset was
  -- active/being cleared) or at the new position (the target itself has a
  -- non-zero offset component) -- not to plain preset-to-preset moves with
  -- no offset in play at all, which stay maximally responsive.
  -- (channelInvolvesOffset and
  -- channelPendingUnmask themselves are declared earlier, alongside
  -- channelAnimating -- parseLights, defined before this point in the
  -- file, needs them as upvalues; see the comment there.)

  -- Clears every queued command and every learned assumption about the
  -- connected device. Called from Controls.IP_ADDRESS.EventHandler whenever
  -- the target actually changes -- without this, a command queued while
  -- pointed at one unit (e.g. an unreachable test address) sits in
  -- lightCmdQueue/nameQueue until connectivity resumes, then gets sent with
  -- TOP priority to whatever unit that turns out to be, even if it's a
  -- completely different physical device. Likewise, zone names, channel
  -- assignments, preset level/fade tables, and dimmer-presence assumptions
  -- all persist as plain Lua state across a reconnect unless explicitly
  -- cleared here.
  resetForNewTarget = function()
    -- Queues: discard outright -- nothing in them is valid for a new target
    lightCmdQueue = {}
    nameQueue     = {}
    macroNameQueue = {}  -- any macro-name fetches still queued/undrained from the old target are stale; the Connected handler below re-queues a fresh NUM_MACROS-item batch

    -- Population tracking: none of it is valid for a new target either --
    -- Status must not read "OK" again until everything has freshly
    -- responded from whichever unit we're now connecting to. Full reset
    -- (both CAI and HTTP sides) -- unlike connect()'s own CAI-only reset,
    -- an actual target change really does invalidate
    -- previously-fetched HTTP data too (names, dimmer setup, LIN scan,
    -- scrape all belonged to the OLD unit). connect(), called right after
    -- this by every caller, only re-does the CAI half on top -- but
    -- resetting fully here too means the display is already correct even
    -- before connect() runs.
    resetPopulationTracking()

    -- HTTP connection: force a clean reconnect rather than letting a stale
    -- in-flight request resolve against the old address, or a queued
    -- request go out to the new one before we've reset everything else
    if httpConnected then httpSock:Disconnect() end
    httpConnected    = false
    httpBusy         = false
    currentReqType   = "SCRAPE"
    currentApplyFn   = nil
    routineTicks     = 0  -- fresh target restarts the LIGHTPOLL countdown from zero
    nanoTicks        = 0  -- fresh target restarts the NANOHOST countdown from zero
    macroTicks       = 0  -- fresh target restarts the macro-name-fetch countdown from zero
    consecutiveHttpFailures = 0  -- fresh target restarts the fast-fail streak from zero (v1.4.0.17)

    -- Learned dimmer configuration/state -- all specific to whichever unit
    -- we were last actually talking to
    zoneNames          = {}
    channelZone        = {}
    channelPresetLevel = {}
    channelPresetFade  = {}
    zoneCurrentPreset  = {}
    zoneFastPreset     = {}
    channelAnimating   = {}
    channelSimTarget   = {}
    channelSimRate     = {}
    channelSimLevel    = {}
    channelZeroStreak  = {}
    channelNoDimmer    = {}
    channelConfirmed   = {}
    channelInvolvesOffset = {}
    channelPendingUnmask  = {}
    qdcBoardCount      = nil
    offsetPending = {}; offsetTarget = {}; offsetGen = {}; offsetDebounceGen = {}
    presetPending = {}; presetTarget = {}; presetGen = {}

    -- Blank the visible controls too, so nothing from the previous unit
    -- lingers on screen during the reconnect window
    if Controls.Zone_Name then
      for i = 1, qdcZones do
        if Controls.Zone_Name[i] then
          Controls.Zone_Name[i].String = (i == 1 and "House") or (i == 2 and "Stage") or ("Zone "..i)
        end
      end
    end
    if Controls.Zone_Preset then
      for i = 1, #Controls.Zone_Preset do Controls.Zone_Preset[i].Boolean = false end
    end
    if Controls.Zone_Offset then
      for i = 1, qdcZones do
        Controls.Zone_Offset[i].Value = 0
        if Controls.Zone_Offset_Text[i] then Controls.Zone_Offset_Text[i].String = "0" end
      end
    end
    if Controls.Channel_Level then
      for j = 1, qdcChannels do
        Controls.Channel_Level[j].Value = 0
        if Controls.Channel_Level_Text[j] then Controls.Channel_Level_Text[j].String = "" end
        if Controls.Channel_Zone[j]  then Controls.Channel_Zone[j].String = "" end
        if Controls.Channel_Present[j] then Controls.Channel_Present[j].Boolean = false end
      end
    end
    if Controls.QDC_Board_Count then Controls.QDC_Board_Count.String = "" end

    dbg("Reset all learned state and queues for new target")
  end

  -- `waitZone`'s "is the self-initiated wait for this channel still
  -- genuinely live" question has to check BOTH presetPending and
  -- offsetPending whenever the wait is preset-tagged, because
  -- beginPresetPending always sets both (selecting a preset resets the
  -- zone's offset to 0 on the real device, manual sec 5.9) -- checking only
  -- presetPending would leave a gap where the offset side is still
  -- genuinely pending confirmation. An offset-tagged wait only ever sets
  -- offsetPending to begin with, so it alone is still the right (and
  -- only) check there.
  local function selfInitWaitLive(ch)
    local waitZone = channelWaitZone[ch]
    if not waitZone then return false end
    if channelWaitKind[ch] == "preset" then
      return presetPending[waitZone] or offsetPending[waitZone]
    elseif channelWaitKind[ch] == "offset" then
      return offsetPending[waitZone]
    end
    return false
  end

  -- Routes every place that would otherwise unmask a channel
  -- (clear channelAnimating) through here. Once the local ramp is done and
  -- the zone-level flag(s) have genuinely
  -- cleared, a channel whose transition involved a non-zero offset at
  -- either end still doesn't trust the very next live poll -- real
  -- hardware can ack the protocol-level state fields slightly ahead of the
  -- physical dimmer output actually settling. That one extra poll is
  -- skipped (channelPendingUnmask, consumed once in parseLights), then
  -- trust resumes normally. Transitions with no offset involved at all
  -- (offset was 0 before and after) unmask immediately, exactly as before.
  local function finishChannelWait(ch)
    channelWaitZone[ch] = nil
    if channelInvolvesOffset[ch] then
      channelPendingUnmask[ch] = true  -- consumed by parseLights; channelAnimating stays true for now
    else
      channelAnimating[ch] = false
    end
  end

  startChannelAnim = function(ch, target, fadeSec, applyCompensation, zone, kind, involvesOffset)
    if target < 0 then target = 0 elseif target > 100 then target = 100 end
    if channelNoDimmer[ch] and target > 0 then
      -- We've seen 2+ unexpected 0% polls for this channel while expecting
      -- non-zero -- presumed no dimmer/power. Don't optimistically animate
      -- toward a target we don't believe will actually happen; that's
      -- exactly the ramp/reset/ramp/reset cycle this feature exists to
      -- avoid. Leave the meter at 0 (what the live poll has been showing)
      -- and let the next real non-zero poll be what clears the presumption.
      channelAnimating[ch] = false
      channelWaitZone[ch] = nil
      channelPendingUnmask[ch] = nil
      if Controls.Channel_Level[ch] then Controls.Channel_Level[ch].Value = 0 end
      if Controls.Channel_Level_Text[ch] then Controls.Channel_Level_Text[ch].String = "0%" end
      return
    end
    local start = Controls.Channel_Level[ch] and Controls.Channel_Level[ch].Value or target
    local distance = math.abs(target - start)

    -- A guard against a poll/flag-detected call (applyCompensation=true)
    -- landing on top of a still-active self-initiated wait must cover the
    -- redundant fast-path call (House/Stage flags detecting the same None
    -- transition, ~2s cycle) regardless of whether it lands before or
    -- after our own floor-clamped ~0.5s ramp has already reached its
    -- target (distance == 0) or while that ramp is still mid-flight
    -- (distance ~= 0, falling through to the *general* ramp-setup path
    -- further below). Checking here, before the distance==0 branch, covers
    -- BOTH cases with one guard: a poll/flag-detected call that finds a
    -- self-initiated wait still genuinely pending (confirmed
    -- via the zone-level presetPending/offsetPending flag, not just the
    -- presence of channelWaitZone) is ignored outright -- no writes, no
    -- state changes -- regardless of whether it happened to arrive before
    -- or after our own ramp reached its target. Only real device
    -- confirmation (checked every meterTimer tick once the ramp reaches
    -- target) or that flag's own 15s failsafe may end the mask; the two
    -- calls compose, with the self-initiated one owning the mask lifecycle
    -- for its own animation's entire duration, not just its final instant.
    if applyCompensation and selfInitWaitLive(ch) then
      return -- ignored entirely -- the self-initiated ramp already in progress owns this channel
    end

    channelInvolvesOffset[ch] = involvesOffset and true or false

    if distance == 0 then
      -- Genuinely already showing the target -- either this is the
      -- self-initiated call itself (a fresh button press/drag landing
      -- exactly on the already-displayed value), or it's poll/flag-detected
      -- with no self-initiated wait in progress (the guard above already
      -- intercepted the case where one WAS still live). Still routed
      -- through finishChannelWait: if this transition involved an offset,
      -- the one-extra-poll-cycle settling guard still applies even though
      -- there's no distance to ramp -- a stale in-flight poll response
      -- could otherwise still carry a transitional reading for the offset
      -- side.
      channelSimLevel[ch]  = target
      channelSimTarget[ch] = target
      channelSimRate[ch]   = 0
      channelAnimating[ch] = true
      if Controls.Channel_Level[ch] then Controls.Channel_Level[ch].Value = target end
      if Controls.Channel_Level_Text[ch] then Controls.Channel_Level_Text[ch].String = string.format("%d%%", target) end
      finishChannelWait(ch)
      return
    end
    -- Even an "instant" target (no fade data, e.g. None, which passes
    -- fadeSec=nil) runs a brief floor-clamped animation rather than truly
    -- bypassing the system -- a true bypass (setting channelAnimating=false
    -- immediately) opens a window where an HTTP response already in
    -- flight *before* this command was sent (single connection -- only
    -- one request outstanding at a time) could arrive carrying the OLD
    -- level, get applied straight through (since nothing is masking it),
    -- and briefly show the wrong value before our own command's response
    -- corrects it moments later -- meter pops back up, then pops back
    -- down. Keeping channelAnimating=true, even for just the ~0.5s floor,
    -- closes that window the same way every other transition is already
    -- protected.
    --
    -- DETECTION_LAG_COMPENSATION only makes sense for a change we found
    -- out about *late*, via polling -- there's no lag to compensate for
    -- when the change is our own button press or fader drag; we know
    -- about it instantly. Applying the compensation unconditionally would
    -- make self-initiated offset changes (fixed 3s fade) finish roughly
    -- 2/3 early, unmasking the channel while the real device is still
    -- genuinely mid-transition -- the next live poll would then report the
    -- real, still-low level, popping the meter back down before a later
    -- poll finally shows the correct settled value.
    local effectiveFadeSec = fadeSec or 0
    if applyCompensation then
      effectiveFadeSec = effectiveFadeSec - DETECTION_LAG_COMPENSATION
    end
    if effectiveFadeSec < 0.5 then effectiveFadeSec = 0.5 end  -- floor: also covers explicit 0s and instant (nil) fades
    channelSimLevel[ch]  = start
    channelSimTarget[ch] = target
    channelSimRate[ch]   = distance / effectiveFadeSec  -- %/sec; VARIES per transition so the whole thing takes ~effectiveFadeSec seconds regardless of distance
    channelAnimating[ch] = true
    channelPendingUnmask[ch] = nil  -- a fresh animation invalidates any leftover grace state from a prior one
    -- For a self-initiated change (applyCompensation false), remember
    -- which zone-level pending flag must ALSO clear before this channel is
    -- allowed to trust live polls again -- our own local animation
    -- reaching its target doesn't mean the eCNA has actually confirmed
    -- anything yet. Poll/flag-detected changes (applyCompensation true)
    -- don't need this -- the confirmation IS the detection. Safe to clear
    -- unconditionally here: the one case that would make this unsafe -- a
    -- poll/flag-detected call landing on a still-live self-initiated wait
    -- -- is already intercepted and returned early, above, before either
    -- branch of this function body runs at all.
    if not applyCompensation and zone and kind then
      channelWaitZone[ch] = zone
      channelWaitKind[ch] = kind
    else
      channelWaitZone[ch] = nil
    end
  end

  -- None is essentially INSTANT ("as fast as the UI can update") when
  -- selected from any other preset -- the ~3s fade belongs to the Offset
  -- control, not None: moving the offset takes ~3s to reach its new level
  -- from ANY preset, including None. So preset-button transitions
  -- (Up/Down/Mid1/Mid2) use their configured Setup: QDC-400 Dimmers fade
  -- time, None-via-button is instant, and ANY offset adjustment
  -- (regardless of active preset) uses a fixed ~3s -- never the active
  -- preset's own fade time.
  local NONE_FADE_SECONDS   = nil  -- None (via preset button) has no configured fade data; startChannelAnim floors this to a brief ~0.5s animation rather than a true instant bypass, which still feels effectively immediate but closes a stale-poll race
  local OFFSET_FADE_SECONDS = 3    -- fixed duration for ANY offset change, field-measured ~3s, regardless of active preset

  -- Trigger local animation for every channel assigned to `zone` (1-based)
  -- for a PRESET BUTTON press or a poll-detected external preset change
  -- (Up/Down/Mid1/Mid2/None). `offsetVal` is the offset to combine with the
  -- new preset's level -- 0 for a fresh button press (manual §5.9: offset
  -- resets to 0 on a new preset selection), but the CURRENT offset when a
  -- poll detects the eCNA changed preset and offset together in the same
  -- update (e.g. a cinema server cue setting both at once) -- otherwise
  -- the channel would animate to the bare preset level first and only
  -- correct to the true combined level once a later poll overwrote it.
  -- `applyCompensation` should be true only for changes detected via
  -- polling or the fast flag-scrape path -- never for our own button press.
  -- `priorOffset`: whatever offset was active immediately
  -- before this transition began, if known -- used only to decide whether
  -- the one-extra-poll-cycle settling guard applies (see
  -- channelInvolvesOffset above); defaults to offsetVal itself when not
  -- given (the fast-path caller has no separate "prior" signal).
  animatePresetChange = function(zone, presetState, offsetVal, applyCompensation, priorOffset)
    offsetVal = offsetVal or 0
    if priorOffset == nil then priorOffset = offsetVal end
    local involvesOffset = (offsetVal ~= 0) or (priorOffset ~= 0)
    local zone0 = zone - 1
    for ch = 1, qdcChannels do
      if channelZone[ch] == zone0 then
        if presetState ~= nil and presetState >= 0 and presetState <= 3 then
          local base = channelPresetLevel[ch] and channelPresetLevel[ch][presetState]
          local fade = channelPresetFade[ch] and channelPresetFade[ch][presetState]
          if base then
            startChannelAnim(ch, base + offsetVal, fade, applyCompensation, zone, "preset", involvesOffset)
          end
        else -- None: instant, absolute offset value (no preset level to add to)
          startChannelAnim(ch, offsetVal, NONE_FADE_SECONDS, applyCompensation, zone, "preset", involvesOffset)
        end
      end
    end
  end

  -- Trigger local animation for every channel assigned to `zone` (1-based)
  -- for an OFFSET adjustment (fader/text box, or a poll-detected external
  -- offset-only change). Manual §4.3.29/§5.9: offset is additive on top of
  -- the active preset's configured level (Up/Down/Mid1/Mid2), or the
  -- absolute level directly when the active preset is None -- but unlike a
  -- preset button press, this ALWAYS uses OFFSET_FADE_SECONDS, never the
  -- active preset's own configured fade time. `applyCompensation` should be
  -- true only for a poll-detected change -- never for our own fader drag
  -- or text box commit.
  animateOffsetChange = function(zone, offsetVal, applyCompensation)
    local zone0  = zone - 1
    local preset = zoneCurrentPreset[zone]
    for ch = 1, qdcChannels do
      if channelZone[ch] == zone0 then
        local target
        if preset ~= nil and preset >= 0 and preset <= 3 then
          local base = channelPresetLevel[ch] and channelPresetLevel[ch][preset]
          if base then target = base + offsetVal end
        else
          target = offsetVal  -- None (or not yet known): offset is the absolute level
        end
        if target then
          -- This is by definition an offset change -- always
          -- treated as "involves offset" for the one-extra-poll-cycle
          -- settling guard, regardless of whether offsetVal itself happens
          -- to be 0 (e.g. dragging back down to 0 still means we started
          -- with a non-zero offset a moment ago).
          startChannelAnim(ch, target, OFFSET_FADE_SECONDS, applyCompensation, zone, "offset", true)
        end
      end
    end
  end

  -- Animation tick: advances every currently-animating channel toward its
  -- target by (rate * MTICK)%, clamped so it can't overshoot. Runs
  -- continuously at a fixed interval (no wall-clock dependency) whenever
  -- QDC lighting is enabled; cheap no-op when nothing is animating.
  if ENABLE_QDC then
    meterTimer = Timer.New()
    meterTimer.EventHandler = function()
      for ch = 1, qdcChannels do
        if channelAnimating[ch] then
          local cur    = channelSimLevel[ch]
          local target = channelSimTarget[ch]
          local step   = (channelSimRate[ch] or 20) * MTICK
          if cur < target then
            cur = math.min(target, cur + step)
          elseif cur > target then
            cur = math.max(target, cur - step)
          end
          channelSimLevel[ch] = cur
          if Controls.Channel_Level[ch] then Controls.Channel_Level[ch].Value = cur end
          if Controls.Channel_Level_Text[ch] then Controls.Channel_Level_Text[ch].String = string.format("%d%%", math.floor(cur + 0.5)) end
          -- Once channelPendingUnmask[ch] is set, this channel is
          -- purely waiting on parseLights to consume its one-extra-poll-
          -- cycle grace (see finishChannelWait) -- nothing left for this
          -- tick to decide (cur/target already both parked at the same
          -- value), and re-running the checks below would just clear
          -- channelAnimating on the very next tick, defeating the guard
          -- before a single live poll even has a chance to arrive.
          if cur == target and not channelPendingUnmask[ch] then
            local waitZone = channelWaitZone[ch]
            if waitZone then
              -- Self-initiated change: our local prediction has arrived at
              -- the target, but that doesn't mean the eCNA has actually
              -- confirmed it yet -- keep masking (parked at target) until
              -- the real zone-level pending flag(s) clear, which happens
              -- either on genuine confirmation or their own 15s failsafe.
              if not selfInitWaitLive(ch) then
                finishChannelWait(ch)  -- confirmed (or failsafe expired) -- may unmask now, or defer one more poll cycle if this transition involved an offset
              end
              -- else: stay masked, still parked at target, check again next tick
            else
              finishChannelWait(ch)  -- poll/flag-detected change -- ramp complete -- may unmask now, or defer one more poll cycle if this transition involved an offset
            end
          end
        end
      end
      meterTimer:Start(MTICK)
    end
    meterTimer:Start(MTICK)
  end

  -- v1.3: nanoHost timer extrapolation tick. Runs continuously at a fixed
  -- 1-second interval (no wall-clock dependency, same style as meterTimer
  -- above) whenever nanoHost is enabled. Two independent things happen here:
  -- (1) the four extrapolated counters, guarded exactly as before (no-op
  -- until valid, frozen/blanked while HostUp is false), now clamped to
  -- NANO_TIME_MAX so they can never exceed the device's own observed
  -- ceiling; (2) Time of Day, which is NOT gated by nanoValid/HostUp at all
  -- -- it's the Q-SYS Core's own clock (see state-block comment), always
  -- live regardless of nanoHost connectivity.
  --
  -- The "after" counter for a given event does not start moving until the
  -- matching "before" counter reaches 0 -- a real device never reports a
  -- nonzero "after" value while its "before" counterpart is still
  -- nonzero. Each up-counter's tick is gated on its own down-counter
  -- having already reached exactly 0.
  --
  -- Forces an early nanoHost refresh, reusing httpRequest()'s existing
  -- NANOHOST poll tier (forcing nanoTicks straight to nanoPollEveryNTicks
  -- makes a fetch immediately due on the next check) -- shared by both the
  -- Time Before Feature Start and Time Before Feature End triggers below.
  local function forceEarlyNanoHostRefresh(reason)
    Timer.CallAfter(function()
      nanoTicks = nanoPollEveryNTicks
    end, 3)
    dbg("NanoHost: " .. reason .. " -- forcing an early flag refresh in 3s")
  end

  if ENABLE_NANOHOST then
    nanoTickTimer = Timer.New()
    nanoTickTimer.EventHandler = function()
      if nanoValid and nanoHostUp then
        -- Check BEFORE decrementing -- the crossover tick (where BSTim/BETim
        -- reaches exactly 0) must show its own counter at 0:00 without
        -- ASTim/AETim already having jumped to 0:01 in that same tick; the
        -- "after" counter starts moving on the tick AFTER its "before"
        -- counterpart first reads 0, not the same one.
        local beforeStartWasZero = (nanoBSSec == 0)
        local beforeEndWasZero   = (nanoBESec == 0)
        -- 255:59 (NANO_TIME_MAX) on a "before" counter means the eCNA has
        -- no real countdown data yet -- NOT a genuine
        -- "255 minutes 59 seconds until this happens" duration. Ticking it
        -- down from there would fabricate a countdown that isn't real, so
        -- BSTim/BETim are frozen at the sentinel instead of decrementing
        -- whenever they're already sitting at it -- they'll only start
        -- counting down once an actual poll provides a real value below
        -- the sentinel. This also correctly keeps ASTim/AETim from ever
        -- starting either, since their own gating already depends on
        -- BSTim/BETim reaching exactly 0, which now can't happen from a
        -- frozen sentinel. The up-counters themselves are UNCHANGED -- they
        -- still count up and cap AT the sentinel as their normal ceiling
        -- (see clampNanoSec), never freeze.
        if nanoBSSec < NANO_TIME_MAX then
          nanoBSSec = clampNanoSec(nanoBSSec - NANO_TICK)
        end
        if beforeStartWasZero then nanoASSec = clampNanoSec(nanoASSec + NANO_TICK) end
        if nanoBESec < NANO_TIME_MAX then
          nanoBESec = clampNanoSec(nanoBESec - NANO_TICK)
        end
        if beforeEndWasZero then nanoAESec = clampNanoSec(nanoAESec + NANO_TICK) end
        if Controls.NanoHost_TimeBeforeStart then Controls.NanoHost_TimeBeforeStart.String = fmtMinSec(nanoBSSec) end
        if Controls.NanoHost_TimeAfterStart  then Controls.NanoHost_TimeAfterStart.String  = fmtMinSec(nanoASSec) end
        if Controls.NanoHost_TimeBeforeEnd   then Controls.NanoHost_TimeBeforeEnd.String   = fmtMinSec(nanoBESec) end
        if Controls.NanoHost_TimeAfterEnd    then Controls.NanoHost_TimeAfterEnd.String    = fmtMinSec(nanoAESec) end
        -- Forces an early nanoHost flag refresh around feature start/end.
        -- Trigger point is each "before" counter
        -- reaching 0:01 (one tick before its real 0:00 crossover) rather
        -- than 0:00 itself, specifically because BSTim/BETim floor at 0 and
        -- STAY there -- checking "== 0" would fire on every single tick for
        -- as long as the feature remains in progress, not just once. "== 1"
        -- only occurs on exactly one tick per countdown (a strictly
        -- decreasing count can only equal 1 once before settling at 0), so
        -- this needs no separate one-shot guard/flag.
        if nanoBSSec == 1 then
          forceEarlyNanoHostRefresh("Time Before Feature Start reached 0:01")
        end
        if nanoBESec == 1 then
          forceEarlyNanoHostRefresh("Time Before Feature End reached 0:01")
        end
      end
      -- else: leave whatever parseNanoHost last displayed (blanked, if
      -- invalid/HostUp-false) exactly as it is -- nothing to extrapolate.
      if Controls.NanoHost_TimeOfDay then
        Controls.NanoHost_TimeOfDay.String = os.date("%m/%d/%Y %H:%M:%S")
      end
      evaluateDayStart()       -- Day Start re-evaluated every second (offset-threshold crossing is time-of-day based)
      evaluateDayEnd()         -- Day End likewise re-evaluated every second
      evaluateFirstShowEnd()   -- First Show End likewise re-evaluated every second
      evaluateLastShowStart()  -- Last Show Start likewise re-evaluated every second
      nanoTickTimer:Start(NANO_TICK)
    end
    nanoTickTimer:Start(NANO_TICK)
  end

  -- HTTP socket handler: accumulates response, parses on close
  httpSock.EventHandler = function(sock, evt, err)
    if evt == TcpSocket.Events.Connected then
      httpConnected = true
      httpBuf = ""
      httpRequest()  -- send immediately on connect
    elseif evt == TcpSocket.Events.Data then
      httpBuf = httpBuf .. sock:Read(sock.BufferLength)
    elseif evt == TcpSocket.Events.Closed
        or evt == TcpSocket.Events.Reconnect
        or evt == TcpSocket.Events.Error then
      httpConnected = false
      httpBusy      = false
      dbg("HTTP Closed: buf=" .. #httpBuf .. " bytes, currentReqType=" .. currentReqType)
      -- Fast-fail counter (v1.4.0.17): any real bytes back proves the HTTP
      -- interface answered, regardless of request type -- reset the streak.
      -- Zero bytes is a genuine miss; count it, and escalate at threshold.
      -- See consecutiveHttpFailures'/declareHttpDrivenDisconnect's own
      -- comments above for the full reasoning.
      if #httpBuf > 0 then
        consecutiveHttpFailures = 0
      else
        consecutiveHttpFailures = consecutiveHttpFailures + 1
        if consecutiveHttpFailures >= HTTP_FAIL_THRESHOLD then
          declareHttpDrivenDisconnect()
        end
      end
      if #httpBuf > 0 then
        local bodyStart = httpBuf:find("\r\n\r\n")
        if not bodyStart then bodyStart = httpBuf:find("\n\n") end
        if bodyStart then
          local body = httpBuf:sub(bodyStart + 4)
          if currentReqType == "NAME" then
            local ok, serr = pcall(function() currentApplyFn(body) end)
            if not ok then
              dbg("Name parse error: " .. (serr or "unknown"))
            end
            currentApplyFn = nil
          elseif currentReqType == "LIGHTCMD" then
            local ok, serr = pcall(parseLights, body)
            if not ok then dbg("Light cmd parse error: "..(serr or "")) end
          elseif currentReqType == "LIGHTPOLL" then
            local ok, serr = pcall(parseLights, body)
            if not ok then dbg("Light poll parse error: "..(serr or "")) end
          elseif currentReqType == "NANOHOST" then
            local ok, serr = pcall(parseNanoHost, body)
            if not ok then dbg("NanoHost parse error: "..(serr or "")) end
          else -- "SCRAPE"
            local ok, serr = pcall(scrape, body)
            if not ok then dbg("Scrape parse error: "..(serr or "")) end
          end
        else
          dbg("HTTP: body separator not found in " .. #httpBuf .. " bytes")
        end
        httpBuf = ""
      end
      -- Restart scrapeTimer from NOW so interval is measured from end of response.
      -- Ping gate (v1.4.0.20): skip the restart if a gate just went active
      -- (declareHttpDrivenDisconnect() above may have triggered one) --
      -- PingGate's own stable-window resolution restarts it once it's safe.
      if not PingGate.active then
        scrapeTimer:Start(SCRAPE_RATE)
      end
    end
  end

  -- Scrape timer: triggers HTTP request at SCRAPE_RATE interval
  scrapeTimer.EventHandler = function()
    local ok, err = pcall(httpRequest)
    if not ok then dbg("Scrape error: "..(err or "")) end
  end

  -- ── Startup ─────────────────────────────────────────────────
  -- Initialise legends, set defaults, start timers, connect
  Controls.Set_Program.Choices = {'1','2','3','4','5','6','7','8','9'}
  if Controls.TCP_PORT.String == "" then
    Controls.TCP_PORT.String = tostring(TCP_PORT)
  end
  for idx, name in ipairs(InFlagNames) do
    if Controls.Inputs[idx] then Controls.Inputs[idx].Legend = name end
  end
  if Controls.Macros then
    -- Macro button legends intentionally not set (text labels above buttons used instead)
  end
  -- Aux_Out button legends intentionally not set (text labels above buttons used instead)
  if Controls.Zone_Name then
    -- House/Stage are fixed (zones 1-2); Zone 3+ default until fetched from Setup.xml PgIdx=13
    if Controls.Zone_Name[1] then Controls.Zone_Name[1].String = "House" end
    if Controls.Zone_Name[2] then Controls.Zone_Name[2].String = "Stage" end
    for i = 3, qdcZones do
      if Controls.Zone_Name[i] then Controls.Zone_Name[i].String = "Zone "..i end
    end
  end
  -- v1.3: nanoHost LEDs start Red (unknown/not-yet-polled reads as inactive)
  -- except Cancel, whose reverse logic makes "unknown" correctly show Green
  -- (not cancelled) rather than a false Red "cancelled" alarm before the
  -- first real poll ever lands. The four extrapolated timers start blanked
  -- -- see blankNanoTimers' comment -- nanoValid is still false at this
  -- point, so nothing ticks yet. Time of Day is NOT blanked -- it's the
  -- Core's own clock, so it's correct from the very first tick regardless
  -- of nanoHost/connection state; nanoTickTimer below refreshes it every
  -- second from here on.
  if ENABLE_NANOHOST then
    setNanoFlag(Controls.NanoHost_TicketSold, false)
    setNanoFlag(Controls.NanoHost_InShow,     false)
    setNanoFlag(Controls.NanoHost_PosOk,      false)
    setNanoFlag(Controls.NanoHost_PosEnabled, false)
    setNanoFlag(Controls.NanoHost_HostUp,     false)
    setNanoFlagRev(Controls.NanoHost_Cancel,  false)
    blankNanoTimers()
    -- Row numbers never change (row 3 is always "3") -- set once
    -- here, before blankShowSchedule() hides every row until real data
    -- arrives.
    if Controls.NanoHost_Show_RowNum then
      for i = 1, MAX_SHOWS do
        if Controls.NanoHost_Show_RowNum[i] then Controls.NanoHost_Show_RowNum[i].String = tostring(i) end
      end
    end
    blankShowSchedule()
    if Controls.NanoHost_TimeOfDay then
      Controls.NanoHost_TimeOfDay.String = os.date("%m/%d/%Y %H:%M:%S")
    end
    -- Day Start starts blanked/false until evaluateDayStart() has real data
    if Controls.NanoHost_DayStart then
      Controls.NanoHost_DayStart.Boolean = false
      Controls.NanoHost_DayStart.Color = "dimgray"
    end
    if Controls.NanoHost_DayStart_Trigger then Controls.NanoHost_DayStart_Trigger.Boolean = false end
    if Controls.NanoHost_DayStartOffset and Controls.NanoHost_DayStartOffset_Text then
      Controls.NanoHost_DayStartOffset_Text.String = tostring(math.floor((Controls.NanoHost_DayStartOffset.Value or 0) + 0.5))
    end
    -- Day End starts blanked/false until evaluateDayEnd() has real data
    if Controls.NanoHost_DayEnd then
      Controls.NanoHost_DayEnd.Boolean = false
      Controls.NanoHost_DayEnd.Color = "dimgray"
    end
    if Controls.NanoHost_DayEnd_Trigger then Controls.NanoHost_DayEnd_Trigger.Boolean = false end
    if Controls.NanoHost_DayEndOffset and Controls.NanoHost_DayEndOffset_Text then
      Controls.NanoHost_DayEndOffset_Text.String = tostring(math.floor((Controls.NanoHost_DayEndOffset.Value or 0) + 0.5))
    end
    -- First Show End starts blanked/false until evaluateFirstShowEnd() has real data
    if Controls.NanoHost_FirstShowEnd then
      Controls.NanoHost_FirstShowEnd.Boolean = false
      Controls.NanoHost_FirstShowEnd.Color = "dimgray"
    end
    if Controls.NanoHost_FirstShowEnd_Trigger then Controls.NanoHost_FirstShowEnd_Trigger.Boolean = false end
    if Controls.NanoHost_FirstShowEndOffset and Controls.NanoHost_FirstShowEndOffset_Text then
      Controls.NanoHost_FirstShowEndOffset_Text.String = tostring(math.floor((Controls.NanoHost_FirstShowEndOffset.Value or 0) + 0.5))
    end
    -- Last Show Start starts blanked/false until evaluateLastShowStart() has real data
    if Controls.NanoHost_LastShowStart then
      Controls.NanoHost_LastShowStart.Boolean = false
      Controls.NanoHost_LastShowStart.Color = "dimgray"
    end
    if Controls.NanoHost_LastShowStart_Trigger then Controls.NanoHost_LastShowStart_Trigger.Boolean = false end
    if Controls.NanoHost_LastShowStartOffset and Controls.NanoHost_LastShowStartOffset_Text then
      Controls.NanoHost_LastShowStartOffset_Text.String = tostring(math.floor((Controls.NanoHost_LastShowStartOffset.Value or 0) + 0.5))
    end
  end
  -- Boot-time ping gate (v1.4.0.20): this used to just call connect() and
  -- httpSock:Connect() directly at script start, same as it does for the
  -- fast path below. Per Steve's bench research (traced back to the
  -- ORIGINAL vendor "WEB" script -- this predates any of our plugin
  -- versions), talking to the eCNA within roughly 10s of its first ICMP
  -- response during its own boot sequence can wedge its web UI; waiting
  -- Ping_Stable_Window seconds after that first response measurably
  -- reduces both how often that happens and how long it lasts when it
  -- still does. Special-cased so a unit that's ALREADY up when the plugin
  -- starts -- the common case, eCNA was never power-cycled -- pays no
  -- delay at all: a single-shot ping checks this once; if it succeeds
  -- immediately, boot proceeds exactly as before (fires PingGate.bootTimer
  -- right away). Only if that first check fails (eCNA not yet responding
  -- -- we're genuinely watching it come up) does PingGate.start(true)
  -- engage its normal repeating-ping + grace-period flow, whose resolution
  -- fires bootTimer instead of the reconnect path (see
  -- PingGate.timer.EventHandler's isBootWait branch).
  PingGate.bootTimer.EventHandler = function()
    -- Q-SYS Timer:Start(seconds) repeats automatically, same as
    -- reconnectTmr/scrapeTimer elsewhere in this file -- without this
    -- explicit Stop() (the same pattern reconnectTmr.EventHandler already
    -- uses), this handler would refire every 0.1s forever.
    PingGate.bootTimer:Stop()
    pollTimer:Start(POLL_RATE)
    connect()
    scrapeTimer:Start(SCRAPE_RATE)
    local ip = Controls.IP_ADDRESS.String
    if httpSock and isValidIP(ip) then httpSock:Connect(ip, 80) end
    dbg("Plugin started. port=" .. TCP_PORT)
  end
  -- Safety net for the boot-time single-shot ping pre-check below.
  -- PingGate.bootTimer (the ONLY thing that starts pollTimer/connect()/
  -- HTTP) is only ever fired from inside PingGate.obj's EventHandler or
  -- ErrorHandler below; if the Q-SYS Ping component's single-shot
  -- start(true) fails to invoke either callback, the plugin would
  -- otherwise hang forever with no traffic at all. This timer is started
  -- right alongside the pre-check ping and stopped by whichever of
  -- EventHandler/ErrorHandler actually fires first; if 5s passes with
  -- neither having fired, this steps in so a flaky single-shot ping can't
  -- brick startup indefinitely. Fails CAUTIOUS, not fast: "neither
  -- callback fired within 5s" does NOT mean the eCNA is safely up -- it
  -- could just as easily mean the eCNA is powering on RIGHT NOW, racing
  -- this watchdog -- so this falls through to the same PingGate.start(true)
  -- path as a real failed pre-check (wait for a real ping, then the full
  -- grace period) rather than skipping straight to bootTimer.
  PingGate.preCheckWatchdog.EventHandler = function()
    PingGate.preCheckWatchdog:Stop()
    dbg("Ping gate: boot ping pre-check produced neither a response nor a timeout within 5s -- treating as not-yet-up (fail cautious) so we don't risk skipping the grace period on a device that's mid-boot right now")
    if PingGate.obj then PingGate.obj:stop() end
    PingGate.start(true)
  end
  do
    local ip = Controls.IP_ADDRESS.String
    if PingGate.enabled and isValidIP(ip) then
      PingGate.obj = Ping.New(ip)
      PingGate.obj:setPingInterval(2)
      PingGate.obj.EventHandler = function()
        PingGate.preCheckWatchdog:Stop()
        dbg("Ping gate: eCNA already responding to ICMP at startup -- no boot delay needed")
        PingGate.bootTimer:Start(0.1)
      end
      PingGate.obj.ErrorHandler = function()
        PingGate.preCheckWatchdog:Stop()  -- pre-check worked (told us "not up yet"), so this isn't a hang; PingGate.start(true) now owns its own longer-running watch
        dbg("Ping gate: eCNA not yet responding to ICMP -- waiting for it to come up before any contact")
        PingGate.start(true)  -- boot mode: waits for the first successful ping, then the full grace period, before bootTimer fires
      end
      PingGate.preCheckWatchdog:Start(5)
      PingGate.obj:start(true)  -- single-shot pre-check, not the repeating watch PingGate.start() uses
    else
      -- Feature off, or no valid IP yet at script start (common -- IP is
      -- often entered after the component is placed; IP_ADDRESS.EventHandler
      -- drives the first real connect once one is entered, unaffected by
      -- this boot gate by design -- see its own comment).
      PingGate.bootTimer:Start(0.1)
    end
  end

end  -- if Controls